---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NightSky from '../components/NightSky.astro';
import SearchModal from '../components/SearchModal.astro';
import { locale as siteLocale } from '../config';

type SchemaObject = Record<string, unknown>;

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	noindex?: boolean;
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	section?: string;
	tags?: string[];
	schema?: SchemaObject | SchemaObject[];
	canonical?: string | URL;
	transparentHeader?: boolean;
	lang?: string;
	prevURL?: string;
	nextURL?: string;
	useMainWrapper?: boolean;
	pageId?: 'home' | 'about' | 'blog-list' | 'tags-index' | 'tag-detail' | 'post' | 'experience';
}

const {
	title,
	description,
	image,
	type,
	noindex,
	publishedTime,
	modifiedTime,
	section,
	tags,
	schema,
	canonical,
	transparentHeader = true,
	lang = siteLocale,
	prevURL,
	nextURL,
	useMainWrapper = true,
	pageId,
} = Astro.props;
---

<!doctype html>
<html lang={lang} transition:name="root" transition:animate="none">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			noindex={noindex}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			section={section}
			tags={tags}
			schema={schema}
			canonical={canonical}
		/>
		{prevURL && <link rel="prev" href={prevURL} />}
		{nextURL && <link rel="next" href={nextURL} />}
		<slot name="head" />
	</head>
	<body data-page-id={pageId}>
		<NightSky />
		<Header transparent={transparentHeader} />
		<div id="main-content" transition:animate="none">
			{useMainWrapper ? (
				<main class="page-shell-main">
					<slot />
				</main>
			) : (
				<slot />
			)}
			<Footer />
		</div>
		<SearchModal />
		<script>
			import { runCurrentPageEnhancements } from '../scripts/pages/registry';
			import { setupMainScrollRestoration } from '../scripts/scroll-restoration';

			setupMainScrollRestoration();

			const runtimeWindow = window as Window & {
				__globalPageEnhancementsHandler?: () => void;
				__globalPageAfterSwapHandler?: () => void;
			};

			// Prepare lists before the new view paints, once per body.
			const initializedBodies = new WeakSet<HTMLElement>();
			const initializePageOnce = () => {
				if (initializedBodies.has(document.body)) return;
				initializedBodies.add(document.body);
				runCurrentPageEnhancements();
			};
			const handleAfterSwap = () => {
				document.documentElement.dataset.clientNavigated = 'true';
				initializePageOnce();
			};
			if (runtimeWindow.__globalPageEnhancementsHandler) {
				document.removeEventListener('astro:page-load', runtimeWindow.__globalPageEnhancementsHandler);
			}
			if (runtimeWindow.__globalPageAfterSwapHandler) {
				document.removeEventListener('astro:after-swap', runtimeWindow.__globalPageAfterSwapHandler);
			}
			runtimeWindow.__globalPageEnhancementsHandler = initializePageOnce;
			runtimeWindow.__globalPageAfterSwapHandler = handleAfterSwap;
			document.addEventListener('astro:after-swap', handleAfterSwap);
			document.addEventListener('astro:page-load', initializePageOnce);
			initializePageOnce();
		</script>
		<slot name="scripts" />
	</body>
</html>

<style>
	.page-shell-main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}
</style>
