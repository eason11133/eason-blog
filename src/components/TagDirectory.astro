---
import PageShell from '../layouts/PageShell.astro';
import InteriorHeading from './InteriorHeading.astro';
import { getTagStats } from '../lib/content/blog';
import { getWorkTagStats } from '../lib/content/works';
import { getTagPath } from '../lib/content/tag-path';
import { getWorkTagPath } from '../lib/content/work-tag-path';
import { siteTitle } from '../config';

interface Props { kind: 'blog' | 'works'; }
const { kind } = Astro.props;
const isWork = kind === 'works';
const label = isWork ? '作品' : '文章';
const pathForTag = isWork ? getWorkTagPath : getTagPath;
const tags = [...await (isWork ? getWorkTagStats() : getTagStats())]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hant'));
---

<PageShell title={label + '標籤 | ' + siteTitle}
  description={'瀏覽所有' + label + '標籤。'} pageId="tags-index" transparentHeader={false}>
  <div class="all-tags-page">
    <div class="all-tags-inner">
      <InteriorHeading title={label + '標籤'} description={'共 ' + tags.length + ' 個'} />
      <div class="tags-grid" aria-label={label + '標籤'}>
        {tags.map(([name, count]) => (
          <a class="tags-entry" href={pathForTag(name)} data-astro-prefetch="viewport">
            <span class="tags-label"><span class="hash">#</span> {name}</span>
            <span class="number">{count}</span>
          </a>
        ))}
      </div>
      {tags.length === 0 && <p class="empty">目前沒有{label}標籤。</p>}
    </div>
  </div>
</PageShell>

<style>
  .all-tags-page {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    padding: clamp(100px, 13vh, 145px) clamp(20px, 4vw, 48px) 48px;
  }
  .all-tags-inner { width: min(100%, 1280px); margin: 0 auto; }
  .tags-grid { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .tags-entry {
    display: inline-flex; align-items: center; gap: .35rem;
    min-width: 0; max-width: 100%; box-sizing: border-box;
    padding: .4rem .72rem; background: var(--color-tag-bg); color: var(--color-tag-text);
    border: 1px solid var(--color-border-subtle); border-radius: 9px;
    text-decoration: none; font-size: .88rem; font-weight: 400;
    transition: background .2s, color .2s, transform .2s;
  }
  .tags-entry:hover, .tags-entry:focus-visible {
    background: var(--accent); color: white; transform: translateY(-2px);
  }
  .tags-label { min-width: 0; overflow-wrap: anywhere; }
  .hash { color: #9abce6; }
  .number { color: #9dadc4; font-size: .78rem; margin-left: .15rem; white-space: nowrap; }
  .tags-entry:hover *, .tags-entry:focus-visible * { color: inherit; }
  .empty { color: var(--color-text-secondary); }
  @media (max-width: 620px) { .tags-grid { gap: .4rem; } }
  @media (prefers-reduced-motion: reduce) { .tags-entry { transition: none; } }
  :global(body[data-page-id="tags-index"] #main-content) { display: flex; flex-direction: column; }
  :global(body[data-page-id="tags-index"] #main-content > .page-shell-main) { flex: 0 0 auto; }
  :global(body[data-page-id="tags-index"] #main-content > footer) { margin-top: auto; flex-shrink: 0; }
</style>
