---
/** One background layer retained by Astro ClientRouter across page navigation. */
---

<div class="night-sky" transition:persist="night-sky" aria-hidden="true">
  <div class="night-sky__glow"></div>
  <div class="night-sky__stars"></div>
  <div class="night-sky__meteors"></div>
</div>

<style is:global>
  .night-sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #101b2b url('/background/eason-night.svg') center center / cover no-repeat;
    contain: paint;
  }
  .night-sky__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 45% 36% at 66% 34%, rgba(56, 114, 169, .10), transparent),
      radial-gradient(ellipse 38% 30% at 25% 77%, rgba(79, 131, 176, .07), transparent);
    pointer-events: none;
  }
  .night-sky__stars, .night-sky__meteors {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .night-sky__star {
    position: absolute;
    display: block;
    width: var(--star-size);
    height: var(--star-size);
    border-radius: 50%;
    background: #e4f2ff;
    opacity: var(--star-opacity);
    box-shadow: 0 0 var(--star-glow) rgba(181, 222, 255, .60);
    animation: night-star-twinkle var(--twinkle-time) ease-in-out var(--twinkle-delay) infinite alternate;
  }
  @keyframes night-star-twinkle {
    from { opacity: calc(var(--star-opacity) * .48); }
    to { opacity: var(--star-opacity); }
  }
  .night-sky__meteor {
    position: absolute;
    display: block;
    height: 2px;
    width: var(--meteor-length);
    left: var(--meteor-x);
    top: var(--meteor-y);
    opacity: 0;
    border-radius: 99px;
    background: linear-gradient(to right, #f5fcff 0%, rgba(183, 224, 255, .75) 12%, rgba(142, 204, 255, .25) 58%, transparent 100%);
    filter: drop-shadow(0 0 4px rgba(193, 226, 255, .75));
    transform-origin: left center;
    animation: night-meteor-flight var(--meteor-duration) linear forwards;
    will-change: transform, opacity;
  }
  .night-sky__meteor::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f5fbff;
    box-shadow: 0 0 10px rgba(180, 224, 255, .95);
  }
  @keyframes night-meteor-flight {
    0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(var(--meteor-angle)); }
    9% { opacity: .95; }
    75% { opacity: .85; }
    100% {
      opacity: 0;
      transform: translate3d(var(--meteor-travel-x), var(--meteor-travel-y), 0) rotate(var(--meteor-angle));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .night-sky__star { animation: none; }
    .night-sky__meteor { display: none; }
  }
</style>

<script>
  // This component is persistent: initialize once, including after navigation.
  const mountNightSky = () => {
    const layer = document.querySelector<HTMLElement>('.night-sky');
    if (!layer || layer.dataset.ready === 'true') return;
    layer.dataset.ready = 'true';
    const stars = layer.querySelector<HTMLElement>('.night-sky__stars');
    const meteors = layer.querySelector<HTMLElement>('.night-sky__meteors');
    if (!stars || !meteors) return;

    const randomBetween = (min: number, max: number) => min + Math.random() * (max - min);
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Keep points fixed across page navigation; only opacity softly changes.
    for (let i = 0; i < 75; i++) {
      const star = document.createElement('i');
      const bright = i < 22;
      star.className = 'night-sky__star';
      star.style.left = `${randomBetween(1, 99).toFixed(2)}%`;
      star.style.top = `${randomBetween(2, 98).toFixed(2)}%`;
      star.style.setProperty('--star-size', `${randomBetween(bright ? 1.7 : .7, bright ? 3 : 1.5).toFixed(2)}px`);
      star.style.setProperty('--star-opacity', randomBetween(bright ? .7 : .3, bright ? .96 : .65).toFixed(2));
      star.style.setProperty('--star-glow', `${randomBetween(bright ? 6 : 2, bright ? 11 : 5).toFixed(1)}px`);
      star.style.setProperty('--twinkle-time', `${randomBetween(3.5, 9).toFixed(1)}s`);
      star.style.setProperty('--twinkle-delay', `${randomBetween(-9, 0).toFixed(1)}s`);
      stars.appendChild(star);
    }

    let scheduled: number | undefined;
    let activeMeteor: HTMLElement | null = null;
    const schedule = () => {
      window.clearTimeout(scheduled);
      if (!layer.isConnected || motion.matches || document.hidden) return;
      // Random gap between meteors, with one visible at a time.
      scheduled = window.setTimeout(shoot, randomBetween(1000, 5000));
    };
    const shoot = () => {
      if (!layer.isConnected || motion.matches || document.hidden || activeMeteor) {
        schedule();
        return;
      }
      const meteor = document.createElement('span');
      meteor.className = 'night-sky__meteor';
      meteor.style.setProperty('--meteor-x', `${randomBetween(46, 95).toFixed(1)}%`);
      meteor.style.setProperty('--meteor-y', `${randomBetween(8, 60).toFixed(1)}%`);
      meteor.style.setProperty('--meteor-length', `${randomBetween(75, 160).toFixed(0)}px`);
      meteor.style.setProperty('--meteor-angle', `${-randomBetween(22, 38).toFixed(1)}deg`);
      meteor.style.setProperty('--meteor-travel-x', `${-randomBetween(130, 310).toFixed(0)}px`);
      meteor.style.setProperty('--meteor-travel-y', `${randomBetween(75, 170).toFixed(0)}px`);
      meteor.style.setProperty('--meteor-duration', `${randomBetween(.75, 1.35).toFixed(2)}s`);
      activeMeteor = meteor;
      meteors.appendChild(meteor);
      meteor.addEventListener('animationend', () => {
        meteor.remove();
        activeMeteor = null;
        schedule();
      }, { once: true });
    };
    const onVisibility = () => {
      if (document.hidden || motion.matches) {
        window.clearTimeout(scheduled);
        activeMeteor?.remove();
        activeMeteor = null;
      } else {
        schedule();
      }
    };
    document.addEventListener('visibilitychange', onVisibility);
    motion.addEventListener('change', onVisibility);
    schedule();
  };
  mountNightSky();
  document.addEventListener('astro:page-load', mountNightSky);
</script>
