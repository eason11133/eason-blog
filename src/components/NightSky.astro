---
/** One continuous, persistent night-sky background for every page and mobile menu. */
---

<div class="night-sky" transition:persist="night-sky" aria-hidden="true">
  <div class="night-sky__glow"></div>
  <div class="night-sky__aurora">
    <canvas class="night-sky__aurora-canvas" aria-hidden="true"></canvas>
    <div class="night-sky__aurora-fallback"></div>
  </div>
  <div class="night-sky__stars"></div>
  <div class="night-sky__clouds"></div>
  <div class="night-sky__meteors"></div>
  <div class="night-sky__aircraft"></div>
</div>

<style is:global>
  .night-sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #07121f url('/background/eason-night.svg') center bottom / cover no-repeat;
    contain: paint;
  }

  .night-sky__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 44% 32% at 66% 34%, rgba(56, 114, 169, .07), transparent),
      radial-gradient(ellipse 36% 29% at 25% 77%, rgba(79, 131, 176, .04), transparent);
  }

  .night-sky__stars,
  .night-sky__clouds,
  .night-sky__meteors,
  .night-sky__aircraft {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Sparse drifting night clouds. The clouds partially veil stars and aurora,
     but remain below the plane / meteor layers so aircraft are never hidden. */
  .night-sky__cloud {
    position: absolute;
    left: var(--cloud-x);
    top: var(--cloud-y);
    width: var(--cloud-width);
    height: var(--cloud-height);
    opacity: 0;
    pointer-events: none;
    /* A negative delay restores the correct in-flight position for late arrivals. */
    animation: night-cloud-drift var(--cloud-duration) linear var(--cloud-delay, 0ms) forwards;
    will-change: transform, opacity;
  }
  .night-sky__cloud svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  @keyframes night-cloud-drift {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0);
    }
    12%, 84% { opacity: var(--cloud-opacity, .38); }
    100% {
      opacity: 0;
      transform: translate3d(var(--cloud-dx), var(--cloud-dy), 0);
    }
  }

  .night-sky__star {
    position: absolute;
    display: block;
    width: var(--star-size);
    height: var(--star-size);
    border-radius: 50%;
    background: #e4f2ff;
    opacity: var(--star-opacity);
    box-shadow: 0 0 var(--star-glow) rgba(181, 222, 255, .52);
    animation: night-star-twinkle var(--twinkle-time) ease-in-out var(--twinkle-delay) infinite alternate;
  }

  @keyframes night-star-twinkle {
    from { opacity: calc(var(--star-opacity) * .48); }
    to   { opacity: var(--star-opacity); }
  }

  .night-sky__meteor {
    position: absolute;
    left: var(--meteor-x);
    top: var(--meteor-y);
    width: var(--meteor-length);
    height: var(--meteor-thickness, 2px);
    border-radius: 99px;
    opacity: 0;
    transform-origin: left center;
    background: linear-gradient(to right,
      rgba(245, 252, 255, var(--meteor-head-alpha, .95)) 0%,
      rgba(197, 233, 255, var(--meteor-mid-alpha, .75)) var(--meteor-bright-stop, 27%),
      rgba(142, 204, 255, var(--meteor-tail-alpha, .26)) var(--meteor-fade-stop, 82%),
      transparent 100%);
    box-shadow: 0 0 var(--meteor-glow, 4px) rgba(193, 226, 255, var(--meteor-glow-alpha, .48));
    animation: night-meteor-flight var(--meteor-duration) linear forwards;
    will-change: transform, opacity;
  }

  .night-sky__meteor::before {
    content: '';
    position: absolute;
    left: -1px;
    top: calc((var(--meteor-head-size, 6px) - var(--meteor-thickness, 2px)) / -2);
    width: var(--meteor-head-size, 6px);
    height: var(--meteor-head-size, 6px);
    border-radius: 50%;
    background: #f5fbff;
    box-shadow: 0 0 var(--meteor-head-glow, 9px) rgba(180, 224, 255, var(--meteor-head-alpha, .95));
  }

  @keyframes night-meteor-flight {
    0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(var(--meteor-angle)); }
    8%, 82% { opacity: var(--meteor-peak-opacity, .95); }
    100% {
      opacity: 0;
      transform: translate3d(var(--meteor-travel-x), var(--meteor-travel-y), 0) rotate(var(--meteor-angle));
    }
  }

  /* Small side-view airliner silhouette: smooth fuselage, upright tail,
     swept wing, no windows or decorative strokes. Inspired by the supplied
     visual direction, drawn as an original simplified SVG path. */
  .night-sky__plane {
    position: absolute;
    left: var(--plane-x);
    top: var(--plane-y);
    width: var(--plane-size, 32px);
    height: calc(var(--plane-size, 32px) * .36);
    opacity: 0;
    transform-origin: center;
    animation: night-plane-flight var(--plane-duration) linear var(--plane-delay, 0ms) forwards;
    will-change: transform, opacity;
    pointer-events: none;
  }

  /* Flip the icon, rather than rotating it 180 degrees: the fin stays above
     the fuselage, and the contrail always comes from the rear. */
  .night-sky__plane-art {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    transform: scaleX(var(--plane-facing, 1));
    transform-origin: center;
  }

  .night-sky__plane-shape {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 1px rgba(176, 202, 216, .34));
  }

  .night-sky__plane-silhouette {
    fill: #30414D;
    stroke: rgba(156, 186, 207, .47);
    stroke-width: 1.8;
    stroke-linejoin: round;
  }
  .night-sky__plane-light {
    animation: night-plane-blink var(--plane-blink-time) steps(1, end) infinite;
  }
  .night-sky__plane-light--red { fill: #e9979a; }
  .night-sky__plane-light--white {
    fill: #e4eff8;
    animation-delay: calc(var(--plane-blink-time) * -.5);
  }

  /* A single slim blue-gray gradient follows the tail in either direction.
     No particles: low GPU/DOM cost even when two airplanes overlap. */
  .night-sky__plane-trail {
    position: absolute;
    left: calc(-1 * var(--plane-trail-length, 50px) + 4px);
    top: 58%;
    transform: translateY(-50%);
    width: var(--plane-trail-length, 50px);
    height: var(--plane-trail-thickness, 1.5px);
    border-radius: 99px;
    background: linear-gradient(to right,
      transparent 0%,
      rgba(169, 189, 204, .12) 38%,
      rgba(192, 214, 228, var(--plane-trail-opacity, .35)) 100%);
    pointer-events: none;
  }

  @keyframes night-plane-flight {
    /* Opacity stays visible from the first edge to the opposite edge.
       The plane starts and finishes outside the clipped viewport. */
    0% { opacity: var(--plane-opacity, .42); transform: translate3d(0, 0, 0) rotate(var(--plane-tilt)); }
    100% {
      opacity: var(--plane-opacity, .42);
      transform: translate3d(var(--plane-dx), var(--plane-dy), 0) rotate(var(--plane-tilt));
    }
  }
  @keyframes night-plane-blink {
    0%, 49% { opacity: .2; }
    50%, 70% { opacity: 1; }
    71%, 100% { opacity: .27; }
  }

  /* A noise-based aurora curtain. The GPU canvas remains idle between events. */
  .night-sky__aurora {
    position: absolute;
    inset: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .night-sky__aurora-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    mix-blend-mode: screen;
  }
  .night-sky__aurora-fallback {
    position: absolute;
    inset: 0;
    opacity: 0;
    background:
      radial-gradient(ellipse 40% 19% at 39% 44%, rgba(43, 165, 140, .30), transparent 79%),
      radial-gradient(ellipse 35% 20% at 70% 41%, rgba(39, 127, 185, .22), transparent 80%);
  }
  .night-sky__aurora.use-fallback .night-sky__aurora-canvas { display: none; }
  .night-sky__aurora.use-fallback .night-sky__aurora-fallback { opacity: 1; }
  .night-sky__aurora.is-visible {
    opacity: var(--aurora-opacity, .85);
    animation: night-aurora-appear var(--aurora-duration) ease-in-out var(--aurora-delay, 0ms) both;
    will-change: opacity;
  }
  @keyframes night-aurora-appear {
    0% { opacity: 0; }
    20% { opacity: var(--aurora-opacity, .85); }
    78% { opacity: var(--aurora-opacity, .85); }
    100% { opacity: 0; }
  }

  /* The existing fixed sky becomes visible *through* the drawer, not another image. */
  @media (max-width: 900px) {
    body:has(header.mobile-menu-open) .night-sky {
      z-index: 99;
      clip-path: inset(64px 0 0 calc(100% - min(86vw, 320px)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .night-sky__star,
    .night-sky__cloud,
    .night-sky__meteor,
    .night-sky__plane,
    .night-sky__aurora { animation: none !important; }
    .night-sky__meteor,
    .night-sky__plane { display: none !important; }
    /* Honor reduced motion, but do not hide the aurora while Footer says it is active. */
    .night-sky__aurora.is-visible {
      opacity: var(--aurora-opacity, .65) !important;
      transform: none !important;
      will-change: auto;
    }
    .night-sky__aurora.is-visible .night-sky__aurora-canvas { display: none !important; }
    .night-sky__aurora.is-visible .night-sky__aurora-fallback { opacity: 1 !important; }
  }
</style>

<script>
  import { getAuroraState } from '../lib/sky/aurora-schedule';
  import { getPlaneState, type PlaneEvent } from '../lib/sky/plane-schedule';
  import { getCloudState, type CloudEvent } from '../lib/sky/cloud-schedule';
  import { createAuroraRenderer, type AuroraRenderer } from '../lib/sky/aurora-renderer';

  // This element persists across Astro navigation; start timers only once.
  const mountNightSky = () => {
    const layer = document.querySelector<HTMLElement>('.night-sky');
    if (!layer || layer.dataset.ready === 'true') return;
    const stars = layer.querySelector<HTMLElement>('.night-sky__stars');
    const meteors = layer.querySelector<HTMLElement>('.night-sky__meteors');
    const clouds = layer.querySelector<HTMLElement>('.night-sky__clouds');
    const aircraft = layer.querySelector<HTMLElement>('.night-sky__aircraft');
    const aurora = layer.querySelector<HTMLElement>('.night-sky__aurora');
    const auroraCanvas = layer.querySelector<HTMLCanvasElement>('.night-sky__aurora-canvas');
    if (!stars || !meteors || !clouds || !aircraft || !aurora || !auroraCanvas) return;
    layer.dataset.ready = 'true';

    const randomBetween = (min: number, max: number) => min + Math.random() * (max - min);
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const viewport = () => ({ width: layer.clientWidth || window.innerWidth, height: layer.clientHeight || window.innerHeight });
    const canAnimate = () => layer.isConnected && !motion.matches && !document.hidden;

    // Static positions, soft twinkle; fewer animated points on small devices.
    const starCount = motion.matches ? 0 : (window.innerWidth > 900 ? 48 : 30);
    for (let i = 0; i < starCount; i++) {
      const star = document.createElement('i');
      const bright = i < Math.ceil(starCount * .29);
      star.className = 'night-sky__star';
      star.style.left = `${randomBetween(1, 99).toFixed(2)}%`;
      star.style.top = `${randomBetween(2, 98).toFixed(2)}%`;
      star.style.setProperty('--star-size', `${randomBetween(bright ? 1.6 : .7, bright ? 2.8 : 1.4).toFixed(2)}px`);
      star.style.setProperty('--star-opacity', randomBetween(bright ? .64 : .26, bright ? .90 : .58).toFixed(2));
      star.style.setProperty('--star-glow', `${randomBetween(bright ? 5 : 1.5, bright ? 9 : 4).toFixed(1)}px`);
      star.style.setProperty('--twinkle-time', `${randomBetween(4, 10).toFixed(1)}s`);
      star.style.setProperty('--twinkle-delay', `${randomBetween(-10, 0).toFixed(1)}s`);
      stars.appendChild(star);
    }

    const activeMeteors = new Set<HTMLElement>();
    const activeClouds = new Map<number, HTMLElement>();
    const activePlanes = new Map<number, HTMLElement>();
    let cloudTimer: number | undefined;
    let meteorTimer: number | undefined;
    let meteorBurstTimer: number | undefined;
    let planeSyncTimer: number | undefined;
    let auroraSyncTimer: number | undefined;
    let auroraEventId: number | null = null;
    let auroraRenderer: AuroraRenderer | null = null;
    let auroraFrame: number | null = null;
    let auroraLastFrameTime = 0;
    let auroraStartsAt = 0;
    let auroraStrength = 0;
    let auroraSeed = 0;

    // Each visitor sees the same real-time cloud positions. Clouds already
    // in flight are restored with a negative animation delay.
    const spawnCloud = (event: CloudEvent, now: number) => {
      const { width, height } = viewport();
      const desktop = width > 900;
      const isCirrus = event.isCirrus;
      const cloudWidth = (desktop ? 240 : 155) + event.widthFactor * (desktop ? 165 : 95);
      const cloudHeight = cloudWidth * (isCirrus ? .29 : .34);
      const margin = cloudWidth + 15;
      const fromX = event.fromLeft ? -margin : width + 15;
      const toX = event.fromLeft ? width + 15 : -margin;
      const y = event.yFraction * height;
      const dy = event.dyFraction * height;

      const cloud = document.createElement('span');
      cloud.className = 'night-sky__cloud';
      const gradientId = 'sky-cloud-gradient-' + event.id;
      const shape = isCirrus
        ? `<path fill="url(#${gradientId})"
             d="M 3 80 C 32 72 49 70 76 64 C 96 55 111 48 133 50
                C 155 35 170 35 188 41 C 202 29 234 33 248 43
                C 271 41 294 48 308 56 C 332 53 358 63 376 68
                C 396 68 409 72 420 80 C 377 87 348 82 315 87
                C 273 94 230 85 189 92 C 158 89 128 94 97 87
                C 61 89 25 89 3 80 Z" />
           <path fill="#8da3b5" opacity=".14"
             d="M 50 69 C 87 66 122 52 143 56 C 175 45 192 46 219 51
                C 257 52 277 60 304 68 C 277 69 262 65 238 67
                C 189 64 151 73 118 72 C 91 75 63 72 50 69 Z" />`
        : `<path fill="url(#${gradientId})"
             d="M 4 87 C 30 84 46 80 65 76 C 72 58 100 57 117 65
                C 123 46 151 39 173 51 C 194 33 219 34 238 48
                C 257 44 274 50 287 62 C 312 57 340 66 356 75
                C 382 73 402 81 420 85 C 396 99 371 96 340 98
                C 308 103 279 96 250 103 C 205 106 177 102 143 104
                C 99 106 57 102 4 87 Z" />
           <path fill="#8ca3b4" opacity=".12"
             d="M 91 72 Q 112 66 124 73 Q 152 53 184 65
                Q 223 52 245 65 Q 273 65 293 77
                Q 250 83 219 79 Q 176 86 148 80 Q 116 84 91 72 Z" />`;
      cloud.innerHTML = `<svg viewBox="0 0 424 120" aria-hidden="true">
        <defs>
          <linearGradient id="${gradientId}" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#8297a9" stop-opacity=".34" />
            <stop offset="36%" stop-color="#657d90" stop-opacity=".70" />
            <stop offset="100%" stop-color="#26374b" stop-opacity=".64" />
          </linearGradient>
        </defs>
        ${shape}
      </svg>`;
      const props: Record<string, string> = {
        '--cloud-x': `${fromX.toFixed(0)}px`,
        '--cloud-y': `${y.toFixed(0)}px`,
        '--cloud-width': `${cloudWidth.toFixed(0)}px`,
        '--cloud-height': `${cloudHeight.toFixed(0)}px`,
        '--cloud-dx': `${(toX - fromX).toFixed(0)}px`,
        '--cloud-dy': `${dy.toFixed(0)}px`,
        '--cloud-duration': `${event.durationMs}ms`,
        '--cloud-delay': `${event.startsAt - now}ms`,
        '--cloud-opacity': event.opacity.toFixed(2),
      };
      for (const [key, value] of Object.entries(props)) cloud.style.setProperty(key, value);
      activeClouds.set(event.id, cloud);
      clouds.appendChild(cloud);
      cloud.addEventListener('animationend', (animationEvent) => {
        if (animationEvent.animationName !== 'night-cloud-drift') return;
        cloud.remove();
        activeClouds.delete(event.id);
      });
    };

    const synchronizeClouds = () => {
      window.clearTimeout(cloudTimer);
      if (!canAnimate()) return;

      const now = Date.now();
      const { active, next } = getCloudState(now);
      const activeIds = new Set(active.map((event) => event.id));

      for (const [id, cloud] of activeClouds) {
        if (!activeIds.has(id)) {
          cloud.remove();
          activeClouds.delete(id);
        }
      }
      for (const event of active) {
        if (!activeClouds.has(event.id)) spawnCloud(event, now);
      }

      const earliestEnd = active.length > 0
        ? Math.min(...active.map((event) => event.endsAt))
        : next.startsAt;
      const boundary = Math.min(earliestEnd, next.startsAt);
      // Periodically resync against actual time, including clock changes.
      cloudTimer = window.setTimeout(
        synchronizeClouds,
        Math.min(20_000, Math.max(100, boundary - Date.now() + 40)),
      );
    };

    const shootMeteor = (allowBurst = true) => {
      if (!canAnimate()) return;
      const { width, height } = viewport();
      const desktop = width > 900;
      if (activeMeteors.size >= (desktop ? 2 : 1)) return;

      const angle = randomBetween(9, 78);
      const rad = angle * Math.PI / 180;
      const goesLeft = Math.random() < .77;
      const roll = Math.random();
      const sizeScale = Math.min(Math.max(Math.sqrt(width / 1440), .8), 1.25);
      const requestedLength = desktop
        ? (roll < .18 ? randomBetween(180, 300)
          : roll < .88 ? randomBetween(340, 610) : randomBetween(660, 890)) * sizeScale
        : (roll < .24 ? randomBetween(72, 115)
          : roll < .91 ? randomBetween(115, 190) : randomBetween(195, 255));
      // Keep the entire trail and starting point inside the same viewport.
      const maxTailLength = Math.min(width * .60 / Math.max(.14, Math.cos(rad)), height * .57 / Math.max(.14, Math.sin(rad)));
      const length = Math.max(45, Math.min(requestedLength, maxTailLength));
      const tailX = length * Math.cos(rad);
      const tailY = length * Math.sin(rad);
      const minX = goesLeft ? Math.min(width * .51, width - tailX - 14) : tailX + 14;
      const maxX = goesLeft ? width - tailX - 14 : Math.max(minX, width * .53);
      const x = randomBetween(Math.max(14, minX), Math.max(Math.max(14, minX), Math.min(width - 12, maxX)));
      const y = randomBetween(tailY + 15, Math.max(tailY + 15, height * .76));

      const availableX = goesLeft ? x - 14 : width - x - 14;
      const availableY = height - y - 20;
      const maxTravel = Math.max(0, Math.min(availableX / Math.max(.14, Math.cos(rad)), availableY / Math.max(.14, Math.sin(rad))));
      const travel = Math.min(randomBetween(width * .26, width * .65), maxTravel);
      const brightnessRoll = Math.random();
      const brightness = brightnessRoll < .45 ? randomBetween(.18, .42)
        : brightnessRoll < .85 ? randomBetween(.43, .72) : randomBetween(.73, .98);
      const duration = randomBetween(2, 6);
      const meteor = document.createElement('span');
      meteor.className = 'night-sky__meteor';
      const props: Record<string, string> = {
        '--meteor-x': `${x.toFixed(0)}px`,
        '--meteor-y': `${y.toFixed(0)}px`,
        '--meteor-length': `${length.toFixed(0)}px`,
        '--meteor-angle': `${(goesLeft ? -angle : 180 + angle).toFixed(1)}deg`,
        '--meteor-travel-x': `${((goesLeft ? -1 : 1) * travel * Math.cos(rad)).toFixed(0)}px`,
        '--meteor-travel-y': `${(travel * Math.sin(rad)).toFixed(0)}px`,
        '--meteor-duration': `${duration.toFixed(2)}s`,
        '--meteor-thickness': `${randomBetween(1.2, 2.7).toFixed(1)}px`,
        '--meteor-head-size': `${randomBetween(3.5, 7.2).toFixed(1)}px`,
        '--meteor-glow': `${randomBetween(2, 5).toFixed(1)}px`,
        '--meteor-head-glow': `${randomBetween(4, 10).toFixed(1)}px`,
        '--meteor-peak-opacity': brightness.toFixed(2),
        '--meteor-head-alpha': brightness.toFixed(2),
        '--meteor-mid-alpha': (brightness * randomBetween(.66, .90)).toFixed(2),
        '--meteor-tail-alpha': (brightness * randomBetween(.29, .49)).toFixed(2),
        '--meteor-glow-alpha': (brightness * randomBetween(.25, .55)).toFixed(2),
        '--meteor-bright-stop': `${randomBetween(18, 37).toFixed(0)}%`,
        '--meteor-fade-stop': `${randomBetween(77, 93).toFixed(0)}%`,
      };
      for (const [name, value] of Object.entries(props)) meteor.style.setProperty(name, value);
      activeMeteors.add(meteor);
      meteors.appendChild(meteor);
      meteor.addEventListener('animationend', () => {
        meteor.remove();
        activeMeteors.delete(meteor);
      }, { once: true });

      // Occasional pair, never more than two simultaneous meteors on desktop.
      if (desktop && allowBurst && activeMeteors.size === 1 && meteorBurstTimer === undefined && Math.random() < .13) {
        meteorBurstTimer = window.setTimeout(() => {
          meteorBurstTimer = undefined;
          shootMeteor(false);
        }, randomBetween(400, 1000));
      }
    };

    const scheduleMeteor = () => {
      window.clearTimeout(meteorTimer);
      if (!canAnimate()) return;
      meteorTimer = window.setTimeout(() => {
        shootMeteor();
        scheduleMeteor();
      }, randomBetween(6000, 18000));
    };

    // Planes use the shared wall-clock schedule, so the footer countdown always
    // matches actual flights. Multiple overlapping flights are allowed.
    const spawnPlane = (event: PlaneEvent, now: number) => {
      const { width, height } = viewport();
      const desktop = width > 900;
      const size = (desktop ? 28 : 24) + event.sizeFactor * (desktop ? 9 : 7);
      const margin = size + 8;
      const fromX = event.fromLeft ? -margin : width + margin;
      const toX = event.fromLeft ? width + margin : -margin;
      const fromY = event.yFraction * height;
      const toY = Math.max(height * .08, Math.min(height * .65, fromY + event.dyFraction * height));
      const deltaX = toX - fromX;
      const deltaY = toY - fromY;
      const plane = document.createElement('span');
      plane.className = 'night-sky__plane';
      const props: Record<string, string> = {
        '--plane-x': `${fromX.toFixed(0)}px`,
        '--plane-y': `${fromY.toFixed(0)}px`,
        '--plane-dx': `${deltaX.toFixed(0)}px`,
        '--plane-dy': `${deltaY.toFixed(0)}px`,
        '--plane-size': `${size.toFixed(1)}px`,
        '--plane-opacity': Math.max(.73, event.opacity).toFixed(2),
        '--plane-facing': event.fromLeft ? '1' : '-1',
        '--plane-trail-length': `${((desktop ? 42 : 22) + event.trailFactor * (desktop ? 32 : 20)).toFixed(0)}px`,
        '--plane-trail-thickness': `${(1 + event.sizeFactor).toFixed(1)}px`,
        '--plane-trail-opacity': event.trailOpacity.toFixed(2),
        '--plane-duration': `${event.durationMs}ms`,
        '--plane-delay': `${event.startsAt - now}ms`,
        // Left-moving planes mirror the silhouette horizontally, not by a 180-degree rotation.
        '--plane-tilt': `${((event.fromLeft ? 1 : -1) * Math.atan2(deltaY, Math.abs(deltaX)) * 180 / Math.PI).toFixed(1)}deg`,
        '--plane-blink-time': `${event.blinkSeconds.toFixed(2)}s`,
      };
      for (const [name, value] of Object.entries(props)) plane.style.setProperty(name, value);
      // Original, simple side-profile jet silhouette. Fuselage points right;
      // scaleX(-1) mirrors the entire drawing for flights in the other direction.
      plane.innerHTML = `
        <span class="night-sky__plane-art">
          <span class="night-sky__plane-trail"></span>
          <svg class="night-sky__plane-shape" viewBox="22 8 148 55" aria-hidden="true">
            <path class="night-sky__plane-silhouette"
              d="M 80 31 L 69 21 L 81 21 L 102 31 Z" />
            <path class="night-sky__plane-silhouette"
              d="M 42 33 L 36 13 Q 36 11 39 11 L 47 11 L 63 33 Z" />
            <path class="night-sky__plane-silhouette"
              d="M 27 33 Q 33 30 44 30 L 119 30
                 Q 141 30 153 35 Q 163 37 164 40
                 Q 163 44 151 45 L 53 45
                 Q 34 44 28 41 Q 25 38 27 33 Z" />
            <path class="night-sky__plane-silhouette"
              d="M 111 39 L 80 57 Q 78 59 83 59 L 96 57 L 133 40 Z" />
            <path class="night-sky__plane-silhouette"
              d="M 52 40 L 40 50 L 53 49 L 66 40 Z" />
            <circle class="night-sky__plane-light night-sky__plane-light--red" cx="82" cy="58" r="2.4" />
            <circle class="night-sky__plane-light night-sky__plane-light--white" cx="79" cy="21" r="2.2" />
          </svg>
        </span>`;
      activePlanes.set(event.id, plane);
      aircraft.appendChild(plane);
      plane.addEventListener('animationend', (animationEvent) => {
        if (animationEvent.animationName !== 'night-plane-flight') return;
        plane.remove();
        activePlanes.delete(event.id);
      });
    };

    const synchronizePlanes = () => {
      window.clearTimeout(planeSyncTimer);
      if (!canAnimate()) return;
      const now = Date.now();
      const { active, next } = getPlaneState(now);
      const currentIds = new Set(active.map((event) => event.id));

      for (const [id, plane] of activePlanes) {
        if (!currentIds.has(id)) {
          plane.remove();
          activePlanes.delete(id);
        }
      }
      for (const event of active) {
        if (!activePlanes.has(event.id)) spawnPlane(event, now);
      }

      // Recheck against absolute time; a short interval may overlap an
      // already-flying airplane and create a second one.
      const delay = Math.min(60_000, Math.max(100, next.startsAt - Date.now() + 30));
      planeSyncTimer = window.setTimeout(synchronizePlanes, delay);
    };

    const stopAuroraFrames = () => {
      if (auroraFrame !== null) window.cancelAnimationFrame(auroraFrame);
      auroraFrame = null;
    };

    // Draw only while the wall-clock aurora is active and the tab is visible.
    // Time is derived from event start, so reopening the page never restarts it.
    const drawAurora = (frameTime: number) => {
      auroraFrame = null;
      if (!canAnimate() || auroraEventId === null) return;
      if (frameTime - auroraLastFrameTime >= 1000 / 24) {
        auroraLastFrameTime = frameTime;
        if (!auroraRenderer) auroraRenderer = createAuroraRenderer(auroraCanvas);
        if (!auroraRenderer) {
          aurora.classList.add('use-fallback');
          return;
        }
        const elapsed = Math.max(0, (Date.now() - auroraStartsAt) / 1000);
        // Different events use different seeds; synchronized visitors see
        // the same curtain at the same point in its motion.
        if (!auroraRenderer.draw(elapsed + 28, auroraStrength, auroraSeed)) {
          auroraRenderer = null;
          aurora.classList.add('use-fallback');
          return;
        }
      }
      auroraFrame = window.requestAnimationFrame(drawAurora);
    };

    const startAuroraFrames = () => {
      stopAuroraFrames();
      if (!canAnimate() || auroraEventId === null) return;
      auroraLastFrameTime = 0;
      auroraFrame = window.requestAnimationFrame(drawAurora);
    };

    // Aurora timing and footer countdown remain on the same absolute schedule.
    const synchronizeAurora = () => {
      window.clearTimeout(auroraSyncTimer);
      if (!layer.isConnected || document.hidden) return;
      const now = Date.now();
      const { active, next } = getAuroraState(now);

      if (!active) {
        if (auroraEventId !== null) {
          stopAuroraFrames();
          aurora.classList.remove('is-visible', 'use-fallback');
          auroraEventId = null;
        }
      } else if (active.id !== auroraEventId) {
        stopAuroraFrames();
        auroraEventId = active.id;
        auroraStartsAt = active.startsAt;
        auroraStrength = active.strength;
        auroraSeed = ((active.id * .61803398875) % 17) + 3;
        // Shader strength handles brightness. CSS only fades the whole curtain.
        aurora.style.setProperty('--aurora-opacity', '.88');
        aurora.style.setProperty('--aurora-duration', `${active.durationMs}ms`);
        aurora.style.setProperty('--aurora-delay', `${active.startsAt - now}ms`);
        aurora.classList.remove('is-visible', 'use-fallback');
        if (motion.matches) aurora.classList.add('use-fallback');
        void aurora.offsetWidth;
        aurora.classList.add('is-visible');
        startAuroraFrames();
      }

      const boundary = active ? active.endsAt : next.startsAt;
      auroraSyncTimer = window.setTimeout(
        synchronizeAurora,
        Math.min(60_000, Math.max(120, boundary - Date.now() + 40)),
      );
    };

    const onVisibility = () => {
      stopAuroraFrames();
      window.clearTimeout(meteorTimer);
      window.clearTimeout(meteorBurstTimer);
      window.clearTimeout(cloudTimer);
      window.clearTimeout(planeSyncTimer);
      window.clearTimeout(auroraSyncTimer);
      meteorBurstTimer = undefined;
      if (!canAnimate()) {
        for (const meteor of activeMeteors) meteor.remove();
        activeMeteors.clear();
        for (const cloud of activeClouds.values()) cloud.remove();
        activeClouds.clear();
        for (const plane of activePlanes.values()) plane.remove();
        activePlanes.clear();
        if (!layer.isConnected || document.hidden) {
          aurora.classList.remove('is-visible', 'use-fallback');
          auroraEventId = null;
          return;
        }
        synchronizeAurora(); // Static visible aurora if reduced motion is enabled.
        return;
      }
      scheduleMeteor();
      synchronizeClouds();
      synchronizePlanes();
      synchronizeAurora();
    };
    document.addEventListener('visibilitychange', onVisibility);
    motion.addEventListener('change', onVisibility);
    onVisibility();
  };
  mountNightSky();
  document.addEventListener('astro:page-load', mountNightSky);
</script>