---
/** One background layer retained by Astro ClientRouter across page navigation. */
---

<div class="night-sky" transition:persist="night-sky" aria-hidden="true">
  <div class="night-sky__glow"></div>
  <div class="night-sky__stars"></div>
  <div class="night-sky__meteors"></div>
</div>

<style is:global>
  .night-sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #101b2b url('/background/eason-night.svg') center center / cover no-repeat;
    contain: paint;
  }
  .night-sky__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 45% 36% at 66% 34%, rgba(56, 114, 169, .10), transparent),
      radial-gradient(ellipse 38% 30% at 25% 77%, rgba(79, 131, 176, .07), transparent);
    pointer-events: none;
  }
  .night-sky__stars, .night-sky__meteors {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .night-sky__star {
    position: absolute;
    display: block;
    width: var(--star-size);
    height: var(--star-size);
    border-radius: 50%;
    background: #e4f2ff;
    opacity: var(--star-opacity);
    box-shadow: 0 0 var(--star-glow) rgba(181, 222, 255, .60);
    animation: night-star-twinkle var(--twinkle-time) ease-in-out var(--twinkle-delay) infinite alternate;
  }
  @keyframes night-star-twinkle {
    from { opacity: calc(var(--star-opacity) * .48); }
    to { opacity: var(--star-opacity); }
  }
  .night-sky__meteor {
    position: absolute;
    display: block;
    height: var(--meteor-thickness, 2px);
    width: var(--meteor-length);
    left: var(--meteor-x);
    top: var(--meteor-y);
    opacity: 0;
    border-radius: 99px;
    /* Keep most of each random-length trail visible, rather than fading out at 58%. */
    background: linear-gradient(to right,
      rgba(245, 252, 255, var(--meteor-head-alpha, .95)) 0%,
      rgba(197, 233, 255, var(--meteor-mid-alpha, .75)) var(--meteor-bright-stop, 27%),
      rgba(142, 204, 255, var(--meteor-tail-alpha, .26)) var(--meteor-fade-stop, 82%),
      transparent 100%);
    box-shadow: 0 0 var(--meteor-glow, 4px) rgba(193, 226, 255, var(--meteor-glow-alpha, .48));
    transform-origin: left center;
    animation: night-meteor-flight var(--meteor-duration) linear forwards;
    will-change: transform, opacity;
  }
  .night-sky__meteor::before {
    content: '';
    position: absolute;
    left: -1px;
    top: calc((var(--meteor-head-size, 6px) - var(--meteor-thickness, 2px)) / -2);
    width: var(--meteor-head-size, 6px);
    height: var(--meteor-head-size, 6px);
    border-radius: 50%;
    background: #f5fbff;
    box-shadow: 0 0 var(--meteor-head-glow, 9px) rgba(180, 224, 255, var(--meteor-head-alpha, .95));
  }
  @keyframes night-meteor-flight {
    0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(var(--meteor-angle)); }
    8% { opacity: var(--meteor-peak-opacity, .95); }
    82% { opacity: var(--meteor-peak-opacity, .95); }
    100% {
      opacity: 0;
      transform: translate3d(var(--meteor-travel-x), var(--meteor-travel-y), 0) rotate(var(--meteor-angle));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .night-sky__star { animation: none; }
    .night-sky__meteor { display: none; }
  }
</style>

<script>
  // This component is persistent: initialize once, including after navigation.
  const mountNightSky = () => {
    const layer = document.querySelector<HTMLElement>('.night-sky');
    if (!layer || layer.dataset.ready === 'true') return;
    layer.dataset.ready = 'true';
    const stars = layer.querySelector<HTMLElement>('.night-sky__stars');
    const meteors = layer.querySelector<HTMLElement>('.night-sky__meteors');
    if (!stars || !meteors) return;

    const randomBetween = (min: number, max: number) => min + Math.random() * (max - min);
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Keep points fixed across page navigation; only opacity softly changes.
    for (let i = 0; i < 75; i++) {
      const star = document.createElement('i');
      const bright = i < 22;
      star.className = 'night-sky__star';
      star.style.left = `${randomBetween(1, 99).toFixed(2)}%`;
      star.style.top = `${randomBetween(2, 98).toFixed(2)}%`;
      star.style.setProperty('--star-size', `${randomBetween(bright ? 1.7 : .7, bright ? 3 : 1.5).toFixed(2)}px`);
      star.style.setProperty('--star-opacity', randomBetween(bright ? .7 : .3, bright ? .96 : .65).toFixed(2));
      star.style.setProperty('--star-glow', `${randomBetween(bright ? 6 : 2, bright ? 11 : 5).toFixed(1)}px`);
      star.style.setProperty('--twinkle-time', `${randomBetween(3.5, 9).toFixed(1)}s`);
      star.style.setProperty('--twinkle-delay', `${randomBetween(-9, 0).toFixed(1)}s`);
      stars.appendChild(star);
    }

    // The background persists across Astro navigation; timers are created once.
    const activeMeteors = new Set<HTMLElement>();
    let scheduled: number | undefined;
    let burstTimer: number | undefined;
    const canAnimate = () => layer.isConnected && !motion.matches && !document.hidden;

    const shoot = (allowBurst = true) => {
      if (!canAnimate()) return;
      const viewportWidth = layer.clientWidth || window.innerWidth;
      const viewportHeight = layer.clientHeight || window.innerHeight;
      const desktop = viewportWidth > 900;
      // Limit the number of simultaneous glow layers to avoid adding scroll lag.
      if (activeMeteors.size >= (desktop ? 2 : 1)) return;

      const meteor = document.createElement('span');
      meteor.className = 'night-sky__meteor';

      // Every meteor gets a new path, trail, glow and duration.
      const angle = randomBetween(20, 49);
      const radians = angle * Math.PI / 180;
      const sizeFactor = Math.min(Math.max(Math.sqrt(viewportWidth / 1440), .8), 1.2);
      const lengthRoll = Math.random();
      const length = desktop
        ? Math.min(viewportWidth * .58,
            (lengthRoll < .18 ? randomBetween(260, 355)
              : lengthRoll < .91 ? randomBetween(380, 640)
              : randomBetween(700, 880)) * sizeFactor)
        : Math.min(viewportWidth * .61,
            lengthRoll < .88 ? randomBetween(95, 185) : randomBetween(190, 240));

      // Leave room for the rotated trail at the right/top of the viewport.
      const maxStartX = Math.max(20, viewportWidth - Math.cos(radians) * length - 24);
      const minStartX = Math.min(viewportWidth * .37, maxStartX);
      const startX = randomBetween(minStartX, Math.max(minStartX, Math.min(viewportWidth * .82, maxStartX)));
      const minStartY = Math.sin(radians) * length + 14;
      const startY = randomBetween(
        Math.min(minStartY, viewportHeight * .42),
        Math.max(Math.min(minStartY, viewportHeight * .42), viewportHeight * .53)
      );

      // A meteor always moves down-left; its direction and distance vary.
      // Clamp the path so even a six-second meteor remains visible throughout.
      const roomLeft = (startX - 12) / Math.cos(radians);
      const roomDown = (viewportHeight - startY - 22) / Math.sin(radians);
      const room = Math.max(0, Math.min(roomLeft, roomDown));
      const desiredTravel = desktop
        ? randomBetween(viewportWidth * .28, viewportWidth * .63)
        : randomBetween(viewportWidth * .44, viewportWidth * .92);
      const travel = Math.min(desiredTravel, room);
      const durationSeconds = randomBetween(2, 6);
      const brightness = randomBetween(.68, .99);
      const thickness = randomBetween(1.5, 2.7);

      meteor.style.setProperty('--meteor-x', `${startX.toFixed(0)}px`);
      meteor.style.setProperty('--meteor-y', `${startY.toFixed(0)}px`);
      meteor.style.setProperty('--meteor-length', `${length.toFixed(0)}px`);
      meteor.style.setProperty('--meteor-angle', `${(-angle).toFixed(1)}deg`);
      meteor.style.setProperty('--meteor-travel-x', `${(-travel * Math.cos(radians)).toFixed(0)}px`);
      meteor.style.setProperty('--meteor-travel-y', `${(travel * Math.sin(radians)).toFixed(0)}px`);
      meteor.style.setProperty('--meteor-duration', `${durationSeconds.toFixed(2)}s`);
      meteor.style.setProperty('--meteor-thickness', `${thickness.toFixed(1)}px`);
      meteor.style.setProperty('--meteor-head-size', `${randomBetween(4.5, 7.5).toFixed(1)}px`);
      meteor.style.setProperty('--meteor-glow', `${randomBetween(2.5, 5.5).toFixed(1)}px`);
      meteor.style.setProperty('--meteor-head-glow', `${randomBetween(6, 11).toFixed(1)}px`);
      meteor.style.setProperty('--meteor-peak-opacity', brightness.toFixed(2));
      meteor.style.setProperty('--meteor-head-alpha', brightness.toFixed(2));
      meteor.style.setProperty('--meteor-mid-alpha', (brightness * randomBetween(.69, .90)).toFixed(2));
      meteor.style.setProperty('--meteor-tail-alpha', (brightness * randomBetween(.30, .52)).toFixed(2));
      meteor.style.setProperty('--meteor-glow-alpha', (brightness * randomBetween(.30, .60)).toFixed(2));
      meteor.style.setProperty('--meteor-bright-stop', `${randomBetween(18, 35).toFixed(0)}%`);
      meteor.style.setProperty('--meteor-fade-stop', `${randomBetween(77, 92).toFixed(0)}%`);

      activeMeteors.add(meteor);
      meteors.appendChild(meteor);
      meteor.addEventListener('animationend', () => {
        meteor.remove();
        activeMeteors.delete(meteor);
      }, { once: true });

      // Rare paired streaks on desktop; no more than two at once.
      if (desktop && allowBurst && activeMeteors.size === 1 && burstTimer === undefined && Math.random() < .16) {
        burstTimer = window.setTimeout(() => {
          burstTimer = undefined;
          shoot(false);
        }, randomBetween(450, 1150));
      }
    };

    const schedule = () => {
      window.clearTimeout(scheduled);
      if (!canAnimate()) return;
      const desktop = (layer.clientWidth || window.innerWidth) > 900;
      scheduled = window.setTimeout(() => {
        shoot();
        schedule();
      }, desktop ? randomBetween(1600, 5600) : randomBetween(2400, 6600));
    };

    const onVisibility = () => {
      if (!canAnimate()) {
        window.clearTimeout(scheduled);
        window.clearTimeout(burstTimer);
        burstTimer = undefined;
        activeMeteors.forEach((meteor) => meteor.remove());
        activeMeteors.clear();
      } else {
        schedule();
      }
    };
    document.addEventListener('visibilitychange', onVisibility);
    motion.addEventListener('change', onVisibility);
    schedule();
  };
  mountNightSky();
  document.addEventListener('astro:page-load', mountNightSky);
</script>
