---
/** One continuous, persistent night-sky background for every page and mobile menu. */
---

<div class="night-sky" transition:persist="night-sky" aria-hidden="true">
  <div class="night-sky__glow"></div>
  <div class="night-sky__aurora"></div>
  <div class="night-sky__stars"></div>
  <div class="night-sky__meteors"></div>
  <div class="night-sky__aircraft"></div>
</div>

<style is:global>
  .night-sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #07121f url('/background/eason-night.svg') center bottom / cover no-repeat;
    contain: paint;
  }

  .night-sky__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 44% 32% at 66% 34%, rgba(56, 114, 169, .07), transparent),
      radial-gradient(ellipse 36% 29% at 25% 77%, rgba(79, 131, 176, .04), transparent);
  }

  .night-sky__stars,
  .night-sky__meteors,
  .night-sky__aircraft {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .night-sky__star {
    position: absolute;
    display: block;
    width: var(--star-size);
    height: var(--star-size);
    border-radius: 50%;
    background: #e4f2ff;
    opacity: var(--star-opacity);
    box-shadow: 0 0 var(--star-glow) rgba(181, 222, 255, .52);
    animation: night-star-twinkle var(--twinkle-time) ease-in-out var(--twinkle-delay) infinite alternate;
  }

  @keyframes night-star-twinkle {
    from { opacity: calc(var(--star-opacity) * .48); }
    to   { opacity: var(--star-opacity); }
  }

  .night-sky__meteor {
    position: absolute;
    left: var(--meteor-x);
    top: var(--meteor-y);
    width: var(--meteor-length);
    height: var(--meteor-thickness, 2px);
    border-radius: 99px;
    opacity: 0;
    transform-origin: left center;
    background: linear-gradient(to right,
      rgba(245, 252, 255, var(--meteor-head-alpha, .95)) 0%,
      rgba(197, 233, 255, var(--meteor-mid-alpha, .75)) var(--meteor-bright-stop, 27%),
      rgba(142, 204, 255, var(--meteor-tail-alpha, .26)) var(--meteor-fade-stop, 82%),
      transparent 100%);
    box-shadow: 0 0 var(--meteor-glow, 4px) rgba(193, 226, 255, var(--meteor-glow-alpha, .48));
    animation: night-meteor-flight var(--meteor-duration) linear forwards;
    will-change: transform, opacity;
  }

  .night-sky__meteor::before {
    content: '';
    position: absolute;
    left: -1px;
    top: calc((var(--meteor-head-size, 6px) - var(--meteor-thickness, 2px)) / -2);
    width: var(--meteor-head-size, 6px);
    height: var(--meteor-head-size, 6px);
    border-radius: 50%;
    background: #f5fbff;
    box-shadow: 0 0 var(--meteor-head-glow, 9px) rgba(180, 224, 255, var(--meteor-head-alpha, .95));
  }

  @keyframes night-meteor-flight {
    0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(var(--meteor-angle)); }
    8%, 82% { opacity: var(--meteor-peak-opacity, .95); }
    100% {
      opacity: 0;
      transform: translate3d(var(--meteor-travel-x), var(--meteor-travel-y), 0) rotate(var(--meteor-angle));
    }
  }

  /* A distant aircraft: tiny silhouette and gently blinking lights, never a large close-up. */
  .night-sky__plane {
    position: absolute;
    left: var(--plane-x);
    top: var(--plane-y);
    width: var(--plane-size, 10px);
    height: 2px;
    border-radius: 50%;
    background: rgba(213, 231, 242, .85);
    box-shadow: 0 0 4px rgba(202, 232, 255, .42);
    opacity: 0;
    animation: night-plane-flight var(--plane-duration) linear forwards;
    will-change: transform, opacity;
  }

  /* A thin, fading contrail drawn behind the distant plane. Rotating the
     parent along its heading keeps the trail behind it in either direction.
     One gradient element only; no smoke particles or expensive blur filters. */
  .night-sky__plane-trail {
    position: absolute;
    left: calc(-1 * var(--plane-trail-length, 32px) + 1px);
    top: 0;
    width: var(--plane-trail-length, 32px);
    height: var(--plane-trail-thickness, 1.5px);
    border-radius: 99px;
    background: linear-gradient(to right,
      transparent,
      rgba(169, 189, 204, .12) 35%,
      rgba(192, 214, 228, var(--plane-trail-opacity, .35)) 100%);
    pointer-events: none;
  }

  .night-sky__plane::before,
  .night-sky__plane::after {
    content: '';
    position: absolute;
    top: -1px;
    width: 3.5px;
    height: 3.5px;
    border-radius: 50%;
    animation: night-plane-blink var(--plane-blink-time) steps(1, end) infinite;
  }
  .night-sky__plane::before {
    left: 0;
    background: #ed8589;
    box-shadow: 0 0 3px rgba(238, 95, 100, .66);
  }
  .night-sky__plane::after {
    right: 0;
    background: #e0f4ff;
    box-shadow: 0 0 3px rgba(195, 222, 250, .66);
    animation-delay: calc(var(--plane-blink-time) * -.5);
  }

  @keyframes night-plane-flight {
    /* Opacity stays visible from the first edge to the opposite edge.
       The plane starts and finishes outside the clipped viewport. */
    0% { opacity: var(--plane-opacity, .42); transform: translate3d(0, 0, 0) rotate(var(--plane-tilt)); }
    100% {
      opacity: var(--plane-opacity, .42);
      transform: translate3d(var(--plane-dx), var(--plane-dy), 0) rotate(var(--plane-tilt));
    }
  }
  @keyframes night-plane-blink {
    0%, 49% { opacity: .2; }
    50%, 70% { opacity: 1; }
    71%, 100% { opacity: .27; }
  }

  /* Soft but visible throughout the open night sky, including the mountain
     horizon visible near the footer. A single animated gradient layer. */
  .night-sky__aurora {
    position: absolute;
    inset: 0 -12%;
    opacity: 0;
    background:
      radial-gradient(ellipse 44% 34% at 29% 43%, rgba(65, 199, 168, .63), transparent 78%),
      radial-gradient(ellipse 44% 31% at 72% 64%, rgba(56, 168, 206, .52), transparent 77%),
      linear-gradient(117deg,
        transparent 18%, rgba(45, 173, 156, .17) 33%,
        rgba(81, 199, 177, .38) 47%, transparent 64%,
        rgba(66, 166, 202, .26) 75%, transparent 89%);
    pointer-events: none;
  }
  .night-sky__aurora.is-visible {
    /* Negative delay lets late visitors join the current event mid-animation. */
    animation: night-aurora-appear var(--aurora-duration) ease-in-out var(--aurora-delay, 0ms) both;
    will-change: opacity, transform;
  }
  @keyframes night-aurora-appear {
    0% { opacity: 0; transform: translate3d(-2%, 2%, 0) skewX(-8deg); }
    24% { opacity: var(--aurora-opacity); transform: translate3d(0, 0, 0) skewX(-4deg); }
    57% { opacity: calc(var(--aurora-opacity) * .82); transform: translate3d(2%, -1%, 0) skewX(-1deg); }
    78% { opacity: var(--aurora-opacity); transform: translate3d(3%, 1%, 0) skewX(2deg); }
    100% { opacity: 0; transform: translate3d(5%, 2%, 0) skewX(5deg); }
  }

  /* The existing fixed sky becomes visible *through* the drawer, not another image. */
  @media (max-width: 900px) {
    body:has(header.mobile-menu-open) .night-sky {
      z-index: 99;
      clip-path: inset(64px 0 0 calc(100% - min(86vw, 320px)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .night-sky__star,
    .night-sky__meteor,
    .night-sky__plane,
    .night-sky__aurora { animation: none !important; }
    .night-sky__meteor,
    .night-sky__plane,
    .night-sky__aurora { display: none !important; }
  }
</style>

<script>
  import { getAuroraState } from '../lib/sky/aurora-schedule';

  // This element persists across Astro navigation; start timers only once.
  const mountNightSky = () => {
    const layer = document.querySelector<HTMLElement>('.night-sky');
    if (!layer || layer.dataset.ready === 'true') return;
    const stars = layer.querySelector<HTMLElement>('.night-sky__stars');
    const meteors = layer.querySelector<HTMLElement>('.night-sky__meteors');
    const aircraft = layer.querySelector<HTMLElement>('.night-sky__aircraft');
    const aurora = layer.querySelector<HTMLElement>('.night-sky__aurora');
    if (!stars || !meteors || !aircraft || !aurora) return;
    layer.dataset.ready = 'true';

    const randomBetween = (min: number, max: number) => min + Math.random() * (max - min);
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const viewport = () => ({ width: layer.clientWidth || window.innerWidth, height: layer.clientHeight || window.innerHeight });
    const canAnimate = () => layer.isConnected && !motion.matches && !document.hidden;

    // Static positions, soft twinkle; fewer animated points on small devices.
    const starCount = motion.matches ? 0 : (window.innerWidth > 900 ? 48 : 30);
    for (let i = 0; i < starCount; i++) {
      const star = document.createElement('i');
      const bright = i < Math.ceil(starCount * .29);
      star.className = 'night-sky__star';
      star.style.left = `${randomBetween(1, 99).toFixed(2)}%`;
      star.style.top = `${randomBetween(2, 98).toFixed(2)}%`;
      star.style.setProperty('--star-size', `${randomBetween(bright ? 1.6 : .7, bright ? 2.8 : 1.4).toFixed(2)}px`);
      star.style.setProperty('--star-opacity', randomBetween(bright ? .64 : .26, bright ? .90 : .58).toFixed(2));
      star.style.setProperty('--star-glow', `${randomBetween(bright ? 5 : 1.5, bright ? 9 : 4).toFixed(1)}px`);
      star.style.setProperty('--twinkle-time', `${randomBetween(4, 10).toFixed(1)}s`);
      star.style.setProperty('--twinkle-delay', `${randomBetween(-10, 0).toFixed(1)}s`);
      stars.appendChild(star);
    }

    const activeMeteors = new Set<HTMLElement>();
    let activePlane: HTMLElement | null = null;
    let meteorTimer: number | undefined;
    let meteorBurstTimer: number | undefined;
    let planeTimer: number | undefined;
    let auroraSyncTimer: number | undefined;
    let auroraEventId: number | null = null;

    const shootMeteor = (allowBurst = true) => {
      if (!canAnimate()) return;
      const { width, height } = viewport();
      const desktop = width > 900;
      if (activeMeteors.size >= (desktop ? 2 : 1)) return;

      const angle = randomBetween(9, 78);
      const rad = angle * Math.PI / 180;
      const goesLeft = Math.random() < .77;
      const roll = Math.random();
      const sizeScale = Math.min(Math.max(Math.sqrt(width / 1440), .8), 1.25);
      const requestedLength = desktop
        ? (roll < .18 ? randomBetween(180, 300)
          : roll < .88 ? randomBetween(340, 610) : randomBetween(660, 890)) * sizeScale
        : (roll < .24 ? randomBetween(72, 115)
          : roll < .91 ? randomBetween(115, 190) : randomBetween(195, 255));
      // Keep the entire trail and starting point inside the same viewport.
      const maxTailLength = Math.min(width * .60 / Math.max(.14, Math.cos(rad)), height * .57 / Math.max(.14, Math.sin(rad)));
      const length = Math.max(45, Math.min(requestedLength, maxTailLength));
      const tailX = length * Math.cos(rad);
      const tailY = length * Math.sin(rad);
      const minX = goesLeft ? Math.min(width * .51, width - tailX - 14) : tailX + 14;
      const maxX = goesLeft ? width - tailX - 14 : Math.max(minX, width * .53);
      const x = randomBetween(Math.max(14, minX), Math.max(Math.max(14, minX), Math.min(width - 12, maxX)));
      const y = randomBetween(tailY + 15, Math.max(tailY + 15, height * .76));

      const availableX = goesLeft ? x - 14 : width - x - 14;
      const availableY = height - y - 20;
      const maxTravel = Math.max(0, Math.min(availableX / Math.max(.14, Math.cos(rad)), availableY / Math.max(.14, Math.sin(rad))));
      const travel = Math.min(randomBetween(width * .26, width * .65), maxTravel);
      const brightnessRoll = Math.random();
      const brightness = brightnessRoll < .45 ? randomBetween(.18, .42)
        : brightnessRoll < .85 ? randomBetween(.43, .72) : randomBetween(.73, .98);
      const duration = randomBetween(2, 6);
      const meteor = document.createElement('span');
      meteor.className = 'night-sky__meteor';
      const props: Record<string, string> = {
        '--meteor-x': `${x.toFixed(0)}px`,
        '--meteor-y': `${y.toFixed(0)}px`,
        '--meteor-length': `${length.toFixed(0)}px`,
        '--meteor-angle': `${(goesLeft ? -angle : 180 + angle).toFixed(1)}deg`,
        '--meteor-travel-x': `${((goesLeft ? -1 : 1) * travel * Math.cos(rad)).toFixed(0)}px`,
        '--meteor-travel-y': `${(travel * Math.sin(rad)).toFixed(0)}px`,
        '--meteor-duration': `${duration.toFixed(2)}s`,
        '--meteor-thickness': `${randomBetween(1.2, 2.7).toFixed(1)}px`,
        '--meteor-head-size': `${randomBetween(3.5, 7.2).toFixed(1)}px`,
        '--meteor-glow': `${randomBetween(2, 5).toFixed(1)}px`,
        '--meteor-head-glow': `${randomBetween(4, 10).toFixed(1)}px`,
        '--meteor-peak-opacity': brightness.toFixed(2),
        '--meteor-head-alpha': brightness.toFixed(2),
        '--meteor-mid-alpha': (brightness * randomBetween(.66, .90)).toFixed(2),
        '--meteor-tail-alpha': (brightness * randomBetween(.29, .49)).toFixed(2),
        '--meteor-glow-alpha': (brightness * randomBetween(.25, .55)).toFixed(2),
        '--meteor-bright-stop': `${randomBetween(18, 37).toFixed(0)}%`,
        '--meteor-fade-stop': `${randomBetween(77, 93).toFixed(0)}%`,
      };
      for (const [name, value] of Object.entries(props)) meteor.style.setProperty(name, value);
      activeMeteors.add(meteor);
      meteors.appendChild(meteor);
      meteor.addEventListener('animationend', () => {
        meteor.remove();
        activeMeteors.delete(meteor);
      }, { once: true });

      // Occasional pair, never more than two simultaneous meteors on desktop.
      if (desktop && allowBurst && activeMeteors.size === 1 && meteorBurstTimer === undefined && Math.random() < .13) {
        meteorBurstTimer = window.setTimeout(() => {
          meteorBurstTimer = undefined;
          shootMeteor(false);
        }, randomBetween(400, 1000));
      }
    };

    const scheduleMeteor = () => {
      window.clearTimeout(meteorTimer);
      if (!canAnimate()) return;
      meteorTimer = window.setTimeout(() => {
        shootMeteor();
        scheduleMeteor();
      }, randomBetween(6000, 18000));
    };

    const schedulePlane = () => {
      window.clearTimeout(planeTimer);
      if (!canAnimate()) return;
      planeTimer = window.setTimeout(() => {
        planeTimer = undefined;
        if (!canAnimate() || activePlane) return;
        const { width, height } = viewport();
        const fromLeft = Math.random() < .5;
        const plane = document.createElement('span');
        plane.className = 'night-sky__plane';
        const size = randomBetween(width > 900 ? 10 : 7, width > 900 ? 17 : 12);
        const margin = size + 8;
        const fromX = fromLeft ? -margin : width + margin;
        const toX = fromLeft ? width + margin : -margin;
        const fromY = randomBetween(height * .14, height * .55);
        const toY = Math.max(height * .08, Math.min(height * .65, fromY + randomBetween(-height * .07, height * .07)));
        const deltaX = toX - fromX;
        const deltaY = toY - fromY;
        const props: Record<string, string> = {
          // Both endpoints are fully outside the viewport: an actual full crossing.
          '--plane-x': `${fromX.toFixed(0)}px`,
          '--plane-y': `${fromY.toFixed(0)}px`,
          '--plane-dx': `${deltaX.toFixed(0)}px`,
          '--plane-dy': `${deltaY.toFixed(0)}px`,
          '--plane-size': `${size.toFixed(1)}px`,
          '--plane-opacity': randomBetween(.56, .88).toFixed(2),
          '--plane-trail-length': `${randomBetween(width > 900 ? 28 : 15, width > 900 ? 58 : 32).toFixed(0)}px`,
          '--plane-trail-thickness': `${randomBetween(1, 2).toFixed(1)}px`,
          '--plane-trail-opacity': randomBetween(.25, .45).toFixed(2),
          '--plane-duration': `${randomBetween(15, 30).toFixed(1)}s`,
          '--plane-tilt': `${(Math.atan2(deltaY, deltaX) * 180 / Math.PI).toFixed(1)}deg`,
          '--plane-blink-time': `${randomBetween(.85, 2.2).toFixed(2)}s`,
        };
        for (const [name, value] of Object.entries(props)) plane.style.setProperty(name, value);
        const trail = document.createElement('span');
        trail.className = 'night-sky__plane-trail';
        plane.appendChild(trail);
        activePlane = plane;
        aircraft.appendChild(plane);
        plane.addEventListener('animationend', (event) => {
          if (event.animationName !== 'night-plane-flight') return;
          plane.remove();
          if (activePlane === plane) activePlane = null;
          schedulePlane();
        });
      }, randomBetween(3 * 60_000, 8 * 60_000));
    };

    // Aurora is scheduled by absolute time, never by how long this tab stays open.
    // Visitors joining mid-event use a negative CSS animation delay to catch up.
    const synchronizeAurora = () => {
      window.clearTimeout(auroraSyncTimer);
      if (!canAnimate()) return;
      const now = Date.now();
      const { active, next } = getAuroraState(now);

      if (!active) {
        if (auroraEventId !== null) {
          aurora.classList.remove('is-visible');
          auroraEventId = null;
        }
      } else if (active.id !== auroraEventId) {
        auroraEventId = active.id;
        aurora.style.setProperty('--aurora-opacity', active.strength.toFixed(2));
        aurora.style.setProperty('--aurora-duration', `${active.durationMs}ms`);
        aurora.style.setProperty('--aurora-delay', `${active.startsAt - now}ms`);
        aurora.classList.remove('is-visible');
        // Restart only when a new event starts, not every update.
        void aurora.offsetWidth;
        aurora.classList.add('is-visible');
      }

      const boundary = active ? active.endsAt : next.startsAt;
      // Wake at the next boundary; at most one check per minute for clock changes.
      const delay = Math.min(60_000, Math.max(120, boundary - Date.now() + 40));
      auroraSyncTimer = window.setTimeout(synchronizeAurora, delay);
    };

    const onVisibility = () => {
      window.clearTimeout(meteorTimer);
      window.clearTimeout(meteorBurstTimer);
      window.clearTimeout(planeTimer);
      window.clearTimeout(auroraSyncTimer);
      meteorBurstTimer = undefined;
      if (!canAnimate()) {
        for (const meteor of activeMeteors) meteor.remove();
        activeMeteors.clear();
        activePlane?.remove();
        activePlane = null;
        aurora.classList.remove('is-visible');
        auroraEventId = null;
        return;
      }
      scheduleMeteor();
      if (!activePlane) schedulePlane();
      synchronizeAurora();
    };
    document.addEventListener('visibilitychange', onVisibility);
    motion.addEventListener('change', onVisibility);
    onVisibility();
  };
  mountNightSky();
  document.addEventListener('astro:page-load', mountNightSky);
</script>