---
import type { CollectionEntry } from 'astro:content';
import InteriorHeading from './InteriorHeading.astro';
import PostListItem from './PostListItem.astro';
import PageShell from '../layouts/PageShell.astro';
import { siteTitle } from '../config';
import { extractExcerpt } from '../lib/content/text';
import { getTagPath } from '../lib/content/tag-path';
import { getWorkTagPath } from '../lib/content/work-tag-path';
import { CONTENT_PAGE_SIZE } from '../lib/cloudflare/pagination';

interface Props {
  tag: string;
  posts: Array<CollectionEntry<'blog'> | CollectionEntry<'works'>>;
  sortedTags: Array<[string, number]>;
  totalCount: number;
  kind: 'blog' | 'works';
}

const { tag, posts, sortedTags, totalCount, kind } = Astro.props;
const displayTags = [...sortedTags].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hant'));
const isWork = kind === 'works';
const label = isWork ? '作品' : '文章';
const archiveUrl = isWork ? '/experience/' : '/blog/';
const hrefBase = isWork ? '/experience' : '/blog';
const pathForTag = isWork ? getWorkTagPath : getTagPath;
const visiblePosts = [...posts].sort((a, b) =>
  Number(b.data.pinned) - Number(a.data.pinned)
  || b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const pageCount = Math.ceil(visiblePosts.length / CONTENT_PAGE_SIZE);
---

<PageShell title={`#${tag} | ${siteTitle}`} description={`查看 #${tag} 的${label}`} transparentHeader={false} pageId="blog-list">
  <style>
      .blog-posts-list :global(.blog-post-item) {
        padding: 1.2em 1em;
        margin: 0 -1em;
        border-bottom: 1px solid var(--color-border-subtle);
        border-radius: 12px;
        position: relative;
        transition:
          background-color 0.2s cubic-bezier(0.2, 0, 0, 1),
          border-color 0.2s cubic-bezier(0.2, 0, 0, 1),
          box-shadow 0.2s cubic-bezier(0.2, 0, 0, 1),
          transform 0.2s cubic-bezier(0.2, 0, 0, 1);
      }

      .blog-posts-list :global(.blog-post-item:last-child) {
        border-bottom: none;
      }

      .blog-posts-list :global(.blog-post-item)::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%) scaleY(0);
        width: 3px;
        height: 60%;
        background: var(--accent);
        border-radius: 0 3px 3px 0;
        transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
      }

      .blog-posts-list :global(.blog-post-item:hover) {
        background: var(--color-surface-hover);
        box-shadow: var(--shadow-card-hover);
        transform: translateX(4px);
      }

      .blog-posts-list :global(.blog-post-item:hover)::before {
        transform: translateY(-50%) scaleY(1);
      }

      .blog-posts-list :global(.blog-post-title) {
        font-size: 1.4em;
        font-weight: 700;
        margin: 0 0 0.5em 0;
        color: var(--color-text);
      }

      .blog-posts-list :global(.blog-post-title a) {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s;
      }

      .blog-posts-list :global(.blog-post-title a:hover) {
        color: var(--accent);
      }

      .blog-posts-list :global(.blog-post-excerpt) {
        color: var(--color-text-secondary);
        font-size: 0.95em;
        line-height: 1.6;
        margin: 0 0 1em 0;
      }

      .blog-posts-list :global(.blog-post-meta) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1em;
        font-size: 0.85em;
        color: var(--color-text-tertiary);
      }

      .blog-posts-list :global(.blog-post-meta-item) {
        display: flex;
        align-items: center;
        gap: 0.3em;
        padding: 2px 6px;
        border-radius: 4px;
      }

      .blog-posts-list :global(.blog-post-meta-item svg) {
        width: 14px;
        height: 14px;
      }

      .blog-posts-list :global(.blog-post-tags) {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
      }

      .blog-posts-list :global(.blog-tag-link) {
        display: inline-flex;
        align-items: center;
        gap: 0.2em;
        padding: 2px 8px;
        background: var(--color-tag-bg);
        color: var(--color-tag-text);
        text-decoration: none;
        border-radius: 4px;
        font-size: 0.85em;
        transition:
          background-color 0.3s cubic-bezier(0.2, 0, 0, 1),
          color 0.3s cubic-bezier(0.2, 0, 0, 1),
          box-shadow 0.3s cubic-bezier(0.2, 0, 0, 1),
          transform 0.3s cubic-bezier(0.2, 0, 0, 1);
        transform-origin: center;
      }

      .blog-posts-list :global(.blog-tag-link:hover) {
        background: var(--accent);
        color: white;
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 3px 8px rgba(var(--accent-rgb), 0.25);
      }

      .blog-posts-list :global(.blog-tag-link:active) {
        transform: translateY(0) scale(0.97);
      }

      .blog-posts-list :global(.blog-tag-link svg) {
        width: 12px;
        height: 12px;
      }

      @media (max-width: 900px) {
        .blog-posts-list :global(.blog-post-item) {
          margin: 0;
          padding: 1em 0.75em;
        }
      }

      @media (max-width: 720px) {
        .blog-posts-list :global(.blog-post-title) {
          font-size: 1.2em;
        }

        .blog-posts-list :global(.blog-post-meta) {
          gap: 0.6em;
        }
      }

      .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 3em;
        padding-top: 2em;
        border-top: 1px solid var(--color-border);
        gap: 1em;
      }

      .page-numbers {
        display: flex;
        align-items: center;
        gap: 0.5em;
        transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1);
      }

      .pagination:hover .page-numbers {
        transform: scale(1.02);
      }

      .page-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: transparent;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition:
          color 0.3s cubic-bezier(0.05, 0.7, 0.1, 1),
          background-color 0.3s cubic-bezier(0.05, 0.7, 0.1, 1),
          border-color 0.3s cubic-bezier(0.05, 0.7, 0.1, 1),
          transform 0.3s cubic-bezier(0.05, 0.7, 0.1, 1),
          box-shadow 0.3s cubic-bezier(0.05, 0.7, 0.1, 1);
        font-weight: 500;
        font-size: 0.95em;
        border: 1px solid transparent;
        position: relative;
        overflow: hidden;
        transform-origin: center;
      }

      .page-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--accent);
        opacity: 0;
        border-radius: inherit;
        transform: scale(0);
        transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1), opacity 0.3s cubic-bezier(0.05, 0.7, 0.1, 1);
      }

      .page-btn:hover:not(.disabled):not(.active)::after {
        transform: scale(1);
        opacity: 0.06;
      }

      .page-btn:hover:not(.disabled):not(.active) {
        color: var(--accent);
        transform: translateY(-3px) scale(1.05);
        transition:
          transform 0.25s cubic-bezier(0.05, 0.7, 0.1, 1),
          box-shadow 0.25s cubic-bezier(0.05, 0.7, 0.1, 1);
      }

      .page-btn.active {
        background: var(--accent);
        color: white;
        font-weight: 600;
        box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.35);
        transform: scale(1.08);
        transition:
          color 0.4s cubic-bezier(0.2, 0, 0, 1),
          background-color 0.4s cubic-bezier(0.2, 0, 0, 1),
          border-color 0.4s cubic-bezier(0.2, 0, 0, 1),
          box-shadow 0.4s cubic-bezier(0.2, 0, 0, 1),
          transform 0.4s cubic-bezier(0.2, 0, 0, 1);
      }

      .page-btn.disabled {
        opacity: 0.25;
        cursor: not-allowed;
        pointer-events: none;
        transition: opacity 0.3s cubic-bezier(0.3, 0, 0.8, 0.15);
      }

      .prev-btn:hover:not(.disabled),
      .next-btn:hover:not(.disabled) {
        transform: translateY(-3px) scale(1.05);
        transition: transform 0.25s cubic-bezier(0.05, 0.7, 0.1, 1);
      }

      .prev-btn:active:not(.disabled) {
        transform: translateX(-4px) scale(0.95);
        transition: transform 0.15s cubic-bezier(0.3, 0, 0.8, 0.15);
      }

      .next-btn:active:not(.disabled) {
        transform: translateX(4px) scale(0.95);
        transition: transform 0.15s cubic-bezier(0.3, 0, 0.8, 0.15);
      }

      @media (max-width: 480px) {
        .pagination {
          gap: 0.5em;
          justify-content: flex-start;
          overflow-x: auto;
          padding-bottom: 0.4em;
        }

        .page-numbers {
          gap: 0.2em;
          flex-shrink: 0;
        }

        .page-btn {
          width: 32px;
          height: 32px;
          font-size: 0.85em;
        }
      }

      .scroll-reveal {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.6s cubic-bezier(0.05, 0.7, 0.1, 1), transform 0.6s cubic-bezier(0.05, 0.7, 0.1, 1);
      }

      .scroll-reveal.reveal-pending {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s cubic-bezier(0.05, 0.7, 0.1, 1), transform 0.6s cubic-bezier(0.05, 0.7, 0.1, 1);
      }

      .scroll-reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .page-ellipsis {
        color: var(--color-text-muted);
        padding: 0 0.2em;
        font-size: 0.9em;
        animation: ellipsisPulse 1.8s cubic-bezier(0.2, 0, 0, 1) infinite;
        transition:
          color 0.3s cubic-bezier(0.05, 0.7, 0.1, 1),
          transform 0.3s cubic-bezier(0.05, 0.7, 0.1, 1);
      }

      .page-ellipsis:hover {
        color: var(--accent);
        transform: scale(1.2);
      }

      @keyframes ellipsisPulse {
        0%,
        100% {
          opacity: 0.2;
          transform: scale(1);
        }

        50% {
          opacity: 1;
          transform: scale(1.05);
        }
      }

      /* Blog index: preserve the template Hero, use homepage dark palette below. */
      .articles-area {
        position: relative;
        z-index: 2;
        /* The Hero already overlaps the next section by 88px. Keep that
           region transparent so the rounded article card sits over the photo. */
        background: linear-gradient(to bottom, transparent 88px, #171c25 88px);
        min-height: 44vh;
        padding: 0 1.5rem 5rem;
        color: #ecf1f8;
      }
      .articles-inner {
        width: min(100%, 960px);
        margin: 0 auto;
        padding: 2rem clamp(1.2rem, 3vw, 2.5rem);
        background: #222936;
        border: 1px solid rgba(155, 177, 214, .19);
        border-radius: 18px;
        box-sizing: border-box;
      }
      .article-tags {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .6rem;
        padding-bottom: 1.6rem;
        margin-bottom: 1.2rem;
        border-bottom: 1px solid rgba(159, 179, 212, .2);
      }
      .tag-filter {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        text-decoration: none;
        padding: .4rem .72rem;
        background: rgba(145, 175, 207, .08);
        border: 1px solid rgba(155, 177, 214, .18);
        border-radius: 9px;
        color: #c5d4e7;
        font-size: .88rem;
        transition: background .2s, color .2s, transform .2s;
      }
      .tag-filter:hover {
        background: rgba(145,175,207,.16);
        color: #fff;
        transform: translateY(-2px);
      }
      .tag-filter.all-tag { color: #f0f5ff; }
      .tag-hash { color: #9abce6; }
      .tag-filter .tag-count, .tag-filter.all-tag span {
        color: #9dadc4;
        font-size: .78rem;
        margin-left: .15rem;
      }
      .articles-list { display: flex; flex-direction: column; }
      .articles-empty { color: #bbc6d7; padding: 1.4rem 0; }
      .pinned-mark {
        color: #abc9ef;
        font-size: .8rem;
        font-weight: 600;
        padding-top: .8rem;
      }
      .blog-posts-list { display: flex; flex-direction: column; }
      .articles-list :global(.blog-post-item) {
        position: relative;
        cursor: pointer;
        padding: 1.4rem .6rem;
        margin: 0;
        border-bottom: 1px solid rgba(159, 179, 212, .17);
        border-radius: 8px;
        transition: background-color .22s ease, transform .22s ease;
      }
      .articles-list :global(.blog-post-item:hover) {
        background: rgba(145,175,207,.08);
        box-shadow: inset 0 0 0 1px rgba(157,186,234,.16);
        transform: none;
      }
      .articles-list :global(.blog-post-item)::before { display: none; }
      .articles-list :global(.blog-post-title) {
        font-size: 1.35rem;
        line-height: 1.4;
        margin: 0 0 .65rem;
        color: #f0f4fa;
      }
      /* Full-card article link, with independent clickable category tags. */
      .articles-list :global(.blog-post-title a)::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
      }
      .articles-list :global(.blog-post-tags) {
        position: relative;
        z-index: 2;
      }
      /* Homepage article title treatment: same underline animation and typography. */
      .articles-list :global(.blog-post-title) {
        font-size: 1.2em;
        font-weight: 600;
        margin: 0 0 0.5em 0;
      }
      .articles-list :global(.blog-post-title a) {
        display: inline;
        background-image: linear-gradient(var(--accent), var(--accent));
        background-position: 0% 100%;
        background-repeat: no-repeat;
        background-size: 0% 2px;
        transition: background-size 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.3s ease;
        padding-bottom: 2px;
      }
      .articles-list :global(.blog-post-item:hover .blog-post-title a) {
        color: var(--accent);
        background-size: 100% 2px;
      }
      .articles-list :global(.blog-post-meta) {
        display: flex;
        align-items: center;
        gap: 1em;
        font-size: 0.85em;
        flex-wrap: wrap;
      }
      .articles-list :global(.blog-post-meta-item) { display: flex; align-items: center; gap: .3em; padding: 0; }
      .articles-list :global(.blog-post-tags) { display: flex; flex-wrap: wrap; gap: .4em; }
      .articles-list :global(.blog-tag-link) {
        display: inline-flex;
        align-items: center;
        gap: .2em;
        padding: 2px 8px;
        text-decoration: none;
        border-radius: 4px;
        font-size: .85em;
        transition: background-color .3s cubic-bezier(.2,0,0,1), color .3s cubic-bezier(.2,0,0,1), transform .3s cubic-bezier(.2,0,0,1), box-shadow .3s cubic-bezier(.2,0,0,1);
        transform-origin: center;
      }
      .articles-list :global(.blog-tag-link:hover) { transform: translateY(-2px) scale(1.05); }
      .articles-list :global(.blog-tag-link:active) { transform: translateY(0) scale(.97); }
      .articles-list :global(.blog-post-excerpt) {
        color: #bfcbdc;
        font-size: .94rem;
        line-height: 1.75;
        margin: 0 0 .8rem;
      }
      .articles-list :global(.blog-post-meta) { color: #9eafc7; }
      .articles-list :global(.blog-tag-link) {
        background: rgba(145,175,207,.13);
        color: #b9d2f3;
      }
      @media (max-width: 720px) {
        .articles-area {
          background: linear-gradient(to bottom, transparent 56px, #171c25 56px);
          padding: 0 .8rem 3rem;
        }
        .articles-inner { padding: 1.25rem 1rem; }
        .articles-list :global(.blog-post-title) { font-size: 1.2em; }
      }
    </style>

  <section class="articles-area" aria-label={`${label}標籤列表`}>
    <div class="articles-inner">
      <InteriorHeading title={`#${tag}`} centered={true} animated={true} />
      <nav class="article-tags" aria-label={`${label}標籤`} data-tag-overflow>
        <div class="tag-visible" data-tag-visible>
        <a class="tag-filter all-tag" href={archiveUrl} data-astro-prefetch="viewport">
          全部{label} <span>{totalCount}</span>
        </a>
        {displayTags.map(([name, count]) => (
          <a
            class="tag-filter"
            href={pathForTag(name)}
            data-astro-prefetch="viewport"
            aria-current={name === tag ? 'page' : undefined}
          >
            <span class="tag-hash">#</span>{name}<span class="tag-count">{count}</span>
          </a>
        ))}
        </div>
          <a class="tag-all-link" href={isWork ? "/experience/tags/" : "/tags/"} data-astro-prefetch="viewport">所有標籤 <span aria-hidden="true">→</span></a>
      </nav>
      <div class="articles-list blog-posts-list" data-tag-pagination data-page-count={pageCount}>
        {visiblePosts.map((post, index) => (
          <div class="scroll-reveal" data-page-number={Math.floor(index / CONTENT_PAGE_SIZE) + 1} hidden={index >= CONTENT_PAGE_SIZE}>
            {post.data.pinned && <div class="pinned-mark" aria-label={`置頂${label}`}>📌 置頂</div>}
            <PostListItem
              post={post}
              hrefBase={hrefBase}
              workTags={isWork}
              titleTag="h2"
              articleClass="blog-post-item"
              titleClass="blog-post-title"
              excerptClass="blog-post-excerpt"
              showExcerpt={true}
              excerpt={post.data.description || extractExcerpt(post.body || '', 160)}
              metaContainerClass="blog-post-meta"
              metaItemClass="blog-post-meta-item"
              metaTagsClass="blog-post-tags"
              tagLinkClass="blog-tag-link hover-scale"
            />
          </div>
        ))}
      </div>
      {pageCount > 1 && (
        <nav class="pagination tag-pagination" aria-label={`${label}分頁`}>
          <a class="page-btn disabled" data-tag-nav="prev" aria-label="上一頁" aria-disabled="true">‹</a>
          <div class="page-numbers">
            {Array.from({ length: pageCount }, (_, i) => i + 1).map(number => (
              <a
                href={number === 1 ? pathForTag(tag) : `${pathForTag(tag)}?page=${number}`}
                class:list={['page-btn', { active: number === 1 }]}
                data-tag-page-link
                data-page-number={number}
                aria-current={number === 1 ? 'page' : undefined}
              >{number}</a>
            ))}
          </div>
          <a class="page-btn" data-tag-nav="next" href={`${pathForTag(tag)}?page=2`} aria-label="下一頁">›</a>
        </nav>
      )}
    </div>
  </section>
</PageShell>
