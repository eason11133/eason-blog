---
import { profileConfig } from '../config';
import { resolveSocialUrl } from '../lib/profile/social';

const year = new Date().getFullYear();
const socials = profileConfig.socials.filter((social) =>
  ['github', 'email', 'instagram', 'discord'].includes(social.key)
).map((social) => ({
  ...social,
  link: social.url.trim() && !social.url.includes('example.com')
    ? resolveSocialUrl(social.key, social.url)
    : '',
}));
---

<footer transition:animate="none">
  <div class="footer-line">
    <span class="copyright">&copy; {year} Eason</span>
    <nav class="social-links" aria-label="社群連結">
      {socials.map((social) => {
        const graphic = (
          <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {social.key === 'github' && (
              <path d="M9 19c-4.2 1.3-4.2-2.3-6-2.7M15 22v-3.6a3.1 3.1 0 0 0-.85-2.4c2.9-.32 5.95-1.4 5.95-6.5a5.05 5.05 0 0 0-1.35-3.5 4.65 4.65 0 0 0-.08-3.5S17.55 2.18 15 4a13 13 0 0 0-7 0C5.45 2.18 4.33 2.5 4.33 2.5a4.65 4.65 0 0 0-.08 3.5A5.05 5.05 0 0 0 2.9 9.5c0 5.1 3.05 6.18 5.95 6.5A3.1 3.1 0 0 0 8 18.4V22"/>
            )}
            {social.key === 'email' && (
              <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>
            )}
            {social.key === 'instagram' && (
              <><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></>
            )}
            {social.key === 'discord' && (
              <><path d="M7.5 5.5a14 14 0 0 1 9 0l1 2c1.7.5 3 1.3 4 2.5-.3 3.5-1.5 6.4-3.3 8.6-1.3.9-2.4 1.5-3.7 1.9l-.9-1.5m-3.2 0-.9 1.5c-1.3-.4-2.4-1-3.7-1.9C4 16.4 2.8 13.5 2.5 10c1-1.2 2.3-2 4-2.5l1-2Z"/><path d="M8.5 13h.01M15.5 13h.01" stroke-width="3.2"/></>
            )}
          </svg>
        );
        return social.link ? (
          <a class="social-item" href={social.link} aria-label={social.label} title={social.label} target={social.key === 'email' ? undefined : '_blank'} rel={social.key === 'email' ? undefined : 'noreferrer'}>{graphic}</a>
        ) : (
          <span class="social-item unavailable" aria-label={social.label + '（尚未設定連結）'} title={social.label + '（尚未設定連結）'}>{graphic}</span>
        );
      })}
    </nav>
  </div>
</footer>

<style>
  footer {
    padding: 1.4rem 1rem;
    background: #171c25;
    border-top: 1px solid rgba(166, 187, 226, .12);
    color: #aebbd0;
    text-align: center;
  }
  .footer-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.3rem;
    flex-wrap: wrap;
  }
  .copyright {
    font-size: .92rem;
    white-space: nowrap;
  }
  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .social-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #b9c9dc;
    transition: color .2s ease;
  }
  a.social-item:hover { color: #f3f7ff; }
  .social-item.unavailable { opacity: .57; cursor: default; }
  .social-icon { width: 21px; height: 21px; display: block; }
</style>
