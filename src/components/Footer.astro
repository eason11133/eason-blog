---
import { headerGithubRepoUrl, profileConfig } from '../config';
import { resolveSocialUrl } from '../lib/profile/social';

const year = new Date().getFullYear();
const socials = profileConfig.socials.map((social) => ({
  ...social,
  link: social.url.trim() && !social.url.includes('example.com') ? resolveSocialUrl(social.key, social.url) : '',
}));
---

<footer transition:animate="none">
  <div class="footer-line">
    <span class="copyright">&copy; {year} Eason</span>
    <nav class="social-links" aria-label="社群連結">
      {socials.map((social) => (
        social.link ? (
          <a href={social.link} target="_blank" rel="noreferrer">{social.label}</a>
        ) : (
          <span class="link-placeholder" title="尚未設定連結">{social.label}</span>
        )
      ))}
      {headerGithubRepoUrl && (
        <a href={headerGithubRepoUrl} target="_blank" rel="noreferrer">Repository</a>
      )}
    </nav>
  </div>
</footer>

<style>
  footer {
    padding: 1.65rem 1rem;
    background: #050608;
    border-top: 1px solid rgba(166, 187, 226, .10);
    color: var(--color-text-secondary);
    text-align: center;
  }
  .footer-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.15rem;
    flex-wrap: wrap;
  }
  .copyright {
    font-size: .92rem;
    white-space: nowrap;
  }
  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: .85rem;
  }
  .social-links a,
  .link-placeholder {
    color: var(--color-text-secondary);
    font-size: .92rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .social-links a {
    transition: color .2s ease;
  }
  .social-links a:hover {
    color: var(--color-text);
  }
  .link-placeholder {
    opacity: .62;
    cursor: default;
  }
</style>
