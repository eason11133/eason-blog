---
interface Props { kind: 'post' | 'work'; slug: string; }
const { kind, slug } = Astro.props;
---
<section class="site-comments" data-comments-kind={kind} data-comments-slug={slug} aria-labelledby="site-comments-title">
  <h2 id="site-comments-title">留言</h2>
  <div class="site-comments-list" aria-live="polite">正在讀取留言…</div>
  <div class="site-comment-login">
    <p>登入留言</p>
    <div class="site-login-actions">
      <a class="site-login-github" data-provider="github" href="/api/auth/github" aria-label="使用 GitHub 登入"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 .1.65 2.22 3.26 1.58.1-.73.39-1.23.71-1.51-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.09 1.15a10.7 10.7 0 0 1 5.62 0c2.14-1.45 3.08-1.15 3.08-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z"/></svg><span>GitHub</span></a>
      <a class="site-login-google" data-provider="google" href="/api/auth/google" aria-label="使用 Google 登入"><svg aria-hidden="true" viewBox="0 0 48 48" width="18" height="18"><path fill="#4285F4" d="M43.6 24.46c0-1.36-.12-2.66-.35-3.92H24v7.43h11a9.4 9.4 0 0 1-4.08 6.17v5h6.59c3.85-3.55 6.09-8.78 6.09-14.68Z"/><path fill="#34A853" d="M24 44c5.51 0 10.13-1.83 13.51-4.86l-6.59-5c-1.83 1.23-4.16 1.96-6.92 1.96-5.31 0-9.81-3.58-11.42-8.39H5.79v5.15A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.58 27.71a12 12 0 0 1 0-7.42v-5.15H5.79a20 20 0 0 0 0 17.72l6.79-5.15Z"/><path fill="#EA4335" d="M24 11.9c3 0 5.69 1.03 7.8 3.05l5.85-5.85C34.12 5.82 29.5 4 24 4A20 20 0 0 0 5.79 15.14l6.79 5.15C14.19 15.48 18.69 11.9 24 11.9Z"/></svg><span>Google</span></a>
    </div>
  </div>
  <div class="site-comment-account" hidden>
    <img class="site-comment-account-avatar" alt="" width="32" height="32" hidden />
    <span class="site-comment-account-name"></span>
    <button class="site-comment-logout" type="button">登出</button>
  </div>
  <form class="site-comments-form" hidden>
    <div class="site-comment-reply-target" hidden>
      <span class="site-comment-reply-label"></span>
      <button class="site-comment-reply-cancel" type="button">取消回覆</button>
    </div>
    <label for="site-comment-body">留言內容</label>
    <textarea id="site-comment-body" name="body" maxlength="1600" minlength="2" required rows="4" placeholder="寫下你的想法…"></textarea>
    <div class="site-comments-actions">
      <p>送出後立即公開。</p>
      <button type="submit">送出留言</button>
    </div>
    <p class="site-comments-status" role="status" aria-live="polite"></p>
  </form>
  <p class="site-comments-auth-status" role="status" aria-live="polite"></p>
</section>

<style>
.site-comments{width:min(100% - 40px,732px);margin:0 auto 7rem;padding:0 0 2rem;color:#e7effa}
.site-comments [hidden]{display:none!important}
.site-comments h2{font-size:1.4rem;color:#e7effa;font-weight:700;margin:0 0 1.25rem}
.site-comments-list{font-size:.95rem;color:#a7b9d3;margin:0 0 1.7rem}
/* Comment rows are created by client-side DOM calls, so their selectors
   must not require Astro's generated scope attribute. Scope to this list instead. */
.site-comments-list :global(.site-comment){border-bottom:1px solid rgba(158,186,221,.18);padding:1rem 0;min-width:0}
.site-comments-list :global(.site-comment.is-reply){margin-left:1.25rem;padding-left:1rem;border-left:2px solid rgba(158,186,221,.25)}
.site-comments-list :global(.site-comment-header){display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;color:#a7b9d3;font-size:.84rem}
.site-comments-list :global(.site-comment-header strong){color:#e7effa;overflow-wrap:anywhere;min-width:0}
.site-comments-list :global(.site-comment-header time){color:#a7b9d3;font-size:.8rem;white-space:nowrap}
.site-comments-list :global(.site-comment-avatar),.site-comment-account-avatar{display:block;box-sizing:border-box;width:32px;height:32px;min-width:32px;max-width:32px;flex:0 0 32px;object-fit:cover;border-radius:50%;border:1px solid rgba(158,186,221,.26)}
.site-comments-list :global(.site-comment-body){white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8;color:#e7effa;margin:.55rem 0}
.site-comments-list :global(.site-comment-children){margin-top:.5rem;min-width:0}
.site-comments-list :global(.site-comment-children > .site-comment:last-child){border-bottom:0}
.site-comment-login{display:flex;align-items:center;flex-wrap:wrap;gap:.8rem 1rem;margin-bottom:1.1rem}
.site-comment-login p{margin:0;color:#a7b9d3;font-size:.86rem}
.site-login-actions{display:flex;flex-wrap:wrap;gap:.45rem}
.site-login-actions a{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;font:inherit;font-size:.84rem;font-weight:550;text-decoration:none;border:0;border-radius:8px;padding:.48rem .65rem;background:transparent;color:#e7effa;cursor:pointer;transition:background .2s,color .2s}
.site-login-actions a svg{flex:none}
.site-login-actions a:hover,.site-login-actions a:focus-visible{background:rgba(158,186,221,.14);color:#fff}
.site-comments-actions button{display:inline-flex;align-items:center;justify-content:center;font:inherit;font-size:.9rem;text-decoration:none;border:1px solid rgba(158,186,221,.3);border-radius:9px;padding:.65rem 1.1rem;background:rgba(29,66,108,.42);color:#e7effa;cursor:pointer}
.site-comments-actions button:hover{background:rgba(55,96,140,.65)}
.site-comment-account{display:flex;align-items:center;gap:.65rem;margin-bottom:1rem;color:#e7effa}
.site-comment-logout,.site-comment-reply-cancel,.site-comments-list :global(.site-comment-reply-button){border:0;background:none;padding:.25rem;color:#a7b9d3;font:inherit;font-size:.8rem;cursor:pointer}
.site-comment-logout:hover,.site-comment-reply-cancel:hover,.site-comments-list :global(.site-comment-reply-button:hover){color:#fff;text-decoration:underline}
.site-comments-form{display:grid;gap:.8rem}
.site-comments-form label{font-size:.9rem;color:#bacde4}
.site-comments-form textarea{width:100%;box-sizing:border-box;border:1px solid rgba(158,186,221,.26);border-radius:10px;padding:.8rem .9rem;background:rgba(12,27,45,.44);color:#e7effa;font:inherit}
.site-comments-form textarea:focus-visible{outline:2px solid #b3d2f6;outline-offset:2px}
.site-comments-actions{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
.site-comments-actions p,.site-comments-status,.site-comments-auth-status{font-size:.82rem;color:#a7b9d3;margin:0}
.site-comments-actions button:disabled{opacity:.65;cursor:wait}
.site-comments-status:empty,.site-comments-auth-status:empty{display:none}
.site-comment-reply-target{display:flex;align-items:center;gap:.5rem;color:#a7b9d3;font-size:.84rem}
@media(max-width:600px){.site-comments-list :global(.site-comment.is-reply){margin-left:1rem;padding-left:.7rem}}
</style>

<script>
type CommentItem={id:string;parent_id:string|null;nickname:string;body:string;created:string;avatar_url?:string;auth_provider?:string};
type Visitor={name:string;avatar?:string;provider:string};
function attachComments() {
  const root=document.querySelector<HTMLElement>('.site-comments[data-comments-kind]')!;
  if(!root||root.dataset.bound==='true')return;
  root.dataset.bound='true';
  const kind=root.dataset.commentsKind,slug=root.dataset.commentsSlug;
  const list=root.querySelector<HTMLElement>('.site-comments-list')!;
  const form=root.querySelector<HTMLFormElement>('.site-comments-form')!;
  const status=root.querySelector<HTMLElement>('.site-comments-status')!;
  const authStatus=root.querySelector<HTMLElement>('.site-comments-auth-status')!;
  const login=root.querySelector<HTMLElement>('.site-comment-login')!;
  const account=root.querySelector<HTMLElement>('.site-comment-account')!;
  const name=root.querySelector<HTMLElement>('.site-comment-account-name')!;
  const accountAvatar=root.querySelector<HTMLImageElement>('.site-comment-account-avatar')!;
  const replyTarget=root.querySelector<HTMLElement>('.site-comment-reply-target')!;
  const replyLabel=root.querySelector<HTMLElement>('.site-comment-reply-label')!;
  const replyCancel=root.querySelector<HTMLButtonElement>('.site-comment-reply-cancel')!;
  if(!kind||!slug||!list||!form||!status||!authStatus||!login||!account||!name||!accountAvatar||!replyTarget||!replyLabel||!replyCancel)return;
  const endpoint='/api/comments?kind='+encodeURIComponent(kind)+'&slug='+encodeURIComponent(slug);
  let visitor:Visitor|null=null;
  let replyId:string|null=null;
  const heading=root.querySelector<HTMLElement>('#site-comments-title')!;
  function clearReply(){replyId=null;replyTarget.hidden=true;replyLabel.textContent='';}
  replyCancel.addEventListener('click',clearReply);
  async function loadComments(){
    try{
      const response=await fetch(endpoint,{headers:{Accept:'application/json'},cache:'no-store'});
      if(!response.ok)throw new Error('目前無法載入留言');
      const data=await response.json();
      const comments:CommentItem[]=Array.isArray(data.comments)?data.comments:[];
      list.replaceChildren();
      if(!comments.length){heading.textContent='留言';list.textContent='目前還沒有留言。';return;}
      heading.textContent='留言（'+comments.length+'）';
      const byId=new Map(comments.map(c=>[c.id,c]));
      const children=new Map<string,CommentItem[]>();
      for(const item of comments){
        if(item.parent_id && byId.has(item.parent_id)){
          const group=children.get(item.parent_id)||[];
          group.push(item);
          children.set(item.parent_id,group);
        }
      }
      const displayed=new Set<string>();
      function render(item:CommentItem,host:HTMLElement,depth=0){
        if(displayed.has(item.id))return;
        displayed.add(item.id);
        const entry=document.createElement('article');entry.className='site-comment';
        if(depth>0)entry.classList.add('is-reply');
        const header=document.createElement('div');header.className='site-comment-header';
        if(item.avatar_url){
          try{
            const url=new URL(item.avatar_url);
            if(url.protocol==='https:' && ['avatars.githubusercontent.com','lh3.googleusercontent.com','lh4.googleusercontent.com','lh5.googleusercontent.com','lh6.googleusercontent.com'].includes(url.hostname)){
              const avatar=document.createElement('img');avatar.className='site-comment-avatar';avatar.src=url.href;avatar.alt='';avatar.width=32;avatar.height=32;avatar.loading='lazy';header.append(avatar);
            }
          }catch{}
        }
        const author=document.createElement('strong');author.textContent=item.nickname||'訪客';
        const time=document.createElement('time');
        const timestamp=new Date(item.created);
        time.textContent=Number.isNaN(timestamp.valueOf())?'':timestamp.toLocaleDateString('zh-TW',{timeZone:'Asia/Taipei'});
        const body=document.createElement('p');body.className='site-comment-body';body.textContent=item.body||'';
        header.append(author,time);entry.append(header,body);
        const reply=document.createElement('button');
        reply.className='site-comment-reply-button';reply.type='button';reply.textContent='回覆';
        reply.addEventListener('click',()=>{
          if(!visitor){authStatus.textContent='請先登入才能回覆。';login.scrollIntoView({behavior:'smooth',block:'center'});return;}
          replyId=item.id;replyTarget.hidden=false;replyLabel.textContent='回覆 '+item.nickname;
          form.querySelector<HTMLTextAreaElement>('textarea')?.focus();
        });
        entry.append(reply);host.append(entry);
        const replies=children.get(item.id);
        if(replies?.length){
          const nested=document.createElement('div');nested.className='site-comment-children';
          for(const child of replies)render(child,nested,depth+1);
          entry.append(nested);
        }
      }
      for(const item of comments){
        if(!item.parent_id || !byId.has(item.parent_id))render(item,list);
      }
      for(const item of comments){
        if(!displayed.has(item.id))render(item,list);
      }
    }catch(e){list.textContent=e instanceof Error?e.message:'無法載入留言';}
  }
  async function loadUser(){
    try{
      const response=await fetch('/api/auth/me',{cache:'no-store'});
      if(!response.ok)throw Error('登入服務暫時無法使用');
      const data=await response.json();
      visitor=data.user||null;
      login.hidden=!!visitor || (data.providers?.github===false && data.providers?.google===false);
      account.hidden=!visitor;form.hidden=!visitor;
      if(visitor){
        name.textContent=visitor.name;
        if(visitor.avatar){accountAvatar.src=visitor.avatar;accountAvatar.hidden=false;}
        else{accountAvatar.hidden=true;}
      }else{
        for(const provider of ['github','google']){
          const a=root.querySelector<HTMLAnchorElement>('[data-provider="'+provider+'"]');
          if(!a)continue;
          a.hidden=data.providers?.[provider]===false;
          a.href='/api/auth/'+provider+'?return='+encodeURIComponent(location.pathname);
        }
        if(data.providers?.github===false&&data.providers?.google===false)authStatus.textContent='留言功能已準備好，正式網址及登入授權設定後開放。';
      }
    }catch(e){login.hidden=true;account.hidden=true;form.hidden=true;authStatus.textContent=e instanceof Error?e.message:'登入服務無法使用';}
  }
  root.querySelector<HTMLButtonElement>('.site-comment-logout')?.addEventListener('click',async()=>{
    try{
      const response=await fetch('/api/auth/logout',{method:'POST',headers:{Origin:location.origin}});
      if(!response.ok)throw Error('登出失敗');
      visitor=null;clearReply();authStatus.textContent='';await loadUser();
    }catch(e){authStatus.textContent=e instanceof Error?e.message:'登出失敗';}
  });
  form.addEventListener('submit',async event=>{
    event.preventDefault();
    const button=form.querySelector<HTMLButtonElement>('button[type=submit]');
    if(!button)return;
    const data=new FormData(form),body=String(data.get('body')||'').trim();
    if(body.length<2){status.textContent='請填寫留言內容。';return;}
    button.disabled=true;status.textContent='';
    try{
      const response=await fetch('/api/comments',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({kind,slug,body,parent_id:replyId})});
      const result=await response.json();
      if(!response.ok)throw new Error(result.error||'送出失敗');
      form.reset();clearReply();status.textContent='留言已公開。';
      await loadComments();
    }catch(e){status.textContent=e instanceof Error?e.message:'送出失敗';}
    finally{button.disabled=false;}
  });
  const authResult=new URLSearchParams(location.search).get('comment_auth');
  if(authResult==='cancelled')authStatus.textContent='你已取消登入。';
  if(authResult==='failed')authStatus.textContent='登入未完成，請再試一次。';
  loadComments();loadUser();
}
attachComments();
document.addEventListener('astro:page-load',attachComments);
</script>
