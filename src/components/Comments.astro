---
interface Props { kind: 'post' | 'work'; slug: string; }
const { kind, slug } = Astro.props;
---
<section class="site-comments" data-comments-kind={kind} data-comments-slug={slug} aria-labelledby="site-comments-title">
  <h2 id="site-comments-title">留言</h2>
  <div class="site-comments-list" aria-live="polite">正在讀取留言…</div>
  <form class="site-comments-form">
    <label>暱稱（公開顯示）<input name="nickname" maxlength="60" required autocomplete="nickname" placeholder="你想使用的名字" /></label>
    <label>留言內容<textarea name="body" maxlength="1600" minlength="2" required rows="4" placeholder="寫下你的想法…"></textarea></label>
    <div class="site-comments-actions">
      <p>留言送出後需經過審核才會公開。</p>
      <button type="submit">送出留言</button>
    </div>
    <p class="site-comments-status" role="status" aria-live="polite"></p>
  </form>
</section>

<style>
.site-comments{width:min(100% - 40px,900px);margin:0 auto 7rem;padding:0 0 2rem;color:#e7effa}
.site-comments h2{font-size:1.4rem;color:#e7effa;font-weight:700;margin:0 0 1.25rem}
.site-comments-list{font-size:.95rem;color:#a7b9d3;margin:0 0 2rem}
.site-comment{border-bottom:1px solid rgba(158,186,221,.18);padding:.95rem 0}
.site-comment-header{display:flex;flex-wrap:wrap;align-items:center;gap:.9rem;color:#a7b9d3;font-size:.84rem}
.site-comment-header strong{color:#e7effa}
.site-comment-body{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8;color:#e7effa;margin:.55rem 0 0}
.site-comments-form{display:grid;gap:1rem}
.site-comments-form label{display:grid;gap:.45rem;font-size:.9rem;color:#bacde4}
.site-comments-form input,.site-comments-form textarea{width:100%;box-sizing:border-box;border:1px solid rgba(158,186,221,.26);border-radius:10px;padding:.8rem .9rem;background:rgba(12,27,45,.44);color:#e7effa;font:inherit}
.site-comments-form :is(input,textarea):focus-visible{outline:2px solid #b3d2f6;outline-offset:2px}
.site-comments-actions{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
.site-comments-actions p,.site-comments-status{font-size:.82rem;color:#a7b9d3;margin:0}
.site-comments-actions button{font:inherit;font-size:.9rem;border:1px solid rgba(158,186,221,.3);border-radius:9px;padding:.65rem 1.1rem;background:rgba(29,66,108,.42);color:#e7effa;cursor:pointer}
.site-comments-actions button:hover{background:rgba(55,96,140,.65)}
.site-comments-actions button:disabled{opacity:.65;cursor:wait}
.site-comments-status:empty{display:none}
</style>

<script>
function attachComments() {
  const root = document.querySelector<HTMLElement>('.site-comments[data-comments-kind]');
  if (!root || root.dataset.bound === 'true') return;
  root.dataset.bound = 'true';
  const kind = root.dataset.commentsKind;
  const slug = root.dataset.commentsSlug;
  const list = root.querySelector<HTMLElement>('.site-comments-list');
  const form = root.querySelector<HTMLFormElement>('.site-comments-form');
  const status = root.querySelector<HTMLElement>('.site-comments-status');
  if (!kind || !slug || !list || !form || !status) return;
  const endpoint = '/api/comments?kind=' + encodeURIComponent(kind) + '&slug=' + encodeURIComponent(slug);
  fetch(endpoint,{headers:{Accept:'application/json'},cache:'no-store'})
    .then(async (response)=>{ if(!response.ok)throw new Error('目前無法載入留言'); return response.json(); })
    .then((payload)=>{
      list.replaceChildren();
      const comments = Array.isArray(payload.comments) ? payload.comments : [];
      if (!comments.length) { list.textContent='目前還沒有留言。'; return; }
      for (const item of comments) {
        const entry = document.createElement('article'); entry.className='site-comment';
        const header = document.createElement('div');header.className='site-comment-header';
        const author = document.createElement('strong');author.textContent=item.nickname||'訪客';
        const time = document.createElement('time');
        const timestamp = new Date(item.created);
        time.textContent = Number.isNaN(timestamp.valueOf()) ? '' : timestamp.toLocaleDateString('zh-TW');
        const body = document.createElement('p');body.className='site-comment-body';body.textContent=item.body||'';
        header.append(author,time);entry.append(header,body);list.append(entry);
      }
    })
    .catch((error)=>{list.textContent=error instanceof Error?error.message:'無法載入留言';});
  form.addEventListener('submit',async (event)=>{
    event.preventDefault();
    const button=form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (!button) return;
    const data=new FormData(form);
    const nickname=String(data.get('nickname')||'').trim(), body=String(data.get('body')||'').trim();
    if (!nickname || body.length<2) {status.textContent='請填寫暱稱和留言。';return;}
    button.disabled=true;status.textContent='';
    try {
      const response=await fetch('/api/comments',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({kind,slug,nickname,body})});
      const result=await response.json();
      if (!response.ok) throw new Error(result.error || '送出失敗');
      status.textContent='送出成功，審核通過後才會公開。';
      form.reset();
    } catch (error) {status.textContent=error instanceof Error?error.message:'送出失敗';}
    finally {button.disabled=false;}
  });
}
attachComments();
document.addEventListener('astro:page-load',attachComments);
</script>
