---
import Typewriter from './Typewriter.astro';

interface Props {
	number?: string;
	title: string;
	intro?: string;
	typewriter?: boolean;
	headerClass?: string;
	numberClass?: string;
	titleClass?: string;
	introClass?: string;
}

const {
	number,
	title,
	intro,
	typewriter = false,
	headerClass = 'section-header',
	numberClass = 'section-number',
	titleClass = 'section-title',
	introClass = 'intro-text',
} = Astro.props;
---

<div class={headerClass}>
	{number && <span class={numberClass}>{number}</span>}
</div>
{typewriter ? <Typewriter text={title} tag="h2" class={titleClass} /> : <h2 class={titleClass}>{title}</h2>}
{intro && <p class={introClass}>{intro}</p>}

