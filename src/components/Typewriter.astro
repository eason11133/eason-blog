---
interface Props {
    text: string;
    tag?: 'h1' | 'h2' | 'h3' | 'span';
    class?: string;
    id?: string;
    disappearAfterTyping?: boolean;
}

const { text, tag = 'h1', class: className = '', id, disappearAfterTyping = false } = Astro.props;
const Tag = tag;
const elementId = id || `typewriter-${Math.random().toString(36).substring(7)}`;
---

<Tag class:list={['typewriter', className]} id={elementId} data-text={text} data-disappear-after-typing={disappearAfterTyping ? "true" : undefined}>
    <span class="typewriter-reserve" aria-hidden="true">{text}</span>
    <span class="typewriter-animation"><span class="typed-text">{text}</span><span class="cursor" aria-hidden="true">_</span></span>
</Tag>

<style>
    .typewriter {
        display: inline-grid;
        max-width: 100%;
        vertical-align: baseline;
    }
    .typewriter-reserve, .typewriter-animation {
        grid-area: 1 / 1;
        white-space: pre-wrap;
    }
    .typewriter-reserve {
        visibility: hidden;
        pointer-events: none;
    }

    .typewriter[data-disappear-after-typing="true"] {
        transition: opacity 0.8s ease-out;
    }

    .typewriter[data-disappear-after-typing="true"].typewriter-faded {
        opacity: 0;
    }

    .typed-text {
        white-space: pre-wrap;
        color: inherit;
    }

    .cursor {
        display: inline-block;
        margin-left: 2px;
        font-weight: 700;
        color: inherit;
        animation: blink 1s step-end infinite;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
</style>

<script>
    // Re-initialize after Astro page transitions and clean up old observers/timers.
    let cleanups: Array<() => void> = [];
    let firstPageLoad = true;

    document.addEventListener('astro:page-load', () => {
        // Only the first document load types text. Navigation retains SSR text.
        const shouldAnimate = firstPageLoad && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        firstPageLoad = false;
        cleanups.forEach((cleanup) => cleanup());
        cleanups = [];

        document.querySelectorAll<HTMLElement>('.typewriter[data-text]').forEach((element) => {
            const fullText = element.dataset.text || '';
            const typedText = element.querySelector<HTMLElement>('.typed-text');
            if (!typedText || !fullText) return;

            const autoFade = element.dataset.disappearAfterTyping === 'true';
            const timers = new Set<ReturnType<typeof setTimeout>>();
            let disposed = false;
            let generation = 0;

            function schedule(callback: () => void, delay: number) {
                const timer = setTimeout(() => {
                    timers.delete(timer);
                    if (!disposed) callback();
                }, delay);
                timers.add(timer);
            }

            function replay() {
                generation++;
                const currentGeneration = generation;
                timers.forEach(clearTimeout);
                timers.clear();
                element.classList.remove('typewriter-faded');
                typedText!.textContent = '';

                let index = 0;
                function typeNext() {
                    if (currentGeneration !== generation) return;
                    if (index < fullText.length) {
                        typedText!.textContent += fullText.charAt(index++);
                        schedule(typeNext, Math.floor(Math.random() * 100) + 50);
                    } else if (autoFade) {
                        schedule(() => {
                            if (currentGeneration === generation) {
                                element.classList.add('typewriter-faded');
                            }
                        }, 1200);
                    }
                }
                schedule(typeNext, 300);
            }

            if (shouldAnimate) replay();
            else typedText.textContent = fullText;

            // Only re-arm after the visitor genuinely leaves the cover.
            // The main-content div is ulBo's actual scrolling container.
            let observer: IntersectionObserver | undefined;
            if (autoFade) {
                const hero = element.closest('.hero-header');
                const scrollContainer = document.querySelector('#main-content');
                if (hero && scrollContainer) {
                    let leftCover = false;
                    observer = new IntersectionObserver((entries) => {
                        const ratio = entries[0]?.intersectionRatio ?? 0;
                        if (ratio <= 0.25) {
                            leftCover = true;
                        } else if (ratio >= 0.65 && leftCover) {
                            leftCover = false;
                            replay();
                        }
                    }, {
                        root: scrollContainer,
                        threshold: [0, 0.25, 0.65, 1],
                    });
                    observer.observe(hero);
                }
            }

            cleanups.push(() => {
                disposed = true;
                generation++;
                observer?.disconnect();
                timers.forEach(clearTimeout);
                timers.clear();
            });
        });
    });
</script>
