---
import Typewriter from './Typewriter.astro';
import type { ImageMetadata } from 'astro';
import { heroConfig } from '../config';

interface Props {
    text: string;
    subtitle?: string;
    backgroundImage?: string | ImageMetadata;
    compact?: boolean;
    interactive?: boolean; // 是否启用悬停交互效果（仅主页）
    cutoutImage?: string;
}

const { 
    text, 
    subtitle, 
    backgroundImage = heroConfig.postDefaultBackground,
    compact = false,
    interactive = false,
    cutoutImage
} = Astro.props;
const backgroundImageSrc =
    typeof backgroundImage === 'string' ? backgroundImage : backgroundImage.src;

let heroClass = compact ? 'hero-header hero-compact' : 'hero-header';
if (interactive) heroClass += ' hero-interactive';
if (cutoutImage) heroClass += ' hero-cutout-mode';
---

<div class={heroClass} transition:name="hero">
    {cutoutImage ? (
        <img class="hero-cutout" src={cutoutImage} alt="Stephen Curry 背影" />
    ) : (
        <div class="hero-bg" style={`background-image: url('${backgroundImageSrc}')`}></div>
    )}
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <Typewriter text={text} tag="h1" class="hero-title" />
        {subtitle && <p class="hero-subtitle">{subtitle}</p>}
        <slot />
    </div>
    {!compact && (
        <div class="scroll-down">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
            </svg>
        </div>
    )}
</div>

<style>
    .hero-header {
        position: relative;
        width: 100%;
        height: 100vh;
        height: 100dvh;
        min-height: 520px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        overflow: hidden; /* Ensure background doesn't overflow */
    }

    /* New background element for zoom effect */
    .hero-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        z-index: 0;
        transition: transform 10s ease-out; /* Slow initial movement if needed, or just prepare for hover */
        transition: transform 0.8s var(--ease-out-expo);
    }

    /* Show the start of the articles without requiring an initial scroll. */
    .hero-header.hero-interactive {
        height: 78vh;
        height: 78dvh;
        min-height: 540px;
    }

    /* Eason homepage portrait cover: prioritize Curry's jersey and number 30. */
    .hero-header.hero-interactive .hero-bg {
        background-position: center 68%;
        transform: scale(1.08);
    }

    /* Use the uploaded transparent Curry PNG on top of the shared galaxy photo. */
    .hero-cutout-mode {
        background: transparent;
    }

    .hero-cutout {
        position: absolute;
        z-index: 1;
        bottom: -17%;
        left: 50%;
        transform: translateX(-50%);
        height: 112%;
        width: auto;
        max-width: none;
        object-fit: contain;
        object-position: center bottom;
        filter: brightness(.72) contrast(1.07) drop-shadow(0 28px 35px rgba(0,0,0,.48));
        pointer-events: none;
        transition: filter .35s ease;
    }

    .hero-cutout-mode .hero-overlay {
        background: linear-gradient(to bottom,
            rgba(2,5,17,.23) 0%,
            rgba(2,4,14,.10) 46%,
            rgba(3,4,12,.38) 80%,
            rgba(4,6,14,.80) 100%);
        pointer-events: none;
        z-index: 2;
    }

    .hero-header.hero-interactive.hero-cutout-mode .hero-overlay {
        background: linear-gradient(to bottom,
            rgba(2,5,17,.25) 0%,
            rgba(3,5,15,.10) 46%,
            rgba(4,6,17,.32) 79%,
            rgba(4,5,13,.66) 100%);
    }

    /* Homepage greeting below the top-left logo, clear of Curry's silhouette. */
    .hero-header.hero-interactive .hero-content {
        position: absolute;
        top: clamp(100px, 14vh, 150px);
        left: calc(clamp(22px, 4vw, 62px) + 25px);
        transform: none;
        text-align: left;
        width: max-content;
        max-width: calc(100% - 2rem);
        padding: 0;
    }

    .hero-header.hero-compact {
        height: 60vh;
        height: 60dvh;
        min-height: 360px;
        margin-bottom: -88px;
    }

    /* compact 模式下背景层保持与主页一致的 100vh 高度，
       使 cover 按高度约束图片，调整窗口宽度时只裁切而不缩放 */
    .hero-header.hero-compact .hero-bg {
        height: 100vh;
        height: 100dvh;
        top: 50%;
        transform: translateY(-50%);
    }
    
    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        z-index: 1; /* Above bg, below content */
        transition: opacity 0.8s var(--ease-out-expo);
    }

    /* Homepage only: fade the cover into the slate-blue page background. */
    .hero-header.hero-interactive .hero-overlay {
        background: linear-gradient(
            to bottom,
            rgba(16, 23, 31, 0.38) 0%,
            rgba(22, 29, 37, 0.32) 45%,
            rgba(29, 36, 45, 0.68) 77%,
            rgba(5, 6, 8, 0.98) 100%
        );
    }

    .hero-content {
        position: relative;
        z-index: 10;
        text-align: center;
        padding: 2em; /* Increase padding area slightly for easier targeting */
        cursor: default; /* Indicate this area is special */
    }
    
    .hero-title {
        font-size: clamp(2rem, 4.5vw, 2.5rem);
        font-weight: 700;
        text-shadow: 0 2px 4px rgba(255, 255, 255, 0.3);
        line-height: 1.4;
        color: white;
    }

    .hero-subtitle {
        font-size: 1.2em;
        opacity: 0; /* Start hidden */
        margin-top: 0.5em;
        color: white;
        animation: fade-in-up 1s ease-out forwards;
        animation-delay: 2.5s; /* Wait for typewriter to mostly finish */
    }

    @keyframes fade-in-up {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 0.9; transform: translateY(0); }
    }

    /* Bouncing Arrow */
    .scroll-down {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        color: white;
        animation: bounce 2s infinite;
        cursor: pointer;
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateX(-50%) translateY(0);
        }
        40% {
            transform: translateX(-50%) translateY(-10px);
        }
        60% {
            transform: translateX(-50%) translateY(-5px);
        }
    }

    @media (hover: hover) and (pointer: fine) {
        /* 仅在 .hero-interactive 类存在且为桌面指针时启用悬停效果 */
        .hero-header.hero-interactive:has(.hero-content:hover) .hero-bg {
            transform: scale(1.12);
        }

        .hero-header.hero-interactive:has(.hero-content:hover) .hero-overlay {
            opacity: 0.9;
        }
    }
    
    @media (max-width: 720px) {
        .hero-cutout {
            height: 96%;
            bottom: -10%;
        }


        .hero-header.hero-interactive .hero-content {
            top: 108px;
            left: 47px;
            transform: none;
            max-width: calc(100% - 69px);
            padding: 0;
            text-align: left;
        }

        .hero-header.hero-interactive {
            height: 80vh;
            height: 80dvh;
            min-height: 460px;
        }

        .hero-header.hero-interactive .hero-bg {
            background-position: center 72%;
            transform: scale(1.12);
        }

        .hero-header {
            min-height: 460px;
        }

        .hero-header.hero-compact {
            height: 52vh;
            height: 52dvh;
            min-height: 260px;
            margin-bottom: -56px;
        }

        .hero-content {
            padding: 1.25em;
        }

        .hero-title {
            font-size: clamp(1.3rem, 6vw, 1.75rem);
            line-height: 1.35;
        }

        .hero-subtitle {
            font-size: 1rem;
        }
    }
</style>
