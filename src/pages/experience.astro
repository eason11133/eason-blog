---
import InteriorHeading from '../components/InteriorHeading.astro';
import PageShell from '../layouts/PageShell.astro';
import { siteTitle } from '../config';
---

<PageShell
  title={`作品與經歷 | ${siteTitle}`}
  description="作品與經歷，內容整理中。"
  transparentHeader={false}
  pageId="experience"
>
  <section class="experience-page">
    <div class="interior-body">
      <InteriorHeading title="作品與經歷" eyebrow="WORK & EXPERIENCE" />
      <div class="experience-body">
        <p>這個頁面還在整理中，之後會慢慢放上做過的作品和經歷。</p>
        <a href="/">返回首頁 ↗</a>
      </div>
    </div>
  </section>
</PageShell>
