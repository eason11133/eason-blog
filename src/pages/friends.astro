---
import PageShell from '../layouts/PageShell.astro';
import InteriorHeading from '../components/InteriorHeading.astro';
import { siteTitle } from '../config';
import { getCmsFriends, type CmsFriendSite } from '../lib/cloudflare/live-content';

export const prerender = import.meta.env.PUBLIC_EASON_LIVE !== 'true';
const live = import.meta.env.PUBLIC_EASON_LIVE === 'true';
const sites: CmsFriendSite[] = live ? await getCmsFriends() : [];
const hostname = (url: string) => {
  try { return new URL(url).hostname.replace(/^www\./, ''); }
  catch { return ''; }
};
---

<PageShell
  title={'友站 | ' + siteTitle}
  description="Eason 的友站連結。"
  transparentHeader={false}
  useMainWrapper={false}
  pageId="friends"
>
  <main class="friends-page">
    <div class="friends-inner">
      <InteriorHeading title="友站" centered={true} animated={true} />
      {sites.length > 0 ? (
        <div class="friends-grid" aria-label="友站列表">
          {sites.map(site => (
            <a class="friend-item" href={site.url} target="_blank" rel="noopener noreferrer">
              <span class="friend-title">{site.name}<span aria-hidden="true" class="external-mark">↗</span></span>
              {site.description && <span class="friend-description">{site.description}</span>}
              <span class="friend-domain">{hostname(site.url)}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="friends-empty">目前還沒有友站。</p>
      )}
    </div>
  </main>
</PageShell>

<style>
  .friends-page {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: calc(100dvh - 64px);
    box-sizing: border-box;
    padding: clamp(108px, 15vh, 150px) clamp(20px, 4vw, 48px) 90px;
    background: transparent;
  }
  .friends-inner { width: min(100%, 1000px); margin: 0 auto; }
  .friends-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 56px 0 0;
  }
  .friend-item {
    display: flex;
    min-width: 0;
    min-height: 145px;
    flex-direction: column;
    gap: 12px;
    justify-content: space-between;
    position: relative;
    padding: 20px 22px;
    color: #edf3fc;
    text-decoration: none;
    border: 0;
    border-radius: 12px;
    background: transparent;
    transition: transform .25s ease, background-color .25s ease;
  }
  .friend-item:hover, .friend-item:focus-visible {
    transform: translateY(-4px);
    background: rgba(55, 100, 155, .13);
  }
  .friend-title {
    display: flex; align-items: center; gap: .6rem;
    font-size: 1.35rem; font-weight: 700; overflow-wrap: anywhere;
  }
  .external-mark { font-size: 1rem; font-weight: 400; color: #9cbce2; }
  .friend-description { color: #b7c8df; line-height: 1.8; overflow-wrap: anywhere; }
  .friend-domain { color: #97abc9; font-size: .82rem; overflow-wrap: anywhere; }
  .friends-empty { color: #a7b9d3; margin: 56px 0 0; text-align: center; }
  @media (max-width: 720px) {
    .friends-grid { grid-template-columns: 1fr; gap: 12px; margin-top: 36px; }
    .friend-item { min-height: 120px; padding: 15px 8px; }
    .friends-empty { margin-top: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .friend-item { transition: none; } }
</style>
