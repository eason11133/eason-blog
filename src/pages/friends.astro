---
import PageShell from '../layouts/PageShell.astro';
import InteriorHeading from '../components/InteriorHeading.astro';
import { siteTitle } from '../config';
import { getCmsFriends, LIVE_CMS_ORIGIN, type CmsFriendSite } from '../lib/cloudflare/live-content';

export const prerender = import.meta.env.PUBLIC_EASON_LIVE !== 'true';
const live = import.meta.env.PUBLIC_EASON_LIVE === 'true';
const sites: CmsFriendSite[] = live ? await getCmsFriends() : [];
const avatarUrl = (avatar?: string) => typeof avatar === 'string' && /^\/media\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(avatar) ? LIVE_CMS_ORIGIN + avatar : '';
---

<PageShell
  title={'友站 | ' + siteTitle}
  description="Eason 的友站連結。"
  transparentHeader={false}
  useMainWrapper={false}
  pageId="friends"
>
  <main class="friends-page">
    <div class="friends-inner">
      <InteriorHeading title="友站" centered={true} animated={true} />
      {live && <div class="friend-apply-link"><a href="#friend-apply">申請友站 →</a></div>}
      {sites.length > 0 ? (
        <div class="friends-grid" aria-label="友站列表">
          {sites.map(site => (
            <a class="friend-item" href={site.url} target="_blank" rel="noopener noreferrer">
              <span class="friend-avatar" aria-hidden="true">
                <span>{Array.from(site.name.trim())[0] || '?'}</span>
                {avatarUrl(site.avatar) && <img src={avatarUrl(site.avatar)} alt="" width="72" height="72" loading="lazy" decoding="async" />}
              </span>
              <span class="friend-text">
                <span class="friend-title">{site.name}</span>
                {site.description && <span class="friend-description">{site.description}</span>}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="friends-empty">目前還沒有友站。</p>
      )}
      {live && (
        <section id="friend-apply" class="friend-apply">
          <h2>申請友站</h2>
          <p>有自己的網站或部落格，歡迎來交換友站！送出後由我審核，不用登入，也不強制回加本站。</p>
          <details class="friend-info"><summary>本站資訊</summary><p>網站名稱：{siteTitle}<br />網址：<a href={Astro.url.origin}>{Astro.url.origin}</a></p></details>
          <form id="friend-request-form" method="post" action="/api/friend-requests">
            <label>網站名稱<input name="name" required maxlength="100" placeholder="你的網站名稱" /></label>
            <label>網站網址<input name="url" type="url" required maxlength="1500" placeholder="https://..." /></label>
            <label>簡短介紹<textarea name="description" rows="3" required maxlength="300" placeholder="介紹一下你的網站"></textarea></label>
            <label>聯絡方式（不公開）<input name="contact" required maxlength="300" placeholder="Email、IG 或其他聯絡方式" /></label>
            <div class="friend-honeypot" aria-hidden="true"><label>請勿填寫<input name="website_check" tabindex="-1" autocomplete="off" /></label></div>
            <button type="submit">送出申請</button>
            <p class="friend-form-status" role="status" aria-live="polite"></p>
          </form>
        </section>
      )}
    </div>
  </main>
</PageShell>

<style>
  .friends-page {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 0;
    box-sizing: border-box;
    padding: clamp(108px, 15vh, 150px) clamp(20px, 4vw, 48px) 32px;
    background: transparent;
  }
  .friends-inner { width: min(100%, 1000px); margin: 0 auto; }
  .friends-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(20px, 5vw, 64px);
    row-gap: 36px;
    margin: 48px 0 0;
  }
  .friend-item {
    display: flex; min-width: 0; min-height: 112px; align-items: center;
    gap: 18px; padding: 18px 20px; color: #edf3fc; text-decoration: none;
    border: 0; border-radius: 12px; background: transparent;
    transition: transform .25s ease, background-color .25s ease;
  }
  .friend-item:hover, .friend-item:focus-visible { transform: translateY(-4px); background: rgba(55, 100, 155, .13); }
  .friend-avatar {
    position: relative; flex: 0 0 72px; width: 72px; height: 72px;
    display: grid; place-items: center; overflow: hidden; border-radius: 50%;
    background: #26374c; color: #e4edfb; font-size: 1.6rem; font-weight: 700;
  }
  .friend-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; background: #26374c; }
  .friend-avatar img[hidden] { display: none; }
  .friend-text { min-width: 0; display: flex; flex-direction: column; gap: 5px; }
  .friend-title { font-size: 1.25rem; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
  .friend-description { color: #b7c8df; line-height: 1.6; overflow-wrap: anywhere; }
  .friends-empty { color: #a7b9d3; margin: 56px 0 0; text-align: center; }
  @media (max-width: 720px) {
    .friends-grid { grid-template-columns: 1fr; row-gap: 16px; margin-top: 36px; }
    .friend-item { min-height: 96px; padding: 12px 8px; gap: 14px; }
    .friend-avatar { flex-basis: 60px; width: 60px; height: 60px; }
    .friends-empty { margin-top: 36px; }
  }
  .friend-apply-link { text-align:right; margin: 18px 0 0; }
  .friend-apply-link a,.friend-info a { color:#a9c5e8; text-decoration:none; }
  .friend-apply-link a:hover,.friend-info a:hover { text-decoration:underline; }
  .friend-apply { max-width: 660px; margin: 44px auto 0; padding: 24px 0 0; border-top: 1px solid rgba(158,186,221,.2); scroll-margin-top: 92px; }
  .friend-apply h2 { font-size:1.4rem; margin:0 0 .8rem; }
  .friend-apply p { color:#b7c8df; line-height:1.7; }
  .friend-info { margin: 0 0 18px; color:#a9bbd3; }
  .friend-info summary { cursor:pointer; }
  .friend-info p { overflow-wrap:anywhere; margin:10px 0 0; }
  #friend-request-form { display:grid; gap:14px; }
  #friend-request-form label { display:grid; gap:6px; color:#c6d4e7; font-size:.9rem; }
  #friend-request-form input,#friend-request-form textarea { box-sizing:border-box; width:100%; min-width:0; background:rgba(12,27,45,.44); border:1px solid rgba(158,186,221,.26); border-radius:9px; color:#e7effa; padding:.7rem .85rem; font:inherit; }
  #friend-request-form textarea { resize:vertical; }
  #friend-request-form button { justify-self:start; cursor:pointer; font:inherit; color:#e7effa; background:var(--color-tag-bg); border:1px solid var(--color-border-subtle); padding:.55rem 1rem; border-radius:9px; }
  #friend-request-form button:hover { background:var(--accent); color:white; }
  #friend-request-form button:disabled { opacity:.6; cursor:wait; }
  #friend-request-form :is(input,textarea,button):focus-visible { outline:2px solid #a9c5e8; outline-offset:2px; }
  .friend-honeypot { position:absolute; left:-10000px; width:1px; height:1px; overflow:hidden; }
  .friend-form-status { margin:0; }
  .friend-form-status:empty { display:none; }
  :global(body[data-page-id="friends"] #main-content) { display:flex; flex-direction:column; }
  :global(body[data-page-id="friends"] #main-content > .friends-page) { flex:0 0 auto; }
  :global(body[data-page-id="friends"] #main-content > footer) { margin-top:auto; flex-shrink:0; }
  @media (prefers-reduced-motion: reduce) { .friend-item { transition: none; } }
</style>
