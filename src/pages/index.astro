---
import HeroHeader from '../components/HeroHeader.astro';
import PageShell from '../layouts/PageShell.astro';
import { heroConfig, locale, siteDescription, siteTitle } from '../config';

const siteURL = Astro.site ?? Astro.url;
const homeHero = heroConfig.home;
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', siteURL).toString(),
  url: new URL('/', siteURL).toString(),
  name: siteTitle,
  description: siteDescription,
  inLanguage: locale,
};
---

<PageShell
  title={siteTitle}
  description={siteDescription}
  schema={webSiteSchema}
  transparentHeader={true}
  pageId="home"
>
  <HeroHeader
    text={homeHero.text}
    subtitle={homeHero.subtitle}
    backgroundImage={homeHero.backgroundImage}
    interactive={true}
  />

  <section class="journal-section" aria-labelledby="journal-heading">
    <div class="journal-glow" aria-hidden="true"></div>
    <div class="journal-inner">
      <div class="journal-intro">
        <span class="journal-eyebrow"><span class="eyebrow-line"></span> EASON'S JOURNAL <span class="journal-index">/ 01</span></span>
        <p class="journal-lead">一些經歷，一些紀錄。</p>
      </div>

      <div class="journal-feature">
        <div class="journal-art" aria-hidden="true">
          <span class="art-orbit art-orbit-one"></span>
          <span class="art-orbit art-orbit-two"></span>
          <span class="art-monogram">E.</span>
          <span class="art-label">SPECIAL ADMISSION<br />JOURNAL</span>
          <span class="art-number">01 / JOURNAL</span>
        </div>
        <div class="journal-copy">
          <div class="journal-copy-label"><span class="label-dot"></span> FEATURED STORY</div>
          <h2 id="journal-heading">特選心得</h2>
          <p class="journal-english">Special Admission Journal</p>
          <p class="journal-description">準備特殊選才、面試和上機考的紀錄。這篇文章還在整理，之後會放在這裡。</p>
          <span class="journal-status">文章整理中 <span aria-hidden="true">↗</span></span>
        </div>
      </div>

      <div class="journal-footer" aria-hidden="true">
        <span>PERSONAL NOTES</span>
        <span class="footer-rule"></span>
        <span>MORE TO COME</span>
      </div>
    </div>
  </section>
</PageShell>

<style>
  /* Only shorten the homepage hero; inner pages keep ulBo's original layout. */
  :global(body[data-page-id="home"] .hero-header) {
    height: 76vh;
    height: 76dvh;
    min-height: 500px;
  }

  .journal-section {
    position: relative;
    z-index: 2;
    margin-top: -46px;
    padding: 100px 24px 88px;
    overflow: hidden;
    color: var(--color-text);
    background:
      radial-gradient(ellipse at 78% 12%, rgba(120, 154, 181, 0.16), transparent 42%),
      radial-gradient(ellipse at 7% 88%, rgba(65, 102, 139, 0.14), transparent 52%),
      linear-gradient(165deg, #273340 0%, #1d242d 50%, #222d38 100%);
    border-radius: 48px 48px 0 0;
  }

  .journal-glow {
    position: absolute;
    right: -150px;
    top: 35px;
    width: 470px;
    height: 470px;
    pointer-events: none;
    background: radial-gradient(circle, rgba(143, 179, 204, 0.10), transparent 68%);
    filter: blur(30px);
  }

  .journal-inner {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
  }

  .journal-intro {
    margin-bottom: 38px;
  }

  .journal-eyebrow,
  .journal-copy-label,
  .journal-footer,
  .art-label,
  .art-number {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.17em;
  }

  .journal-eyebrow {
    display: flex;
    align-items: center;
    gap: 13px;
    color: #a7bacb;
  }

  .eyebrow-line {
    width: 34px;
    height: 1px;
    background: #9bb5cc;
  }

  .journal-index { opacity: 0.55; }
  .journal-lead {
    margin: 14px 0 0;
    color: #d8e2ea;
    font-size: clamp(1.16rem, 2vw, 1.55rem);
    letter-spacing: 0.05em;
  }

  .journal-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 78px);
    align-items: center;
  }

  .journal-art {
    min-height: 335px;
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    isolation: isolate;
    background: linear-gradient(140deg, #445d70 0%, #263748 46%, #17212c 100%);
    border: 1px solid rgba(189, 216, 235, 0.18);
    box-shadow: 0 25px 55px rgba(5, 11, 18, 0.25);
  }

  .journal-art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 68% 38%, rgba(210, 227, 236, 0.20), transparent 43%);
  }

  .art-orbit {
    position: absolute;
    width: 410px;
    height: 410px;
    left: 28%;
    top: -23%;
    border-radius: 50%;
    border: 1px solid rgba(193, 216, 236, 0.21);
    transform: rotate(-26deg) scaleY(.68);
  }
  .art-orbit-two {
    left: 22%;
    top: -12%;
    border-color: rgba(193, 216, 236, 0.13);
    transform: rotate(20deg) scaleY(.74);
  }
  .art-monogram {
    position: absolute;
    left: 12%;
    top: 17%;
    font-family: Georgia, serif;
    font-size: clamp(6.2rem, 13vw, 10rem);
    font-style: italic;
    line-height: 1;
    color: rgba(237, 245, 250, 0.88);
    text-shadow: 0 12px 35px rgba(0, 0, 0, .1);
  }
  .art-label {
    position: absolute;
    left: 11%;
    bottom: 12%;
    color: #c3d8e7;
    line-height: 1.7;
  }
  .art-number {
    position: absolute;
    right: 9%;
    bottom: 12%;
    color: #a6bdcf;
    writing-mode: vertical-rl;
    font-size: 0.65rem;
  }

  .journal-copy-label {
    display: flex;
    gap: 10px;
    align-items: center;
    color: #a5bacb;
  }
  .label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #a9c7dd;
    box-shadow: 0 0 12px rgba(169, 199, 221, .5);
  }
  .journal-copy h2 {
    margin: 24px 0 8px;
    color: #f2f6f9;
    font-size: clamp(2.5rem, 5vw, 4.4rem);
    letter-spacing: -0.03em;
    font-weight: 650;
  }
  .journal-english {
    margin: 0 0 28px;
    font-family: 'Outfit', sans-serif;
    color: #91afc7;
    font-size: clamp(0.98rem, 1.6vw, 1.18rem);
    letter-spacing: 0.035em;
  }
  .journal-description {
    max-width: 440px;
    margin: 0 0 30px;
    color: #b6c5d1;
    font-size: 1.02rem;
    line-height: 1.95;
  }
  .journal-status {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 11px 0;
    color: #dce7ef;
    font-weight: 600;
    border-bottom: 1px solid rgba(191, 213, 228, .5);
    font-size: 0.95rem;
  }
  .journal-status span { opacity: .7; }
  .journal-footer {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 80px;
    color: rgba(170, 193, 212, 0.55);
    font-size: 0.65rem;
  }
  .footer-rule {
    height: 1px;
    flex: 1;
    background: rgba(170, 193, 212, 0.18);
  }

  @media (max-width: 720px) {
    :global(body[data-page-id="home"] .hero-header) {
      height: 70vh;
      height: 70dvh;
      min-height: 440px;
    }
    .journal-section {
      margin-top: -28px;
      padding: 66px 20px 58px;
      border-radius: 28px 28px 0 0;
    }
    .journal-intro { margin-bottom: 25px; }
    .journal-feature { grid-template-columns: 1fr; gap: 31px; }
    .journal-art { min-height: 250px; }
    .art-monogram { font-size: 7rem; }
    .journal-copy h2 { margin-top: 17px; font-size: 2.5rem; }
    .journal-english { margin-bottom: 20px; }
    .journal-description { margin-bottom: 20px; }
    .journal-footer { margin-top: 55px; gap: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-art, .journal-copy { animation: none; }
  }
</style>
