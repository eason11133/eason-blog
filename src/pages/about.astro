---
import { Content as AboutContent } from '../content/about.md';
import InteriorHeading from '../components/InteriorHeading.astro';
import PageShell from '../layouts/PageShell.astro';
import { siteTitle } from '../config';
---

<PageShell
  title={`關於我 | ${siteTitle}`}
  description="關於 Eason，還有這個網站。"
  transparentHeader={false}
  useMainWrapper={false}
  pageId="about"
>
  <main class="about-page">
    <div class="about-inner">
      <InteriorHeading title="關於我" centered={true} animated={true} />
      <article class="prose about-prose">
        <AboutContent />
      </article>
    </div>
  </main>
</PageShell>

<style>
  .about-prose {
    box-sizing: border-box;
    width: min(100%, 690px);
    max-width: 690px;
    margin: 0 auto;
    padding: 0 0 32px;
    text-align: left;
    text-shadow: 0 1px 12px rgba(3, 8, 21, .14);
  }

  .about-prose :global(h2) {
    margin: .15rem 0 1.25rem;
    padding: 0;
    border: 0;
    font-size: clamp(1.45rem, 2.5vw, 1.8rem);
    font-weight: 670;
    letter-spacing: -.028em;
    line-height: 1.55;
    color: #e8eaed;
  }

  .about-prose :global(h3) {
    margin: 2.65rem 0 .95rem;
    padding: 0;
    border: 0;
    font-size: 1.13rem;
    font-weight: 660;
    line-height: 1.55;
    color: #e8eaed;
  }

  .about-prose :global(p) {
    margin: 0 0 1.12rem;
    font-size: 1rem;
    line-height: 2;
    font-weight: 400;
    color: #e8eaed;
    opacity: .90;
  }

  .about-prose :global(a) {
    color: #e8eaed;
    text-decoration: none;
    background-image: linear-gradient(#91afcf, #91afcf);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 3px;
    transition: background-size .18s ease, color .18s ease;
  }

  .about-prose :global(a:hover),
  .about-prose :global(a:focus-visible) {
    color: #fff;
    background-size: 100% 2px;
  }

  @media (max-width: 720px) {
    .about-prose {
      padding: 0 0 16px;
    }

    .about-prose :global(h3) {
      margin-top: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-prose :global(a) {
      transition: none;
    }
  }
</style>
