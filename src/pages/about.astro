---
import { Content as AboutContent } from '../content/about.md';
import InteriorHeading from '../components/InteriorHeading.astro';
import PageShell from '../layouts/PageShell.astro';
import { siteTitle } from '../config';
---

<PageShell
  title={`關於我 | ${siteTitle}`}
  description="關於 Eason，以及這個網站。"
  transparentHeader={false}
  useMainWrapper={false}
  pageId="about"
>
  <main class="about-page">
    <section class="about-hero" aria-labelledby="about-page-title">
      <div class="about-hero-inner">
        <p class="hero-label">ABOUT</p>
        <div id="about-page-title">
          <InteriorHeading title="關於我" animated={true} />
        </div>
        <p class="hero-description">一些關於我的事，還有這個網站。</p>
      </div>
    </section>

    <section class="about-surface" aria-label="關於 Eason">
      <div class="about-grid">
        <aside class="about-card profile-card" aria-label="個人資訊與連結">
          <div class="avatar-ring" aria-hidden="true">
            <span class="avatar-letter">E</span>
          </div>
          <h2 class="profile-name">Eason</h2>
          <p class="profile-caption">寫程式、看棒球、打撞球。</p>

          <div class="profile-links">
            <a href="https://github.com/eason11133" target="_blank" rel="noopener noreferrer">
              <span class="profile-link-label">GITHUB</span>
              <span class="profile-link-value">eason11133 <span aria-hidden="true">↗</span></span>
            </a>
            <a href="/blog/" data-astro-prefetch="viewport">
              <span class="profile-link-label">ARTICLES</span>
              <span class="profile-link-value">我的文章 <span aria-hidden="true">↗</span></span>
            </a>
          </div>
        </aside>

        <div class="about-sections">
          <section class="about-card info-card">
            <h2 class="card-heading"><span class="heading-tick" aria-hidden="true"></span>簡介</h2>
            <div class="about-copy">
              <AboutContent />
            </div>
          </section>

          <section class="about-card info-card">
            <h2 class="card-heading"><span class="heading-tick" aria-hidden="true"></span>平常喜歡的事</h2>
            <div class="interests" aria-label="興趣">
              <span>棒球</span>
              <span>撞球</span>
              <span>籃球</span>
              <span>動漫</span>
              <span>寫程式</span>
            </div>
            
          </section>

          <section class="about-card info-card">
            <h2 class="card-heading"><span class="heading-tick" aria-hidden="true"></span>這個網站</h2>
            <p class="card-body">這裡會放一些我寫的文章、做過的東西，還有想記下來的事。目前先整理特殊選才和上機考的心得，其他的慢慢補。</p>
            <a class="text-link" href="/blog/" data-astro-prefetch="viewport">看看文章 <span aria-hidden="true">↗</span></a>
          </section>
        </div>
      </div>
    </section>
  </main>
</PageShell>

<style>
  /* About's structure is intentionally isolated from other interior pages. */
  :global(html[data-theme="dark"] body[data-page-id="about"] main.about-page) {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: calc(100dvh - 64px);
    margin: 0;
    padding: 0 !important;
    background: transparent !important;
  }

  .about-hero {
    box-sizing: border-box;
    position: relative;
    padding: clamp(124px, 17vh, 170px) clamp(22px, 4.2vw, 64px) 68px;
    color: #e8eaed;
    background: linear-gradient(
      to bottom,
      rgba(4, 11, 22, .58) 0%,
      rgba(5, 16, 31, .32) 50%,
      rgba(8, 20, 33, .85) 100%
    );
  }

  .about-hero-inner {
    box-sizing: border-box;
    width: min(100%, 1090px);
    margin: 0 auto;
  }

  .hero-label {
    margin: 0 0 12px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .19em;
    color: #aac0d6;
  }

  .about-hero :global(.interior-heading) {
    margin: 0 0 .85rem;
  }

  .about-hero :global(.interior-heading h1),
  .about-hero :global(.interior-heading h1.typewriter) {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    line-height: 1.22;
    letter-spacing: -.045em;
    color: #f5f7fb;
  }

  .hero-description {
    margin: 0;
    font-size: .98rem;
    line-height: 1.7;
    color: #c5d3e2;
  }

  .about-surface {
    box-sizing: border-box;
    min-height: 540px;
    padding: clamp(30px, 4vw, 46px) clamp(16px, 4vw, 52px) 88px;
    color: #27313c;
    background-color: #f5f3ed;
    background-image: radial-gradient(rgba(36, 49, 66, .095) .7px, transparent .7px);
    background-size: 21px 21px;
  }

  .about-grid {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(220px, 275px) minmax(0, 1fr);
    align-items: start;
    gap: clamp(16px, 2.4vw, 26px);
    max-width: 1090px;
    margin: 0 auto;
  }

  .about-card {
    box-sizing: border-box;
    min-width: 0;
    border: 1px solid #e5e0d7;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 5px 22px rgba(28, 31, 38, .045);
    color: #27313c;
  }

  .profile-card {
    position: sticky;
    top: 88px;
    padding: 28px 24px 18px;
    text-align: center;
  }

  .avatar-ring {
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    margin: 0 auto 13px;
    border: 1px dashed #b8c9d8;
    border-radius: 50%;
    background: #f7fafc;
    box-shadow: inset 0 0 0 6px #fff;
  }

  .avatar-letter {
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(145deg, #223953, #486c8a);
    color: #f5f8fc;
    font-size: 2.6rem;
    font-weight: 750;
    letter-spacing: -.07em;
  }

  .profile-name {
    margin: 0;
    color: #202b37;
    font-size: 1.65rem;
    line-height: 1.3;
    font-weight: 750;
    letter-spacing: -.035em;
  }

  .profile-caption {
    margin: 6px 0 22px;
    color: #687686;
    font-size: .87rem;
    line-height: 1.7;
  }

  .profile-links {
    border-top: 1px solid #e8e5df;
    padding-top: 8px;
    text-align: left;
  }

  .profile-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 0;
    color: #344a61;
    border-bottom: 1px solid #eeebe6;
    text-decoration: none;
    font-size: .83rem;
  }

  .profile-links a:last-child {
    border-bottom: 0;
  }

  .profile-links a:hover,
  .profile-links a:focus-visible,
  .text-link:hover,
  .text-link:focus-visible {
    color: #17618a;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .profile-link-label {
    flex: none;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .09em;
    color: #8090a0;
  }

  .profile-link-value {
    text-align: right;
    overflow-wrap: anywhere;
  }

  .about-sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    min-width: 0;
  }

  .info-card {
    padding: clamp(22px, 3vw, 28px);
  }

  .card-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 17px;
    color: #25313c;
    font-size: 1rem;
    font-weight: 740;
    line-height: 1.45;
    letter-spacing: -.01em;
  }

  .heading-tick {
    display: block;
    flex: 0 0 3px;
    width: 3px;
    height: 15px;
    border-radius: 2px;
    background: #7d9fbb;
  }

  .about-copy :global(p),
  .card-body {
    margin: 0 0 10px;
    font-size: .95rem;
    line-height: 1.95;
    color: #566373;
    font-weight: 400;
  }

  .about-copy :global(p:last-child) {
    margin-bottom: 0;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .interests span {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border: 1px solid #d9e3eb;
    border-radius: 99px;
    background: #f7f9fb;
    color: #40576d;
    font-size: .83rem;
    line-height: 1.6;
  }

  .interests + .card-body {
    margin-top: 16px;
    margin-bottom: 0;
  }

  .text-link {
    display: inline-block;
    margin-top: 8px;
    color: #365977;
    font-size: .86rem;
    text-decoration: underline;
    text-decoration-color: #b3c6d5;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .about-hero {
      padding: 120px 22px 44px;
    }

    .about-surface {
      padding: 18px 16px 64px;
    }

    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      max-width: 620px;
    }

    .profile-card {
      position: static;
      padding: 24px 20px 14px;
    }

    .about-sections {
      gap: 16px;
    }

    .info-card {
      padding: 22px 20px;
    }
  }
</style>
