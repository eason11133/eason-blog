---
import { Content as AboutContent, frontmatter } from '../content/about.md';
import InteriorHeading from '../components/InteriorHeading.astro';
import PageShell from '../layouts/PageShell.astro';
import { siteTitle } from '../config';

interface AboutPageData {
  page_title: string;
  profile: {
    name: string;
    avatar_image?: string;
    specialty?: string;
    specialties?: string[];
  };
  interests_title: string;
  interests: Array<{ icon: string; title: string; description: string }>;
  website: { title: string; description: string; link_text: string; link_url: string };
  timelines: Array<{
    id?: string;
    title: string;
    items: Array<{ when: string; event: string; result?: string; url?: string }>;
  }>;
}

// 所有可編輯文字都在 src/content/about.md；這個檔案只負責排版。
const about = frontmatter as AboutPageData;
---

<PageShell
  title={`${about.page_title} | ${siteTitle}`}
  description={`關於 ${about.profile.name}，以及這個網站。`}
  transparentHeader={false}
  useMainWrapper={false}
  pageId="about"
>
  <main class="vcard-page">
    <aside class="vcard-sidebar" aria-label={`${about.profile.name} 個人資訊`}>
      <div class="sidebar-info">
        {about.profile.avatar_image && (
          <figure class="avatar-box">
            <img
              src={about.profile.avatar_image}
              alt={`${about.profile.name} 的照片`}
              width="132"
              height="132"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )}

        <div class="info-content">
          <h2 class="name">{about.profile.name}</h2>
        </div>
      </div>

      <section class="sidebar-specialty" aria-labelledby="sidebar-specialty-heading">
        <h3 id="sidebar-specialty-heading">專長</h3>
        {about.profile.specialties?.length ? (
          <ul class="specialty-list">
            {about.profile.specialties.map((item) => <li>{item}</li>)}
          </ul>
        ) : about.profile.specialty && <p>{about.profile.specialty}</p>}
      </section>
    </aside>

    <div class="vcard-main-content">
      <section class="vcard-article" aria-labelledby="about-page-title">
        <header class="vcard-heading" id="about-intro">
          <div id="about-page-title">
            <InteriorHeading title={about.page_title} animated={true} />
          </div>
        </header>

        <div class="about-text">
          <AboutContent />
        </div>

        <section class="service" id="about-interests" aria-labelledby="interests-title">
          <h3 id="interests-title" class="section-title">{about.interests_title}</h3>
          <ul class="service-list">
            {about.interests.map((interest) => (
              <li class="service-item">
                <div class="service-icon-box" aria-hidden="true">
                  {interest.icon === 'code' ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m8 17-5-5 5-5m8 0 5 5-5 5m-2-16-4 20"/>
                    </svg>
                  ) : interest.icon === 'baseball' ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/><path d="M12 3c-2 4-2 14 0 18M3.5 9c4-2 13-2 17 0M3.5 15c4 2 13 2 17 0"/>
                    </svg>
                  ) : interest.icon === 'billiards' ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9.5" cy="13.5" r="6.5"/><path d="m14 9 7-7M16 12l5-5M6.5 12.5h.01"/>
                    </svg>
                  ) : interest.icon === 'anime' ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="5" width="18" height="14" rx="3"/><path d="m8 2 4 3 4-3M8 11h.01M16 11h.01M8 15c2 2 6 2 8 0"/>
                    </svg>
                  ) : (interest.icon === 'game' || (interest.icon === 'other' && /game|遊戲/i.test(interest.title))) ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 9h12a4 4 0 0 1 3.9 3.1l.7 4.2a3 3 0 0 1-5.1 2.6L15.8 17H8.2l-1.7 1.9a3 3 0 0 1-5.1-2.6l.7-4.2A4 4 0 0 1 6 9Z"/>
                      <path d="M7 13h4M9 11v4M16.5 13h.01M19 14.5h.01"/>
                    </svg>
                  ) : <span>✦</span>}
                </div>
                <div class="service-content-box">
                  <h4>{interest.title}</h4>
                  <p>{interest.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="site-note" id="about-website" aria-labelledby="website-title">
          <h3 id="website-title" class="section-title">{about.website.title}</h3>
          <p>{about.website.description}</p>
          {about.website.link_url && (
            <a
              class="text-link"
              href={about.website.link_url}
              data-astro-prefetch={about.website.link_url.startsWith('/') ? 'viewport' : undefined}
              target={about.website.link_url.startsWith('https://') ? '_blank' : undefined}
              rel={about.website.link_url.startsWith('https://') ? 'noopener noreferrer' : undefined}
            >{about.website.link_text} <span aria-hidden="true">↗</span></a>
          )}
        </section>
      </section>

      {about.timelines.map((timeline, index) => (
        <section class="timeline-panel" id={timeline.id || `about-timeline-${index + 1}`} aria-labelledby={`${timeline.id || `about-timeline-${index + 1}`}-title`}>
          <h3 class="timeline-title" id={`${timeline.id || `about-timeline-${index + 1}`}-title`}>
            <span aria-hidden="true"></span>{timeline.title}
          </h3>
          <ol class="timeline-list">
            {timeline.items.map((item) => (
              <li class="timeline-row">
                <span class="timeline-when">{item.when}</span>
                {item.url && /^(\/[^/]|https?:\/\/)/.test(item.url) ? (
                  <a
                    class="timeline-event timeline-event-link"
                    href={item.url}
                    target={/^https?:\/\//.test(item.url) ? '_blank' : undefined}
                    rel={/^https?:\/\//.test(item.url) ? 'noopener noreferrer' : undefined}
                    aria-label={`${item.event}，查看更多`}
                  >{item.event}</a>
                ) : <span class="timeline-event">{item.event}</span>}
                {item.result && <span class="timeline-result">{item.result}</span>}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
</PageShell>

<style>
  /**
   * About layout adapted from codewithsadee/vcard-personal-portfolio (MIT).
   * Original copyright (c) 2022 codewithsadee.
   * License text: LICENSES/vcard-personal-portfolio.txt
   * All selectors are scoped to this page to avoid changing other site pages.
   */
  .vcard-page {
    --vcard-panel: transparent;
    --vcard-onyx: transparent;
    --vcard-jet: rgba(145, 175, 207, .3);
    --vcard-text: #fafafa;
    --vcard-muted: #d6d6d6;
    --vcard-accent: #a6c9e8;
    --vcard-border-gradient: transparent;
    --vcard-inset: transparent;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    width: min(100%, 1230px);
    margin: 0 auto;
    padding: clamp(116px, 14vh, 150px) clamp(16px, 3vw, 34px) 96px;
    display: grid;
    grid-template-columns: minmax(250px, 278px) minmax(0, 1fr);
    align-items: start;
    gap: 25px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--vcard-muted);
  }

  .vcard-page *,
  .vcard-page *::before,
  .vcard-page *::after { box-sizing: border-box; }

  .vcard-sidebar,
  .vcard-article {
    min-width: 0;
    border-radius: 20px;
    border: 1px solid var(--vcard-jet);
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .vcard-sidebar {
    position: sticky;
    top: 88px;
    padding: 30px 22px;
  }

  .sidebar-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 17px;
  }
  .avatar-box {
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    margin: 0;
    border-radius: 20px;
    background: transparent;
    border: 1px solid rgba(145, 175, 207, .22);
    overflow: hidden;
  }
  .avatar-box img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .info-content { min-width: 0; text-align: center; }
  .info-content .name {
    margin: 0;
    color: var(--vcard-text);
    font-size: 1.55rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -.025em;
  }

  /* Same profile panel, extended below the photo and name. */
  .sidebar-specialty {
    width: 100%;
    margin-top: 27px;
    padding-top: 22px;
    border-top: 1px solid rgba(145, 175, 207, .24);
    text-align: left;
  }
  .sidebar-specialty h3 {
    margin: 0 0 9px;
    color: var(--vcard-text);
    font-size: .98rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .sidebar-specialty p {
    margin: 0;
    color: var(--vcard-muted);
    font-size: .91rem;
    line-height: 1.85;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .specialty-list {
    margin: 2px 0 0;
    padding-left: 1.2rem;
    list-style: disc;
  }
  .specialty-list li {
    margin-bottom: 7px;
    color: var(--vcard-muted);
    font-size: .91rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .specialty-list li:last-child { margin-bottom: 0; }
  .specialty-list li::marker { color: var(--vcard-accent); }

  .vcard-main-content { position: relative; min-width: 0; }
  .vcard-article {
    min-height: 520px;
    padding: 38px clamp(24px, 4vw, 38px) 38px;
  }

  .vcard-heading { scroll-margin-top: 100px; }
  .vcard-heading :global(.interior-heading) {
    position: relative;
    margin: 0 0 23px;
    padding-bottom: 19px;
    text-align: left;
  }
  .vcard-heading :global(.interior-heading::after) {
    content: '';
    position: absolute;
    width: 42px;
    height: 4px;
    left: 0;
    bottom: 0;
    border-radius: 4px;
    background: var(--vcard-accent);
  }
  .vcard-heading :global(.interior-heading h1),
  .vcard-heading :global(.interior-heading h1.typewriter) {
    color: var(--vcard-text);
    font-size: clamp(1.8rem, 3vw, 2rem);
    font-weight: 650;
    line-height: 1.4;
  }

  .about-text :global(p) {
    margin: 0 0 14px;
    color: var(--vcard-muted);
    font-size: .96rem;
    font-weight: 400;
    line-height: 1.85;
  }

  .service,
  .site-note { scroll-margin-top: 95px; }
  .service { margin-top: 32px; }
  .section-title {
    margin: 0 0 20px;
    color: #f6f6f6;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .service-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .service-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 17px;
    min-width: 0;
    padding: 24px 20px;
    border-radius: 14px;
    background: transparent;
    border: 1px solid rgba(145, 175, 207, .27);
    box-shadow: none;
    isolation: isolate;
  }
  .service-item::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: transparent;
    z-index: -1;
  }
  .service-icon-box { flex: 0 0 36px; color: var(--vcard-accent); margin-top: 2px; }
  .service-content-box { min-width: 0; }
  .service-content-box h4 {
    margin: 0 0 6px;
    color: #f5f5f5;
    font-size: 1.03rem;
    font-weight: 600;
  }
  .service-content-box p {
    margin: 0;
    color: #d5d5d6;
    font-size: .91rem;
    line-height: 1.75;
  }

  .site-note {
    margin-top: 35px;
  }
  .site-note p {
    margin: 0 0 10px;
    color: var(--vcard-muted);
    font-size: .96rem;
    line-height: 1.9;
  }
  .text-link {
    display: inline-block;
    padding: 4px 0;
    color: var(--vcard-accent);
    font-size: .91rem;
    text-underline-offset: 5px;
    text-decoration: underline;
    text-decoration-color: rgba(166,201,232,.4);
  }
  .text-link:hover,
  .text-link:focus-visible { text-decoration-color: var(--vcard-accent); }
  .text-link span { display: inline; }


  /* Timeline rows follow the supplied 郭10 timeline reference, while keeping
     the user's transparent night-sky vCard panels and existing typography. */
  .timeline-panel {
    margin-top: 22px;
    padding: clamp(24px, 3.2vw, 34px);
    border: 1px solid var(--vcard-jet);
    border-radius: 20px;
    background: transparent;
    box-shadow: none;
    color: var(--vcard-text);
    scroll-margin-top: 92px;
  }
  .timeline-title {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 20px;
    color: #f5f5f5;
    font-size: 1.03rem;
    font-weight: 650;
    line-height: 1.5;
  }
  .timeline-title > span {
    flex: 0 0 3px;
    width: 3px;
    height: 16px;
    border-radius: 3px;
    background: var(--vcard-accent);
  }
  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline-row {
    display: grid;
    grid-template-columns: minmax(75px, 108px) minmax(0, 1fr) minmax(70px, auto);
    gap: 16px;
    align-items: start;
    position: relative;
    min-width: 0;
    padding: 11px 0 11px 20px;
    font-size: .89rem;
    line-height: 1.6;
  }
  .timeline-row::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(145, 175, 207, .25);
  }
  .timeline-row::after {
    content: '';
    position: absolute;
    left: 0;
    top: 20px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #91afcf;
  }
  .timeline-when { color: #aabbd0; font-size: .82rem; }
  .timeline-event { color: #e8eaed; min-width: 0; overflow-wrap: anywhere; }
  .timeline-event-link {
    display: inline;
    width: fit-content;
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(#91afcf, #91afcf);
    background-position: 0% 100%;
    background-repeat: no-repeat;
    background-size: 0% 2px;
    padding-bottom: 2px;
    transition: background-size .3s cubic-bezier(.25, .46, .45, .94), color .2s ease;
  }
  .timeline-event-link:hover,
  .timeline-event-link:focus-visible {
    color: #b4d6f4;
    background-size: 100% 2px;
  }
  .timeline-event-link:focus-visible {
    outline: 2px solid #b4d6f4;
    outline-offset: 3px;
    border-radius: 3px;
  }
  .timeline-result {
    color: #b4d6f4;
    text-align: right;
    white-space: nowrap;
    font-weight: 600;
    font-size: .84rem;
  }
  @media (max-width: 620px) {
    .timeline-panel {
      margin-top: 14px;
      padding: 22px 18px;
      border-radius: 17px;
    }
    .timeline-row {
      grid-template-columns: minmax(61px, 78px) minmax(0, 1fr);
      gap: 5px 11px;
      padding-left: 17px;
    }
    .timeline-result {
      grid-column: 2;
      text-align: left;
    }
  }

  @media (max-width: 980px) {
    .vcard-page {
      max-width: 780px;
      grid-template-columns: minmax(0,1fr);
      gap: 18px;
      padding-top: 108px;
    }
    .vcard-sidebar {
      position: static;
      padding: 22px 26px;
    }
    .sidebar-info { flex-direction: row; gap: 20px; justify-content: flex-start; }
    .avatar-box { width: 92px; height: 92px; flex: 0 0 92px; }
    .info-content { text-align: left; }
  }

  @media (max-width: 620px) {
    .vcard-page { padding: 98px 14px 66px; gap: 14px; }
    .vcard-sidebar { padding: 18px; border-radius: 17px; }
    .avatar-box { flex-basis: 68px; width: 68px; height: 68px; border-radius: 14px; }
    .info-content .name { font-size: 1.3rem; }
    .vcard-article {
      padding: 25px 20px 30px;
      border-radius: 17px;
      min-height: 0;
    }
    .service-list { grid-template-columns: minmax(0, 1fr); gap: 13px; }
    .service-item { padding: 19px 16px; }
    .section-title { font-size: 1.17rem; }
    .vcard-heading :global(.interior-heading) { margin-bottom: 19px; }
  }

</style>
