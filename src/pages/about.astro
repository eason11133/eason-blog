---
import { Content as AboutContent } from '../content/about.md';
import InteriorHeading from '../components/InteriorHeading.astro';
import PageShell from '../layouts/PageShell.astro';
import { siteTitle } from '../config';
---

<PageShell
  title={`關於我 | ${siteTitle}`}
  description="關於 Eason，以及這個網站。"
  transparentHeader={false}
  useMainWrapper={false}
  pageId="about"
>
  <main class="vcard-page">
    <aside class="vcard-sidebar" aria-label="Eason 個人資訊">
      <div class="sidebar-info">
        <figure class="avatar-box" aria-label="Eason 字母頭像">
          <span aria-hidden="true">E</span>
        </figure>

        <div class="info-content">
          <h2 class="name">Eason</h2>
          <p class="title">寫程式、棒球、撞球</p>
        </div>
      </div>

      <div class="sidebar-separator" aria-hidden="true"></div>

      <div class="sidebar-details">
        <a class="sidebar-link" href="https://github.com/eason11133" target="_blank" rel="noopener noreferrer">
          <span class="sidebar-link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"/><path d="M9 19v-2.5a3 3 0 0 1-1-1.5c-3 .2-3-1.5-4-2"/><path d="M15 19v-2.5a3 3 0 0 0 1.5-2.8c0-1-.2-1.6-.7-2.1.2-1.1.1-1.7-.2-2.4-1 0-1.5.3-2.2.8a9 9 0 0 0-3 0c-.7-.5-1.3-.8-2.2-.8-.3.7-.4 1.3-.2 2.4-.5.5-.7 1.1-.7 2.1a3 3 0 0 0 1.5 2.8"/>
            </svg>
          </span>
          <span class="sidebar-link-text"><span class="sidebar-label">GITHUB</span><span class="sidebar-value">eason11133</span></span>
          <span class="sidebar-arrow" aria-hidden="true">↗</span>
        </a>

        <a class="sidebar-link" href="/blog/" data-astro-prefetch="viewport">
          <span class="sidebar-link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22z"/><path d="M4 4.5V19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M9 8h7M9 12h5"/>
            </svg>
          </span>
          <span class="sidebar-link-text"><span class="sidebar-label">ARTICLES</span><span class="sidebar-value">文章</span></span>
          <span class="sidebar-arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="sidebar-separator sidebar-separator--bottom" aria-hidden="true"></div>
      <p class="sidebar-note">偶爾在這裡寫點東西。</p>
    </aside>

    <div class="vcard-main-content">
      <nav class="vcard-navbar" aria-label="關於頁區段">
        <a class="vcard-navbar-link is-active" href="#about-intro">關於我</a>
        <a class="vcard-navbar-link" href="#about-interests">興趣</a>
        <a class="vcard-navbar-link" href="#about-website">網站</a>
      </nav>

      <section class="vcard-article" aria-labelledby="about-page-title">
        <header class="vcard-heading" id="about-intro">
          <div id="about-page-title">
            <InteriorHeading title="關於我" animated={true} />
          </div>
        </header>

        <div class="about-text">
          <AboutContent />
        </div>

        <section class="service" id="about-interests" aria-labelledby="interests-title">
          <h3 id="interests-title" class="section-title">平常喜歡的事</h3>
          <ul class="service-list">
            <li class="service-item">
              <div class="service-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m8 17-5-5 5-5m8 0 5 5-5 5m-2-16-4 20"/>
                </svg>
              </div>
              <div class="service-content-box">
                <h4>寫程式</h4>
                <p>有一些自己想做的東西，就會動手試試看。</p>
              </div>
            </li>
            <li class="service-item">
              <div class="service-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"/><path d="M12 3c-2 4-2 14 0 18M3.5 9c4-2 13-2 17 0M3.5 15c4 2 13 2 17 0"/>
                </svg>
              </div>
              <div class="service-content-box">
                <h4>棒球</h4>
                <p>以前自己打球，現在還是很喜歡看。</p>
              </div>
            </li>
            <li class="service-item">
              <div class="service-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9.5" cy="13.5" r="6.5"/><path d="m14 9 7-7M16 12l5-5M6.5 12.5h.01"/>
                </svg>
              </div>
              <div class="service-content-box">
                <h4>撞球</h4>
                <p>喜歡打九號球。</p>
              </div>
            </li>
            <li class="service-item">
              <div class="service-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="3"/><path d="m8 2 4 3 4-3M8 11h.01M16 11h.01M8 15c2 2 6 2 8 0"/>
                </svg>
              </div>
              <div class="service-content-box">
                <h4>動漫</h4>
                <p>平常也會看動漫。</p>
              </div>
            </li>
          </ul>
        </section>

        <section class="site-note" id="about-website" aria-labelledby="website-title">
          <h3 id="website-title" class="section-title">關於這個網站</h3>
          <p>這裡主要放文章和一些自己做的東西。目前先整理特殊選才的準備、面試和上機考心得。</p>
          <a class="text-link" href="/blog/" data-astro-prefetch="viewport">去看文章 <span aria-hidden="true">↗</span></a>
        </section>
      </section>
    </div>
  </main>
</PageShell>

<style>
  /**
   * About layout adapted from codewithsadee/vcard-personal-portfolio (MIT).
   * Original copyright (c) 2022 codewithsadee.
   * License text: LICENSES/vcard-personal-portfolio.txt
   * All selectors are scoped to this page to avoid changing other site pages.
   */
  .vcard-page {
    --vcard-panel: #202022;
    --vcard-onyx: #2b2b2d;
    --vcard-jet: #3e3e40;
    --vcard-text: #fafafa;
    --vcard-muted: #d6d6d6;
    --vcard-accent: #a6c9e8;
    --vcard-border-gradient: linear-gradient(to bottom right, #454547, transparent 58%);
    --vcard-inset: linear-gradient(to bottom right, rgba(55, 55, 59, .26), transparent 70%), #232326;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    width: min(100%, 1230px);
    margin: 0 auto;
    padding: clamp(116px, 14vh, 150px) clamp(16px, 3vw, 34px) 96px;
    display: grid;
    grid-template-columns: minmax(250px, 278px) minmax(0, 1fr);
    align-items: start;
    gap: 25px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--vcard-muted);
  }

  .vcard-page *,
  .vcard-page *::before,
  .vcard-page *::after { box-sizing: border-box; }

  .vcard-sidebar,
  .vcard-article {
    min-width: 0;
    border-radius: 20px;
    border: 1px solid var(--vcard-jet);
    background: var(--vcard-panel);
    box-shadow: -4px 8px 28px rgba(0, 0, 0, .25);
  }

  .vcard-sidebar {
    position: sticky;
    top: 88px;
    padding: 38px 26px 24px;
  }

  .sidebar-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 17px;
  }

  .avatar-box {
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    margin: 0;
    border-radius: 20px;
    background: linear-gradient(145deg, #45474d, #292b31);
    overflow: hidden;
  }

  .avatar-box span {
    display: grid;
    place-items: center;
    width: 103px;
    height: 103px;
    border-radius: 50%;
    background: linear-gradient(145deg, #35536c, #172c40);
    color: #e7f1fa;
    font-size: 3.55rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -.055em;
  }

  .info-content { min-width: 0; text-align: center; }
  .info-content .name {
    margin: 0 0 12px;
    color: var(--vcard-text);
    font-size: 1.55rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -.025em;
  }

  .info-content .title {
    width: fit-content;
    margin: 0 auto;
    padding: 5px 13px;
    border-radius: 8px;
    background: var(--vcard-onyx);
    color: #e6e8eb;
    font-size: .78rem;
    font-weight: 400;
  }

  .sidebar-separator {
    width: 100%;
    height: 1px;
    margin: 28px 0;
    background: var(--vcard-jet);
  }
  .sidebar-separator--bottom { margin-bottom: 17px; }

  .sidebar-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--vcard-text);
    text-decoration: none;
  }

  .sidebar-link-icon {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: var(--vcard-accent);
    background: linear-gradient(to bottom right, #414145, #252529);
    box-shadow: 0 7px 14px rgba(0, 0, 0, .15);
  }

  .sidebar-link-icon::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: #28282a;
    z-index: 0;
  }
  .sidebar-link-icon svg { position: relative; z-index: 1; }
  .sidebar-link-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .sidebar-label { color: #b8b8bd; font-size: .69rem; font-weight: 500; letter-spacing: .065em; }
  .sidebar-value { color: #fafafa; font-size: .87rem; overflow-wrap: anywhere; }
  .sidebar-arrow { color: var(--vcard-accent); margin-left: auto; opacity: .6; }
  .sidebar-link:hover .sidebar-value,
  .sidebar-link:focus-visible .sidebar-value { color: var(--vcard-accent); }
  .sidebar-note { color: #a9abb2; margin: 0; text-align: center; font-size: .84rem; }

  .vcard-main-content { position: relative; min-width: 0; }
  .vcard-article {
    min-height: 520px;
    padding: 88px clamp(24px, 4vw, 38px) 38px;
  }

  .vcard-navbar {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: flex;
    gap: clamp(8px, 2vw, 22px);
    align-items: center;
    border: 1px solid var(--vcard-jet);
    border-radius: 0 20px;
    background: #2b2b2d;
    padding: 0 clamp(12px, 2.5vw, 25px);
  }
  .vcard-navbar-link {
    display: block;
    padding: 19px 8px;
    color: #d9d9dd;
    font-size: .91rem;
    text-decoration: none;
    transition: color .18s ease;
  }
  .vcard-navbar-link.is-active,
  .vcard-navbar-link:hover,
  .vcard-navbar-link:focus-visible { color: var(--vcard-accent); }

  .vcard-heading { scroll-margin-top: 100px; }
  .vcard-heading :global(.interior-heading) {
    position: relative;
    margin: 0 0 23px;
    padding-bottom: 19px;
    text-align: left;
  }
  .vcard-heading :global(.interior-heading::after) {
    content: '';
    position: absolute;
    width: 42px;
    height: 4px;
    left: 0;
    bottom: 0;
    border-radius: 4px;
    background: var(--vcard-accent);
  }
  .vcard-heading :global(.interior-heading h1),
  .vcard-heading :global(.interior-heading h1.typewriter) {
    color: var(--vcard-text);
    font-size: clamp(1.8rem, 3vw, 2rem);
    font-weight: 650;
    line-height: 1.4;
  }

  .about-text :global(p) {
    margin: 0 0 14px;
    color: var(--vcard-muted);
    font-size: .96rem;
    font-weight: 400;
    line-height: 1.85;
  }

  .service,
  .site-note { scroll-margin-top: 95px; }
  .service { margin-top: 32px; }
  .section-title {
    margin: 0 0 20px;
    color: #f6f6f6;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .service-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .service-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 17px;
    min-width: 0;
    padding: 24px 20px;
    border-radius: 14px;
    background: var(--vcard-border-gradient);
    box-shadow: 0 14px 27px rgba(0,0,0,.15);
    isolation: isolate;
  }
  .service-item::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: var(--vcard-inset);
    z-index: -1;
  }
  .service-icon-box { flex: 0 0 36px; color: var(--vcard-accent); margin-top: 2px; }
  .service-content-box { min-width: 0; }
  .service-content-box h4 {
    margin: 0 0 6px;
    color: #f5f5f5;
    font-size: 1.03rem;
    font-weight: 600;
  }
  .service-content-box p {
    margin: 0;
    color: #d5d5d6;
    font-size: .91rem;
    line-height: 1.75;
  }

  .site-note {
    margin-top: 35px;
  }
  .site-note p {
    margin: 0 0 10px;
    color: var(--vcard-muted);
    font-size: .96rem;
    line-height: 1.9;
  }
  .text-link {
    display: inline-block;
    padding: 4px 0;
    color: var(--vcard-accent);
    font-size: .91rem;
    text-underline-offset: 5px;
    text-decoration: underline;
    text-decoration-color: rgba(166,201,232,.4);
  }
  .text-link:hover,
  .text-link:focus-visible { text-decoration-color: var(--vcard-accent); }
  .text-link span { display: inline; }

  @media (max-width: 980px) {
    .vcard-page {
      max-width: 780px;
      grid-template-columns: minmax(0,1fr);
      gap: 18px;
      padding-top: 108px;
    }
    .vcard-sidebar {
      position: static;
      padding: 22px 26px;
    }
    .sidebar-info { flex-direction: row; gap: 20px; justify-content: flex-start; }
    .avatar-box { width: 92px; height: 92px; flex: 0 0 92px; }
    .avatar-box span { width: 74px; height: 74px; font-size: 2.7rem; }
    .info-content { text-align: left; }
    .info-content .title { margin: 0; }
    .sidebar-separator { margin: 18px 0; }
    .sidebar-separator--bottom { display: none; }
    .sidebar-details { flex-direction: row; flex-wrap: wrap; gap: 16px 26px; }
    .sidebar-note { display: none; }
  }

  @media (max-width: 620px) {
    .vcard-page { padding: 98px 14px 66px; gap: 14px; }
    .vcard-sidebar { padding: 18px; border-radius: 17px; }
    .avatar-box { flex-basis: 68px; width: 68px; height: 68px; border-radius: 14px; }
    .avatar-box span { width: 52px; height: 52px; font-size: 2rem; }
    .info-content .name { font-size: 1.3rem; margin-bottom: 7px; }
    .info-content .title { font-size: .72rem; padding: 4px 8px; }
    .sidebar-details { gap: 16px; }
    .sidebar-link-icon { width: 36px; height: 36px; }
    .sidebar-link { width: 100%; }
    .vcard-navbar {
      position: static;
      justify-content: center;
      border-radius: 15px 15px 0 0;
      width: 100%;
      padding: 0 7px;
    }
    .vcard-navbar-link { padding: 13px 10px; font-size: .86rem; }
    .vcard-article {
      padding: 25px 20px 30px;
      border-radius: 0 0 17px 17px;
      border-top: 0;
      min-height: 0;
    }
    .service-list { grid-template-columns: minmax(0, 1fr); gap: 13px; }
    .service-item { padding: 19px 16px; }
    .section-title { font-size: 1.17rem; }
    .vcard-heading :global(.interior-heading) { margin-bottom: 19px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vcard-navbar-link { transition: none; }
  }
</style>
