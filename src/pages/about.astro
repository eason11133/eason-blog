---
import ContentCard from '../components/ContentCard.astro';
import HeroHeader from '../components/HeroHeader.astro';
import PageShell from '../layouts/PageShell.astro';
import { heroConfig, profileConfig, siteTitle } from '../config';
import { buildSameAsLinks } from '../lib/profile/social';

const profile = profileConfig;
const aboutHero = heroConfig.about;
const siteURL = Astro.site ?? Astro.url;
const sameAs = buildSameAsLinks(profile);
const profileAvatarSrc = typeof profile.avatar === 'string' ? profile.avatar : profile.avatar?.src;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/about/#person', siteURL).toString(),
  name: profile.name,
  description: profile.bio,
  jobTitle: profile.title,
  url: new URL('/about/', siteURL).toString(),
  ...(profileAvatarSrc ? { image: new URL(profileAvatarSrc, siteURL).toString() } : {}),
  ...(profile.location ? { homeLocation: { '@type': 'Place', name: profile.location } } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<PageShell
  title={`About | ${siteTitle}`}
  description="關於 Eason 的個人網站（版型預覽）"
  schema={personSchema}
  transparentHeader={true}
  pageId="about"
>
  <HeroHeader
    text={aboutHero.text}
    subtitle={aboutHero.subtitle}
    backgroundImage={aboutHero.backgroundImage}
    compact={true}
  />

  <main class="about-main">
    <ContentCard id="about-preview">
      <div class="about-sheet">
        <div class="preview-label"><span class="preview-dot"></span> 版型預覽 · 以下文字為示範內容</div>
        <header class="identity">
          <div class="identity-copy">
            <div class="overline">HELLO, I'M EASON</div>
            <h1>嗨，我是 <span>Eason.</span></h1>
            <p class="identity-desc">這裡是我的一小塊地方，記錄正在做的事、學到的東西，還有生活中的一些片段。</p>
            <div class="identity-facts"><span>Student</span><span>Developer</span><span>Baseball fan</span></div>
            <nav class="social-links" aria-label="個人連結">
              <a href="https://github.com/eason11133" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
              <span>其他聯絡方式（待補）</span>
            </nav>
          </div>
          <div class="portrait-area" aria-label="個人照片預留位置">
            <div class="portrait-frame">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><circle cx="12" cy="8" r="3.4"/><path d="M4 21c.6-5.2 3-8.1 8-8.1s7.4 2.9 8 8.1"/></svg>
              <span>YOUR PHOTO</span>
            </div>
            <small>照片位置 · 待決定</small>
          </div>
        </header>

        <div class="continuous-content">
          <section class="editorial-section">
            <div class="section-marker"><span>01</span><span>MY STORY</span></div>
            <div class="section-content">
              <h2>關於我</h2>
              <p>這裡可以寫一段真正屬於自己的故事。也許是以前每天投入的運動，後來怎麼開始接觸程式，或者某個讓你決定試試看的念頭。</p>
              <p>不需要把每段經歷都寫得很厲害。就像平常和別人介紹自己一樣，講清楚就好。這兩段目前只是示範文字。</p>
            </div>
          </section>

          <section class="editorial-section">
            <div class="section-marker"><span>02</span><span>NOW</span></div>
            <div class="section-content">
              <h2>最近在做什麼</h2>
              <div class="work-rows">
                <div class="work-row"><span class="work-num">01</span><div><h3>示範專案 A</h3><p>簡短介紹目前正在做的事情。之後可以連到真正的作品頁。</p></div><span class="row-arrow" aria-hidden="true">↗</span></div>
                <div class="work-row"><span class="work-num">02</span><div><h3>示範學習主題 B</h3><p>放最近正在研究或練習的技術。</p></div><span class="row-arrow" aria-hidden="true">↗</span></div>
                <div class="work-row"><span class="work-num">03</span><div><h3>寫文章與生活紀錄</h3><p>把值得記下來的心得留在這個網站。</p></div><span class="row-arrow" aria-hidden="true">↗</span></div>
              </div>
            </div>
          </section>

          <section class="editorial-section">
            <div class="section-marker"><span>03</span><span>OUTSIDE OF CODE</span></div>
            <div class="section-content">
              <h2>程式之外</h2>
              <p>平常也會花時間在其他喜歡的事情上。這部分不打算寫成一堆技能標籤，幾句話就能帶出自己的個性。</p>
              <div class="hobby-line"><span>⚾ <b>棒球</b></span><span>🏀 <b>籃球</b></span><span>🎱 <b>撞球</b></span></div>
            </div>
          </section>

          <section class="editorial-section last-section">
            <div class="section-marker"><span>04</span><span>SELECTED MOMENTS</span></div>
            <div class="section-content">
              <div class="heading-row"><h2>一些經歷</h2><span class="subtle">示範年份及內容</span></div>
              <div class="history-rows">
                <div class="history-row"><span class="history-year">20XX</span><div><strong>示範經歷一</strong><p>一段簡短說明，細節不需要在這裡全部寫完。</p></div></div>
                <div class="history-row"><span class="history-year">20XX</span><div><strong>示範經歷二</strong><p>可以是專案、比賽，也可以是其他重要的事情。</p></div></div>
                <div class="history-row"><span class="history-year">20XX</span><div><strong>示範經歷三</strong><p>放入真正經歷後，再確認哪些值得留下。</p></div></div>
              </div>
            </div>
          </section>
        </div>
        <footer class="closing-line"><span>That's me, for now.</span><span>About · Layout preview</span></footer>
      </div>
    </ContentCard>
  </main>
  <style>
    .about-main{position:relative;margin-top:-88px;padding-bottom:85px;background:linear-gradient(to bottom,transparent 88px,var(--color-bg) 88px)}
    .about-sheet{max-width:990px;margin:auto;padding:25px 42px 56px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;box-shadow:var(--shadow-card)}
    .preview-label{display:flex;align-items:center;gap:9px;color:var(--color-text-muted);font-size:12px;letter-spacing:.03em;border-bottom:1px solid var(--color-border);padding-bottom:18px}
    .preview-dot{width:7px;height:7px;border-radius:50%;background:var(--accent)}
    .identity{display:grid;grid-template-columns:minmax(0,1fr) 215px;align-items:center;gap:38px;padding:57px 0 65px}
    .overline{font-size:12px;color:var(--accent);font-weight:700;letter-spacing:.19em}
    .identity h1{font-size:clamp(37px,5vw,57px);letter-spacing:-.045em;line-height:1.18;margin:15px 0 19px;color:var(--color-text-strong);font-weight:760}
    .identity h1 span{color:var(--accent)}
    .identity-desc{color:var(--color-text-secondary);font-size:17px;line-height:1.9;max-width:580px;margin:0 0 24px}
    .identity-facts{display:flex;flex-wrap:wrap;gap:0 13px;color:var(--color-text-muted);font-size:13px}
    .identity-facts span+span:before{content:"·";margin-right:13px;color:var(--accent)}
    .social-links{display:flex;align-items:center;flex-wrap:wrap;gap:18px;margin-top:27px}
    .social-links a{color:var(--color-text-strong);font-weight:600;font-size:13px;text-decoration:none;border-bottom:1px solid var(--accent);padding-bottom:5px}
    .social-links a:hover{color:var(--accent)}
    .social-links span{color:var(--color-text-muted);font-size:12px}
    .portrait-area{text-align:center}
    .portrait-frame{width:200px;height:245px;background:linear-gradient(145deg,var(--color-surface-elevated),var(--color-bg));border:1px solid var(--color-border);border-radius:9px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:var(--color-text-muted)}
    .portrait-frame svg{width:72px;height:72px;opacity:.6}
    .portrait-frame span{font-size:10px;letter-spacing:.2em}
    .portrait-area small{display:block;font-size:11px;margin-top:11px;color:var(--color-text-muted)}
    .continuous-content{border-top:1px solid var(--color-border)}
    .editorial-section{display:grid;grid-template-columns:170px minmax(0,1fr);gap:35px;padding:50px 0;border-bottom:1px solid var(--color-border)}
    .section-marker{display:flex;gap:12px;align-items:baseline;color:var(--color-text-muted);font-size:10px;letter-spacing:.1em;padding-top:9px;white-space:nowrap}
    .section-marker span:first-child{font-size:14px;font-weight:750;color:var(--accent);letter-spacing:0}
    .section-content h2{color:var(--color-text-strong);font-size:clamp(24px,2.8vw,29px);margin:0 0 20px;letter-spacing:-.025em}
    .section-content>p{color:var(--color-text-secondary);font-size:15px;line-height:2;max-width:660px;margin:0 0 17px}
    .section-content>p:last-child{margin-bottom:0}
    .work-rows,.history-rows{margin-top:7px}
    .work-row{display:grid;grid-template-columns:29px minmax(0,1fr) 20px;gap:14px;align-items:start;padding:19px 0;border-bottom:1px solid var(--color-border)}
    .work-row:first-child{padding-top:3px}
    .work-row:last-child{border-bottom:0;padding-bottom:0}
    .work-num{color:var(--accent);font-size:12px;font-weight:600;padding-top:4px}
    .work-row h3{font-size:16px;color:var(--color-text-strong);margin:0 0 6px}
    .work-row p,.history-row p{color:var(--color-text-muted);font-size:13px;line-height:1.8;margin:0}
    .row-arrow{color:var(--color-text-muted);font-size:17px}
    .hobby-line{display:flex;flex-wrap:wrap;gap:10px;margin-top:27px}
    .hobby-line span{display:inline-flex;gap:8px;align-items:center;padding:11px 17px;background:var(--color-surface-elevated);border:1px solid var(--color-border);border-radius:9px;font-size:14px}
    .hobby-line b{font-weight:600}
    .heading-row{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
    .heading-row .subtle{font-size:11px;color:var(--color-text-muted)}
    .history-row{display:grid;grid-template-columns:70px minmax(0,1fr);gap:18px;padding:17px 0;border-bottom:1px solid var(--color-border)}
    .history-row:last-child{border-bottom:0}
    .history-year{font-size:13px;color:var(--accent);font-weight:700}
    .history-row strong{color:var(--color-text-strong);font-size:15px;display:block;margin:0 0 5px}
    .closing-line{display:flex;justify-content:space-between;gap:15px;color:var(--color-text-muted);font-size:12px;padding-top:24px}
    .closing-line span:first-child{font-style:italic}
    @media(max-width:780px){.about-sheet{padding:22px 27px 42px}.identity{grid-template-columns:minmax(0,1fr) 155px;gap:20px}.portrait-frame{width:150px;height:190px}.editorial-section{grid-template-columns:125px minmax(0,1fr);gap:20px}}
    @media(max-width:600px){.about-main{margin-top:-56px;background:linear-gradient(to bottom,transparent 56px,var(--color-bg) 56px);padding-bottom:45px}.about-sheet{padding:19px 21px 36px;border-radius:0}.identity{display:flex;flex-direction:column-reverse;align-items:flex-start;gap:23px;padding:34px 0 41px}.portrait-area{align-self:flex-start;text-align:left;display:flex;align-items:center;gap:15px}.portrait-frame{width:88px;height:88px;border-radius:50%;gap:0}.portrait-frame svg{height:39px;width:39px}.portrait-frame span{font-size:7px}.portrait-area small{margin-top:0;max-width:95px;line-height:1.5}.identity h1{font-size:39px;margin:11px 0 15px}.identity-desc{font-size:15px;margin-bottom:18px}.social-links{margin-top:22px}.editorial-section{display:block;padding:35px 0}.section-marker{margin-bottom:16px;padding-top:0}.section-content h2{font-size:25px;margin-bottom:15px}.section-content>p{font-size:14px;line-height:1.9}.heading-row{align-items:start}.history-row{grid-template-columns:55px minmax(0,1fr);gap:10px}.closing-line{padding-top:21px}.hobby-line{gap:8px}.hobby-line span{padding:9px 12px;font-size:13px}}
  </style>
</PageShell>
