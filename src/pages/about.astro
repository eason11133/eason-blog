---
import { Content as AboutContent, frontmatter } from '../content/about.md';
import InteriorHeading from '../components/InteriorHeading.astro';
import PageShell from '../layouts/PageShell.astro';
import { siteTitle } from '../config';

interface AboutPageData {
  page_title: string;
  profile: {
    name: string;
    avatar_initial: string;
    tagline: string;
    note: string;
    links: Array<{ icon: string; label: string; text: string; url: string }>;
  };
  navigation: { intro: string; interests: string; website: string };
  interests_title: string;
  interests: Array<{ icon: string; title: string; description: string }>;
  website: { title: string; description: string; link_text: string; link_url: string };
  timelines: Array<{
    id: string;
    title: string;
    items: Array<{ when: string; event: string; result?: string }>;
  }>;
}

// 所有可編輯文字都在 src/content/about.md；這個檔案只負責排版。
const about = frontmatter as AboutPageData;
---

<PageShell
  title={`${about.page_title} | ${siteTitle}`}
  description={`關於 ${about.profile.name}，以及這個網站。`}
  transparentHeader={false}
  useMainWrapper={false}
  pageId="about"
>
  <main class="vcard-page">
    <aside class="vcard-sidebar" aria-label={`${about.profile.name} 個人資訊`}>
      <div class="sidebar-info">
        <figure class="avatar-box" aria-label={`${about.profile.name} 字母頭像`}>
          <span aria-hidden="true">{about.profile.avatar_initial}</span>
        </figure>

        <div class="info-content">
          <h2 class="name">{about.profile.name}</h2>
          <p class="title">{about.profile.tagline}</p>
        </div>
      </div>

      <div class="sidebar-separator" aria-hidden="true"></div>

      <div class="sidebar-details">
        {about.profile.links.map((link) => (
          <a
            class="sidebar-link"
            href={link.url}
            target={link.url.startsWith('https://') ? '_blank' : undefined}
            rel={link.url.startsWith('https://') ? 'noopener noreferrer' : undefined}
            data-astro-prefetch={link.url.startsWith('/') ? 'viewport' : undefined}
          >
            <span class="sidebar-link-icon" aria-hidden="true">
              {link.icon === 'github' ? (
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"/><path d="M9 19v-2.5a3 3 0 0 1-1-1.5c-3 .2-3-1.5-4-2"/><path d="M15 19v-2.5a3 3 0 0 0 1.5-2.8c0-1-.2-1.6-.7-2.1.2-1.1.1-1.7-.2-2.4-1 0-1.5.3-2.2.8a9 9 0 0 0-3 0c-.7-.5-1.3-.8-2.2-.8-.3.7-.4 1.3-.2 2.4-.5.5-.7 1.1-.7 2.1a3 3 0 0 0 1.5 2.8"/>
                </svg>
              ) : link.icon === 'article' ? (
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22z"/><path d="M4 4.5V19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M9 8h7M9 12h5"/>
                </svg>
              ) : <span>↗</span>}
            </span>
            <span class="sidebar-link-text">
              <span class="sidebar-label">{link.label}</span>
              <span class="sidebar-value">{link.text}</span>
            </span>
            <span class="sidebar-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <div class="sidebar-separator sidebar-separator--bottom" aria-hidden="true"></div>
      <p class="sidebar-note">{about.profile.note}</p>
    </aside>

    <div class="vcard-main-content">
      <nav class="vcard-navbar" aria-label="關於頁區段">
        <a class="vcard-navbar-link is-active" href="#about-intro">{about.navigation.intro}</a>
        <a class="vcard-navbar-link" href="#about-interests">{about.navigation.interests}</a>
        <a class="vcard-navbar-link" href="#about-website">{about.navigation.website}</a>
      </nav>

      <section class="vcard-article" aria-labelledby="about-page-title">
        <header class="vcard-heading" id="about-intro">
          <div id="about-page-title">
            <InteriorHeading title={about.page_title} animated={true} />
          </div>
        </header>

        <div class="about-text">
          <AboutContent />
        </div>

        <section class="service" id="about-interests" aria-labelledby="interests-title">
          <h3 id="interests-title" class="section-title">{about.interests_title}</h3>
          <ul class="service-list">
            {about.interests.map((interest) => (
              <li class="service-item">
                <div class="service-icon-box" aria-hidden="true">
                  {interest.icon === 'code' ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m8 17-5-5 5-5m8 0 5 5-5 5m-2-16-4 20"/>
                    </svg>
                  ) : interest.icon === 'baseball' ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/><path d="M12 3c-2 4-2 14 0 18M3.5 9c4-2 13-2 17 0M3.5 15c4 2 13 2 17 0"/>
                    </svg>
                  ) : interest.icon === 'billiards' ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9.5" cy="13.5" r="6.5"/><path d="m14 9 7-7M16 12l5-5M6.5 12.5h.01"/>
                    </svg>
                  ) : interest.icon === 'anime' ? (
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="5" width="18" height="14" rx="3"/><path d="m8 2 4 3 4-3M8 11h.01M16 11h.01M8 15c2 2 6 2 8 0"/>
                    </svg>
                  ) : <span>✦</span>}
                </div>
                <div class="service-content-box">
                  <h4>{interest.title}</h4>
                  <p>{interest.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="site-note" id="about-website" aria-labelledby="website-title">
          <h3 id="website-title" class="section-title">{about.website.title}</h3>
          <p>{about.website.description}</p>
          {about.website.link_url && (
            <a
              class="text-link"
              href={about.website.link_url}
              data-astro-prefetch={about.website.link_url.startsWith('/') ? 'viewport' : undefined}
              target={about.website.link_url.startsWith('https://') ? '_blank' : undefined}
              rel={about.website.link_url.startsWith('https://') ? 'noopener noreferrer' : undefined}
            >{about.website.link_text} <span aria-hidden="true">↗</span></a>
          )}
        </section>
      </section>

      {about.timelines.map((timeline) => (
        <section class="timeline-panel" id={timeline.id} aria-labelledby={`${timeline.id}-title`}>
          <h3 class="timeline-title" id={`${timeline.id}-title`}>
            <span aria-hidden="true"></span>{timeline.title}
          </h3>
          <ol class="timeline-list">
            {timeline.items.map((item) => (
              <li class="timeline-row">
                <span class="timeline-when">{item.when}</span>
                <span class="timeline-event">{item.event}</span>
                {item.result && <span class="timeline-result">{item.result}</span>}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
</PageShell>

<style>
  /**
   * About layout adapted from codewithsadee/vcard-personal-portfolio (MIT).
   * Original copyright (c) 2022 codewithsadee.
   * License text: LICENSES/vcard-personal-portfolio.txt
   * All selectors are scoped to this page to avoid changing other site pages.
   */
  .vcard-page {
    --vcard-panel: transparent;
    --vcard-onyx: transparent;
    --vcard-jet: rgba(145, 175, 207, .3);
    --vcard-text: #fafafa;
    --vcard-muted: #d6d6d6;
    --vcard-accent: #a6c9e8;
    --vcard-border-gradient: transparent;
    --vcard-inset: transparent;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    width: min(100%, 1230px);
    margin: 0 auto;
    padding: clamp(116px, 14vh, 150px) clamp(16px, 3vw, 34px) 96px;
    display: grid;
    grid-template-columns: minmax(250px, 278px) minmax(0, 1fr);
    align-items: start;
    gap: 25px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--vcard-muted);
  }

  .vcard-page *,
  .vcard-page *::before,
  .vcard-page *::after { box-sizing: border-box; }

  .vcard-sidebar,
  .vcard-article {
    min-width: 0;
    border-radius: 20px;
    border: 1px solid var(--vcard-jet);
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .vcard-sidebar {
    position: sticky;
    top: 88px;
    padding: 38px 26px 24px;
  }

  .sidebar-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 17px;
  }

  .avatar-box {
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    margin: 0;
    border-radius: 20px;
    background: transparent;
    border: 1px solid rgba(145, 175, 207, .22);
    overflow: hidden;
  }

  .avatar-box span {
    display: grid;
    place-items: center;
    width: 103px;
    height: 103px;
    border-radius: 50%;
    background: transparent;
    color: #e7f1fa;
    font-size: 3.55rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -.055em;
  }

  .info-content { min-width: 0; text-align: center; }
  .info-content .name {
    margin: 0 0 12px;
    color: var(--vcard-text);
    font-size: 1.55rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -.025em;
  }

  .info-content .title {
    width: fit-content;
    margin: 0 auto;
    padding: 5px 13px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid rgba(145, 175, 207, .24);
    color: #e6e8eb;
    font-size: .78rem;
    font-weight: 400;
  }

  .sidebar-separator {
    width: 100%;
    height: 1px;
    margin: 28px 0;
    background: var(--vcard-jet);
  }
  .sidebar-separator--bottom { margin-bottom: 17px; }

  .sidebar-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: var(--vcard-text);
    text-decoration: none;
  }

  .sidebar-link-icon {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: var(--vcard-accent);
    background: transparent;
    border: 1px solid rgba(145, 175, 207, .28);
    box-shadow: none;
  }

  .sidebar-link-icon::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: transparent;
    z-index: 0;
  }
  .sidebar-link-icon svg { position: relative; z-index: 1; }
  .sidebar-link-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .sidebar-label { color: #b8b8bd; font-size: .69rem; font-weight: 500; letter-spacing: .065em; }
  .sidebar-value { color: #fafafa; font-size: .87rem; overflow-wrap: anywhere; }
  .sidebar-arrow { color: var(--vcard-accent); margin-left: auto; opacity: .6; }
  .sidebar-link:hover .sidebar-value,
  .sidebar-link:focus-visible .sidebar-value { color: var(--vcard-accent); }
  .sidebar-note { color: #a9abb2; margin: 0; text-align: center; font-size: .84rem; }

  .vcard-main-content { position: relative; min-width: 0; }
  .vcard-article {
    min-height: 520px;
    padding: 88px clamp(24px, 4vw, 38px) 38px;
  }

  .vcard-navbar {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: flex;
    gap: clamp(8px, 2vw, 22px);
    align-items: center;
    border: 1px solid var(--vcard-jet);
    border-radius: 0 20px;
    background: transparent;
    padding: 0 clamp(12px, 2.5vw, 25px);
  }
  .vcard-navbar-link {
    display: block;
    padding: 19px 8px;
    color: #d9d9dd;
    font-size: .91rem;
    text-decoration: none;
    transition: color .18s ease;
  }
  .vcard-navbar-link.is-active,
  .vcard-navbar-link:hover,
  .vcard-navbar-link:focus-visible { color: var(--vcard-accent); }

  .vcard-heading { scroll-margin-top: 100px; }
  .vcard-heading :global(.interior-heading) {
    position: relative;
    margin: 0 0 23px;
    padding-bottom: 19px;
    text-align: left;
  }
  .vcard-heading :global(.interior-heading::after) {
    content: '';
    position: absolute;
    width: 42px;
    height: 4px;
    left: 0;
    bottom: 0;
    border-radius: 4px;
    background: var(--vcard-accent);
  }
  .vcard-heading :global(.interior-heading h1),
  .vcard-heading :global(.interior-heading h1.typewriter) {
    color: var(--vcard-text);
    font-size: clamp(1.8rem, 3vw, 2rem);
    font-weight: 650;
    line-height: 1.4;
  }

  .about-text :global(p) {
    margin: 0 0 14px;
    color: var(--vcard-muted);
    font-size: .96rem;
    font-weight: 400;
    line-height: 1.85;
  }

  .service,
  .site-note { scroll-margin-top: 95px; }
  .service { margin-top: 32px; }
  .section-title {
    margin: 0 0 20px;
    color: #f6f6f6;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .service-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .service-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 17px;
    min-width: 0;
    padding: 24px 20px;
    border-radius: 14px;
    background: transparent;
    border: 1px solid rgba(145, 175, 207, .27);
    box-shadow: none;
    isolation: isolate;
  }
  .service-item::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: transparent;
    z-index: -1;
  }
  .service-icon-box { flex: 0 0 36px; color: var(--vcard-accent); margin-top: 2px; }
  .service-content-box { min-width: 0; }
  .service-content-box h4 {
    margin: 0 0 6px;
    color: #f5f5f5;
    font-size: 1.03rem;
    font-weight: 600;
  }
  .service-content-box p {
    margin: 0;
    color: #d5d5d6;
    font-size: .91rem;
    line-height: 1.75;
  }

  .site-note {
    margin-top: 35px;
  }
  .site-note p {
    margin: 0 0 10px;
    color: var(--vcard-muted);
    font-size: .96rem;
    line-height: 1.9;
  }
  .text-link {
    display: inline-block;
    padding: 4px 0;
    color: var(--vcard-accent);
    font-size: .91rem;
    text-underline-offset: 5px;
    text-decoration: underline;
    text-decoration-color: rgba(166,201,232,.4);
  }
  .text-link:hover,
  .text-link:focus-visible { text-decoration-color: var(--vcard-accent); }
  .text-link span { display: inline; }


  /* Timeline rows follow the supplied 郭10 timeline reference, while keeping
     the user's transparent night-sky vCard panels and existing typography. */
  .timeline-panel {
    margin-top: 22px;
    padding: clamp(24px, 3.2vw, 34px);
    border: 1px solid var(--vcard-jet);
    border-radius: 20px;
    background: transparent;
    box-shadow: none;
    color: var(--vcard-text);
    scroll-margin-top: 92px;
  }
  .timeline-title {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 20px;
    color: #f5f5f5;
    font-size: 1.03rem;
    font-weight: 650;
    line-height: 1.5;
  }
  .timeline-title > span {
    flex: 0 0 3px;
    width: 3px;
    height: 16px;
    border-radius: 3px;
    background: var(--vcard-accent);
  }
  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline-row {
    display: grid;
    grid-template-columns: minmax(75px, 108px) minmax(0, 1fr) minmax(70px, auto);
    gap: 16px;
    align-items: start;
    position: relative;
    min-width: 0;
    padding: 11px 0 11px 20px;
    font-size: .89rem;
    line-height: 1.6;
  }
  .timeline-row::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(145, 175, 207, .25);
  }
  .timeline-row::after {
    content: '';
    position: absolute;
    left: 0;
    top: 20px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #91afcf;
  }
  .timeline-when { color: #aabbd0; font-size: .82rem; }
  .timeline-event { color: #e8eaed; min-width: 0; overflow-wrap: anywhere; }
  .timeline-result {
    color: #b4d6f4;
    text-align: right;
    white-space: nowrap;
    font-weight: 600;
    font-size: .84rem;
  }
  @media (max-width: 620px) {
    .timeline-panel {
      margin-top: 14px;
      padding: 22px 18px;
      border-radius: 17px;
    }
    .timeline-row {
      grid-template-columns: minmax(61px, 78px) minmax(0, 1fr);
      gap: 5px 11px;
      padding-left: 17px;
    }
    .timeline-result {
      grid-column: 2;
      text-align: left;
    }
  }

  @media (max-width: 980px) {
    .vcard-page {
      max-width: 780px;
      grid-template-columns: minmax(0,1fr);
      gap: 18px;
      padding-top: 108px;
    }
    .vcard-sidebar {
      position: static;
      padding: 22px 26px;
    }
    .sidebar-info { flex-direction: row; gap: 20px; justify-content: flex-start; }
    .avatar-box { width: 92px; height: 92px; flex: 0 0 92px; }
    .avatar-box span { width: 74px; height: 74px; font-size: 2.7rem; }
    .info-content { text-align: left; }
    .info-content .title { margin: 0; }
    .sidebar-separator { margin: 18px 0; }
    .sidebar-separator--bottom { display: none; }
    .sidebar-details { flex-direction: row; flex-wrap: wrap; gap: 16px 26px; }
    .sidebar-note { display: none; }
  }

  @media (max-width: 620px) {
    .vcard-page { padding: 98px 14px 66px; gap: 14px; }
    .vcard-sidebar { padding: 18px; border-radius: 17px; }
    .avatar-box { flex-basis: 68px; width: 68px; height: 68px; border-radius: 14px; }
    .avatar-box span { width: 52px; height: 52px; font-size: 2rem; }
    .info-content .name { font-size: 1.3rem; margin-bottom: 7px; }
    .info-content .title { font-size: .72rem; padding: 4px 8px; }
    .sidebar-details { gap: 16px; }
    .sidebar-link-icon { width: 36px; height: 36px; }
    .sidebar-link { width: 100%; }
    .vcard-navbar {
      position: static;
      justify-content: center;
      border-radius: 15px 15px 0 0;
      width: 100%;
      padding: 0 7px;
    }
    .vcard-navbar-link { padding: 13px 10px; font-size: .86rem; }
    .vcard-article {
      padding: 25px 20px 30px;
      border-radius: 0 0 17px 17px;
      border-top: 0;
      min-height: 0;
    }
    .service-list { grid-template-columns: minmax(0, 1fr); gap: 13px; }
    .service-item { padding: 19px 16px; }
    .section-title { font-size: 1.17rem; }
    .vcard-heading :global(.interior-heading) { margin-bottom: 19px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vcard-navbar-link { transition: none; }
  }
</style>
