---
export const prerender = import.meta.env.PUBLIC_EASON_LIVE !== 'true';
import TagArchive from '../../../components/TagArchive.astro';
import { getWorks, getWorkTagStats } from '../../../lib/content/works';

export async function getStaticPaths() {
  const allPosts = await getWorks();
  const sortedTags = await getWorkTagStats();
  return sortedTags.map(([tag]) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts.filter(post => post.data.tags.includes(tag)),
      sortedTags,
      totalCount: allPosts.length,
    },
  }));
}

const live = import.meta.env.PUBLIC_EASON_LIVE === 'true';
const currentTag = Astro.params.tag ?? '';
const allPosts = live ? await getWorks() : [];
const statRows = live ? await getWorkTagStats() : [];
const { tag, posts, sortedTags, totalCount } = live
  ? { tag: currentTag, posts: allPosts.filter(post => post.data.tags.includes(currentTag)), sortedTags: statRows, totalCount: allPosts.length }
  : Astro.props;
if (live && !statRows.some(([name]) => name === currentTag)) return Astro.rewrite('/404');
---

<TagArchive {tag} {posts} {sortedTags} {totalCount} kind="works" />
