---
import TagArchive from '../../../components/TagArchive.astro';
import { getWorks, getWorkTagStats } from '../../../lib/content/works';

export async function getStaticPaths() {
  const allPosts = await getWorks();
  const sortedTags = await getWorkTagStats();
  return sortedTags.map(([tag]) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts.filter(post => post.data.tags.includes(tag)),
      sortedTags,
      totalCount: allPosts.length,
    },
  }));
}

const live = import.meta.env.PUBLIC_EASON_LIVE === 'true';
const liveTag = Astro.params.tag ?? '';
const livePosts = live ? await getWorks() : [];
const liveTags = live ? await getWorkTagStats() : [];
const pageData = live
  ? {
      tag: liveTag,
      posts: livePosts.filter((entry) => entry.data.tags.includes(liveTag)),
      sortedTags: liveTags,
      totalCount: livePosts.length,
    }
  : Astro.props;
const { tag, posts, sortedTags, totalCount } = pageData;
if (live && !liveTags.some(([name]) => name === liveTag)) Astro.response.status = 404;
---

<TagArchive {tag} {posts} {sortedTags} {totalCount} kind="works" />
