---
export const prerender = import.meta.env.PUBLIC_EASON_LIVE !== 'true';
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getWorks } from '../../lib/content/works';
import { extractSeoDescription } from '../../lib/content/text';
import { getCmsDocument } from '../../lib/cloudflare/live-content';
import { renderCmsMarkdown } from '../../lib/cloudflare/render-markdown';

export async function getStaticPaths() {
	const posts = await getWorks();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'works'>;

const live = import.meta.env.PUBLIC_EASON_LIVE === 'true';
const post = live
  ? await getCmsDocument('work', Astro.params.slug ?? '')
  : (Astro.props as CollectionEntry<'works'>);
if (!post) return Astro.rewrite('/404');
const rendered = live ? await renderCmsMarkdown(post.body ?? '') : undefined;
const staticRender = live ? undefined : await render(post as CollectionEntry<'works'>);
const Content = staticRender?.Content;
const headings = rendered?.headings ?? staticRender?.headings ?? [];
const seoDescription =
	(post.data.description?.trim() || extractSeoDescription(post.body ?? '') || post.data.title).trim();
const body = post.body ?? '';
const hasMath = /\$\$[\s\S]*?\$\$|\\\([\s\S]*?\\\)|\\\[[\s\S]*?\\\]|\$[^$\n]+\$|\\begin\{[a-zA-Z*]+\}/.test(
	body,
);

// 计算字数和阅读时间
const wordCount = body ? body.replace(/[#*`~>\[\]\(\)\-\!\s]/g, '').length : 0;
const readingTime = Math.ceil(wordCount / 400);
---

<BlogPost
	{...post.data}
	backHref="/experience/"
	backLabel="所有作品"
	workMode={true}
	headings={headings}
	wordCount={wordCount}
	readingTime={readingTime}
	seoDescription={seoDescription}
	loadKatexStyles={hasMath}
>
	{live ? <Fragment set:html={rendered?.html ?? ''} /> : Content ? <Content /> : null}
</BlogPost>

