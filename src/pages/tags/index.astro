---
import DraftBadge from '../../components/DraftBadge.astro';
import PostMeta from '../../components/PostMeta.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import PageShell from '../../layouts/PageShell.astro';
import { heroConfig, siteTitle } from '../../config';
import { getTagStats, getBlogPosts } from '../../lib/content/blog';
import { getTagPath } from '../../lib/content/tag-path';
import { extractExcerpt } from '../../lib/content/text';

const sortedTags = await getTagStats();
const posts = await getBlogPosts();
const tagsHero = heroConfig.tags;
---
<PageShell
  title={`標籤 | ${siteTitle}`}
  description={'依標籤尋找文章'}
  transparentHeader={true}
  pageId="tags-index"
  useMainWrapper={false}
>

  <style>
    .tag-area {
      position: relative;
      z-index: 2;
      background: linear-gradient(to bottom, transparent 88px, #171c25 88px);
      padding: 0 1.5rem 4.5rem;
      min-height: 45vh;
    }
    .tag-panel {
      max-width: 960px;
      margin: 0 auto;
      box-sizing: border-box;
      background: #222936;
      border: 1px solid rgba(155,177,214,.19);
      border-radius: 18px;
      padding: 2rem clamp(1.2rem, 3vw, 2.5rem);
      color: #edf1f8;
    }
    .tag-top { margin: 0 0 1.35rem; }
    .tag-heading { font-size: 1.6rem; font-weight: 700; margin: 0; color:#f2f5fa; }
    .tag-count-summary { color:#adbbd0; font-size:.93rem; margin:.35rem 0 0; }
    .tags-cloud {
      display:flex;
      flex-wrap:wrap;
      align-items:center;
      gap:.55rem;
      padding: 0 0 1.5rem;
      border-bottom:1px solid rgba(159,179,212,.2);
      margin-bottom:1.25rem;
    }
    .tag-pill {
      display:inline-flex;
      align-items:center;
      gap:.35rem;
      color:#bdcfe6;
      border:1px solid rgba(155,177,214,.18);
      background:rgba(145,175,207,.08);
      padding:.36rem .7rem;
      border-radius:9px;
      text-decoration:none;
      font-size:.87rem;
      line-height:1.5;
      transition:background .2s,color .2s,transform .2s;
    }
    .tag-pill:hover { background:rgba(145,175,207,.16); color:#fff; transform:translateY(-2px); }
    .tag-pill.active-tag { background:rgba(145,175,207,.2); border-color:rgba(145,175,207,.5); color:#e3efff; }
    .tag-hash { color:#9bbdec; }
    .tag-badge { font-size:.78rem; color:#9eb0c9; }
    .tag-posts-list { display:flex; flex-direction:column; }
    .post-card-wrapper { border-bottom:1px solid rgba(159,179,212,.18); }
    .post-card-wrapper:last-child { border-bottom:0; }
    .tag-post-item { position:relative; padding:1.2em .5rem; border-radius:8px; cursor:pointer; transition:background .2s,box-shadow .2s; }
    .tag-post-item:hover { background:rgba(145,175,207,.08); box-shadow:inset 0 0 0 1px rgba(157,186,234,.16); }
    .tag-post-title { font-size:1.2em; font-weight:600; line-height:1.45; margin:0 0 .5em; }
    .tag-post-title a {
      color:#f0f4fa;
      text-decoration:none;
      display:inline;
      background-image:linear-gradient(#a8caff,#a8caff);
      background-position:0% 100%;
      background-repeat:no-repeat;
      background-size:0% 2px;
      transition:background-size .3s cubic-bezier(.25,.46,.45,.94),color .3s ease;
      padding-bottom:2px;
    }
    .tag-post-title a:hover, .tag-post-item:hover .tag-post-title a { color:#a8caff; background-size:100% 2px; }
    /* Stretch only the article-title link across the card. The tag links sit above it. */
    .tag-post-title a::after { content:''; position:absolute; inset:0; z-index:1; }
    .tag-post-title a:focus-visible { outline:2px solid #a8caff; outline-offset:4px; }
    .tag-panel :global(.post-item-tags) { position:relative; z-index:2; }
    .tag-panel :global(.post-item-tag-badge) { display:inline-flex; text-decoration:none; }
    .tag-panel :global(.post-item-tag-badge:hover) { color:#fff; background:rgba(145,175,207,.26); }
    .tag-post-excerpt { color:#bdc9da; font-size:.94rem; line-height:1.75; margin:0 0 .9rem; }
    .tag-panel :global(.tag-post-meta) { display:flex; flex-wrap:wrap; align-items:center; gap:1em; color:#9baec7; font-size:.85em; }
    .tag-panel :global(.tag-meta-item) { display:flex; align-items:center; gap:.3em; }
    .tag-panel :global(.tag-meta-item svg) { width:14px; height:14px; flex-shrink:0; }
    .tag-panel :global(.post-item-tags) { display:flex; flex-wrap:wrap; gap:.4em; }
    .tag-panel :global(.post-item-tag-badge) {
      display:inline-flex;
      align-items:center;
      gap:.2em;
      color:#b4cdee;
      background:rgba(145,175,207,.12);
      border-radius:4px;
      padding:2px 8px;
      font-size:.85em;
      text-decoration:none;
      transition:background-color .3s cubic-bezier(.2,0,0,1),color .3s cubic-bezier(.2,0,0,1),transform .3s cubic-bezier(.2,0,0,1),box-shadow .3s cubic-bezier(.2,0,0,1);
      transform-origin:center;
    }
    .tag-panel :global(.post-item-tag-badge:hover) { transform:translateY(-2px) scale(1.05); }
    .tag-panel :global(.post-item-tag-badge:active) { transform:translateY(0) scale(.97); }
    .tag-panel :global(.post-item-tag-badge svg) { width:12px; height:12px; }
    .pagination { display:flex; align-items:center; justify-content:center; gap:.55rem; padding:1.7rem 0 .2rem; border-top:1px solid rgba(159,179,212,.18); margin-top:1.5rem; }
    .pagination[hidden] { display:none !important; }
    .page-numbers { display:flex; gap:.4rem; align-items:center; }
    .page-btn { cursor:pointer; display:inline-flex; align-items:center; justify-content:center; min-width:36px; height:36px; padding:0 .55rem; border-radius:8px; background:transparent; color:#bfcfe3; border:1px solid rgba(155,177,214,.2); font:inherit; font-size:.9rem; text-decoration:none; }
    .page-btn:hover:not(:disabled) { background:rgba(145,175,207,.16); color:#fff; }
    .page-btn.active { background:#6688b4; color:white; border-color:transparent; }
    .page-btn:disabled,.page-btn.disabled { opacity:.35; cursor:default; }
    .page-ellipsis { color:#a1aec2; }
    .empty-state { color:#bdc9da; text-align:center; padding:1.5rem; }
    .tag-hidden-input { display:none !important; }
    @media (max-width:720px) {
      .tag-area { background:linear-gradient(to bottom,transparent 56px,#171c25 56px); padding:0 .8rem 3rem; }
      .tag-panel { padding:1.3rem 1rem; }
      .tag-heading { font-size:1.4rem; }
      .tag-post-title { font-size:1.2em; }
      .tag-post-item { padding:1.15rem .25rem; }
    }
  </style>
  <HeroHeader text={"標籤"} backgroundImage={tagsHero.backgroundImage} compact={true} stableOnNavigation={true} />
  <section class="tag-area" aria-label="標籤總覽" transition:animate="none">
    <div class="tag-panel">
      <header class="tag-top">
        <h2 class="tag-heading">文章標籤</h2>
        <p class="tag-count-summary">共 {posts.length} 篇文章</p>
      </header>
      <nav class="tags-cloud" aria-label="文章標籤">
  <a href="/tags/" class:list={['tag-pill',{ 'active-tag': true }]} data-tag="all">
    全部文章 <span class="tag-badge">{posts.length}</span>
  </a>
  {sortedTags.map(([t, count]) => (
    <a href={getTagPath(t)} class:list={['tag-pill', {'active-tag': false}]} data-tag={t} data-count={count}>
      <span class="tag-hash">#</span><span class="tag-name">{t}</span>
      <span class="tag-badge">{count}</span>
    </a>
  ))}
</nav>
      <input id="tag-search" class="tag-hidden-input" type="search" aria-label="標籤內搜尋" tabindex="-1" />
      <div id="active-tag-title" hidden>所有文章</div>
      <div id="active-posts-count" hidden></div>
      <div class="tag-posts-list" id="posts-list">
            {posts.map((post) => {
              const excerpt = extractExcerpt(post.body || '', 160);
              return (
                <div 
                  class="post-card-wrapper" 
                  data-post-id={post.id}
                  data-tags={post.data.tags.join(',')}
                >
                  <article class="tag-post-item">
                    <h4 class="tag-post-title">
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                      <DraftBadge draft={post.data.draft} />
                    </h4>
                    {excerpt && <p class="tag-post-excerpt">{excerpt}</p>}
                    
                      <PostMeta
                      date={post.data.pubDate}
                      categories={post.data.categories}
                      tags={post.data.tags}
                      containerClass="tag-post-meta"
                      itemClass="tag-meta-item"
                      tagsClass="post-item-tags"
                      tagLinkClass="post-item-tag-badge"
                    />
                  </article>
                </div>
              );
            })}
          </div>
                <nav id="tag-pagination" class="pagination" aria-label="文章分页" hidden>
            <button id="tag-prev-page" type="button" class="page-btn prev-btn" aria-label="上一页">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
            </button>
            <div id="tag-page-numbers" class="page-numbers"></div>
            <button id="tag-next-page" type="button" class="page-btn next-btn" aria-label="下一页">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
            </button>
          </nav>
    </div>
  </section>
</PageShell>
