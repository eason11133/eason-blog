{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eason-blog-web-live",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "../../dist-cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
