{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eason-blog",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eason-blog-content",
      "database_id": "0bee7890-ba82-44f3-8d09-c9becdd7d250",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "bbf7e743e848427aa9c9c3d12210c3a0"
    }
  ],
  "keep_vars": true
}
